---
import Button from '../global/Button.astro';
import NatureIcon from '../global/NatureIcon.astro';

interface Props { day: string; ages: string; dates: string; time: string; href: string; accent: 'moss' | 'blue' | 'earth'; icon: 'leaf' | 'mountain' | 'acorn'; }
const { day, ages, dates, time, href, accent, icon } = Astro.props;
---
<article class:list={['option-card', `accent-${accent}`]}>
  <div class="option-heading"><span class="icon"><NatureIcon name={icon} size={36} /></span><div><h2>{day}<br />Base Camp</h2><p class="type-label">{ages}</p></div></div>
  <dl><div><dt><NatureIcon name="calendar" size={21} /><span class="sr-only">Dates</span></dt><dd>{dates}</dd></div><div><dt><NatureIcon name="clock" size={21} /><span class="sr-only">Time</span></dt><dd>{time}</dd></div></dl>
  <div class="option-location"><dt><NatureIcon name="map-pin" size={21} /><span class="sr-only">Location</span></dt><dd><strong>Lenoir Preserve</strong> · 19 Dudley Street, Yonkers</dd></div>
  <Button registration={{ program: `Fall 2026 Base Camp — ${day}`, paymentUrl: href }}>Register <span aria-hidden="true">→</span></Button>
</article>
<style>
  .option-card { --accent: var(--color-moss); display:flex; flex-direction:column; padding:clamp(1.5rem,3vw,2.25rem); border:1px solid rgb(49 88 67 / .13); border-radius:1.75rem; background:rgb(255 253 247 / .96); box-shadow:0 18px 45px rgb(31 42 36 / .1); transition:transform var(--transition),box-shadow var(--transition); }
  .option-card:hover { transform:translateY(-5px); box-shadow:0 24px 55px rgb(31 42 36 / .16); }
  .accent-blue { --accent:#4f7480; } .accent-earth { --accent:#b26d32; }
  .option-heading { display:flex; align-items:center; gap:1rem; padding-bottom:1.4rem; border-bottom:1px solid var(--color-line); }
  .icon { display:grid; width:4.75rem; aspect-ratio:1; place-items:center; flex:none; border-radius:50%; background:var(--accent); color:white; }
  h2 { margin:0; color:var(--accent); font-family:var(--font-sans); font-size:clamp(1.25rem,2.3vw,1.55rem); font-weight:800; line-height:1.15; text-transform:uppercase; }
  .type-label { margin:.45rem 0 0; color:var(--color-ink); }
  dl { display:grid; gap:1rem; margin:1.5rem 0; }
  dl div { display:grid; grid-template-columns:1.75rem 1fr; gap:.65rem; align-items:start; }
  dt { color:var(--accent); } dd { margin:0; line-height:1.5; }
  .option-location { display:grid; grid-template-columns:1.75rem 1fr; gap:.65rem; margin:0 0 1.5rem; color:var(--color-ink-muted); font-size:1.1875rem; line-height:1.4; }
  .option-location dt { color:var(--accent); }
  .option-location dd { margin:0; }
  :global(.button) { width:100%; margin-top:auto; border-color:var(--accent); background:var(--accent); gap:1.25rem; }
  @media (max-width:35.999rem) { .icon { width:4rem; } }
</style>
