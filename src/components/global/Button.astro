---
interface Props { href?: string | null; variant?: 'primary' | 'secondary'; label?: string; }
const { href, variant = 'primary', label } = Astro.props;
---
{href ? <a class:list={['button', variant]} href={href}><slot>{label}</slot></a> : <span class:list={['button', variant, 'disabled']} aria-disabled="true"><slot>{label}</slot></span>}
<style>
  .button { display: inline-flex; min-height: var(--button-height); align-items: center; justify-content: center; padding: .65rem 1.4rem; border: 2px solid var(--color-forest-dark); border-radius: var(--radius-button); font-size: 1.1875rem; font-weight: 750; line-height: 1.1; text-align: center; text-decoration: none; transition: background-color var(--transition), color var(--transition), transform var(--transition); }
  .button:hover { transform: translateY(-1px); }
  .primary { background: var(--color-forest-dark); color: var(--color-surface); }
  .primary:hover { background: var(--color-rust); border-color: var(--color-rust); color: white; }
  .secondary { background: transparent; color: var(--color-forest-dark); }
  .secondary:hover { background: var(--color-cream); color: var(--color-forest-dark); }
  .disabled { cursor: not-allowed; opacity: .62; }
  .disabled:hover { transform: none; }
</style>
