---
const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY;
---

<div class="scholarship-modal" data-scholarship-modal data-recaptcha-site-key={recaptchaSiteKey} hidden>
  <div class="scholarship-modal__backdrop" data-scholarship-close></div>
  <section class="scholarship-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="scholarship-title">
    <button class="scholarship-modal__close" type="button" aria-label="Close scholarship form" data-scholarship-close>×</button>
    <p class="scholarship-modal__eyebrow">Scholarship details</p>
    <h2 id="scholarship-title">Let’s make room for you.</h2>
    <p class="scholarship-modal__program">Applying for <strong data-scholarship-program-label></strong></p>
    <p>We want nature and community to be within reach. Share a few details below, and our team will be in touch about scholarship support.</p>
    <form data-scholarship-form>
      <label>First name <input name="firstName" autocomplete="given-name" required /></label>
      <label>Last name <input name="lastName" autocomplete="family-name" required /></label>
      <label class="scholarship-modal__email">Email address <input name="email" type="email" autocomplete="email" required /></label>
      <label>Participant’s name <input name="participantName" autocomplete="name" required /></label>
      <label>Participant’s age <input name="participantAge" inputmode="numeric" pattern="[0-9]{1,3}" required /></label>
      <div class="scholarship-modal__honeypot" aria-hidden="true"><label>Leave this field empty <input name="website" tabindex="-1" autocomplete="off" /></label></div>
      <button type="submit">Submit scholarship application <span aria-hidden="true">→</span></button>
    </form>
    <div data-scholarship-success hidden tabindex="-1" role="status"><h3>Thank you for reaching out.</h3><p>We’ve received your scholarship application. Our team will review your request and be in touch. We’re grateful for the opportunity to help you connect with the Wayfinders community.</p></div>
    <p data-scholarship-preview hidden>Preview only — submitting here will not send emails or save an application.</p>
    <p class="scholarship-modal__error" data-scholarship-error role="alert" hidden></p>
    <p class="scholarship-modal__privacy">We’ll use these details to review your application and contact you. Applying does not guarantee a scholarship or reserve a place.</p>
  </section>
</div>

<script>
  type Recaptcha = { ready: (callback: () => void) => void; execute: (siteKey: string, options: { action: string }) => Promise<string>; };
  const modal = document.querySelector<HTMLElement>('[data-scholarship-modal]');
  if (modal) {
    const siteKey = modal.dataset.recaptchaSiteKey;
    const dialog = modal.querySelector('.scholarship-modal__dialog');
    const programLabel = modal.querySelector<HTMLElement>('[data-scholarship-program-label]');
    const form = modal.querySelector<HTMLFormElement>('[data-scholarship-form]');
    const errorPanel = modal.querySelector<HTMLElement>('[data-scholarship-error]');
    const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
    let trigger: HTMLElement | null = null;
    const preview = ["localhost", "127.0.0.1"].includes(window.location.hostname);
    let recaptchaLoader: Promise<Recaptcha> | null = null;

    const setError = (message = '') => {
      if (!errorPanel) return;
      errorPanel.textContent = message;
      errorPanel.toggleAttribute('hidden', !message);
    };
    const loadRecaptcha = () => {
      if (!siteKey) return Promise.reject(new Error('Scholarship is temporarily unavailable.'));
      if (recaptchaLoader) return recaptchaLoader;
      recaptchaLoader = new Promise((resolve, reject) => {
        const existing = document.querySelector<HTMLScriptElement>('script[data-wayfinders-recaptcha]');
        const script = existing ?? document.createElement('script');
        const complete = () => {
          const recaptcha = (window as Window & { grecaptcha?: Recaptcha }).grecaptcha;
          if (recaptcha) resolve(recaptcha);
          else reject(new Error('We could not load spam protection.'));
        };
        if (existing && (window as Window & { grecaptcha?: Recaptcha }).grecaptcha) {
          complete();
          return;
        }
        script.addEventListener('load', complete, { once: true });
        script.addEventListener('error', () => reject(new Error('We could not load spam protection.')), { once: true });
        if (!existing) {
          script.src = `https://www.google.com/recaptcha/api.js?render=${encodeURIComponent(siteKey)}`;
          script.async = true;
          script.defer = true;
          script.dataset.wayfindersRecaptcha = 'true';
          document.head.append(script);
        }
      });
      return recaptchaLoader;
    };
    const getRecaptchaToken = async () => {
      const recaptcha = await loadRecaptcha();
      await new Promise<void>((resolve) => recaptcha.ready(resolve));
      return recaptcha.execute(siteKey!, { action: 'program_scholarship' });
    };
    if (preview) modal.querySelector('[data-scholarship-preview]')?.removeAttribute('hidden');
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab' || modal.hidden) return;
      const items = Array.from(modal.querySelectorAll<HTMLElement>('button,input,[tabindex="0"]')).filter(el => el.getClientRects().length && !(el as HTMLButtonElement).disabled);
      const first=items[0], last=items[items.length-1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
    });
    const close = () => {
      modal.setAttribute('hidden', '');
      document.body.classList.remove('scholarship-modal-open');
      form?.reset();
      setError();
      trigger?.focus();
    };
    const open = (event: Event) => {
      trigger = event.currentTarget as HTMLElement;
      form?.removeAttribute("hidden");
      modal.querySelector("[data-scholarship-success]")?.setAttribute("hidden", "");
      const program = trigger.dataset.scholarshipProgram || 'this Wayfinders program';
      if (programLabel) programLabel.textContent = program;
      modal.removeAttribute('hidden');
      document.body.classList.add('scholarship-modal-open');
      (dialog?.querySelector('input[name="firstName"]') as HTMLInputElement | null)?.focus();
    };

    document.querySelectorAll('[data-scholarship-open]').forEach((element) => element.addEventListener('click', open));
    modal.querySelectorAll('[data-scholarship-close]').forEach((element) => element.addEventListener('click', close));
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && !modal.hasAttribute('hidden')) close(); });
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      setError();
      if (submitButton) submitButton.disabled = true;
      const fields = new FormData(form);
      try {
        if (preview) {
          form.setAttribute('hidden', '');
          const success = modal.querySelector<HTMLElement>('[data-scholarship-success]');
          if (success) { success.hidden = false; success.focus(); }
          return;
        }
        const recaptchaToken = await getRecaptchaToken();
        const response = await fetch('/api/scholarship', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            program: programLabel?.textContent,
            firstName: fields.get('firstName'),
            lastName: fields.get('lastName'),
            email: fields.get('email'),
            participantName: fields.get('participantName'),
            participantAge: fields.get('participantAge'),
            website: fields.get('website'),
            recaptchaToken,
          }),
        });
        const result = response.headers.get('content-type')?.includes('application/json')
          ? await response.json().catch(() => null) as { ok?: boolean; error?: string } | null
          : null;
        if (!response.ok || !result?.ok) throw new Error(result?.error || 'We could not save your details. Please try again.');
        form.setAttribute('hidden', '');
        const success = modal.querySelector<HTMLElement>('[data-scholarship-success]');
        if (success) { success.hidden = false; success.focus(); }
      } catch (error) {
        setError(error instanceof Error ? error.message : 'We could not save your details. Please try again.');
      } finally {
        if (submitButton) submitButton.disabled = false;
      }
    });
  }
</script>

<style>
  .scholarship-modal{position:fixed;z-index:201;inset:0;display:flex;align-items:flex-start;justify-content:center;overflow-y:auto;overscroll-behavior:contain;padding:1rem;-webkit-overflow-scrolling:touch}.scholarship-modal__backdrop{position:fixed;inset:0;background:rgb(8 25 15 / .72);backdrop-filter:blur(3px)}.scholarship-modal__dialog{position:relative;flex:0 0 auto;width:min(100%,42rem);margin:auto 0;padding:clamp(2rem,5vw,4rem);border:1px solid rgb(255 255 255 / .45);border-radius:var(--radius-card);background:var(--color-surface);box-shadow:0 24px 70px rgb(0 0 0 / .3);color:var(--color-ink)}.scholarship-modal__close{position:absolute;top:1rem;right:1rem;display:grid;width:2.75rem;aspect-ratio:1;place-items:center;padding:0;border:0;border-radius:50%;background:transparent;color:var(--color-forest-dark);font-size:2rem;line-height:1;cursor:pointer}.scholarship-modal__eyebrow{margin:0;color:var(--color-rust);font-size:1rem;font-weight:750;letter-spacing:.13em;text-transform:uppercase}.scholarship-modal h2{margin:.35rem 0 1rem;color:var(--color-forest-dark);font-family:var(--font-display);font-size:calc(clamp(2.6rem,6vw,4rem) + var(--font-display-size-adjust));font-weight:600;line-height:.95}.scholarship-modal__program{margin:0 0 .5rem;color:var(--color-moss)}.scholarship-modal form{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:2rem}.scholarship-modal label{display:grid;gap:.4rem;color:var(--color-forest-dark);font-size:.95rem;font-weight:750}.scholarship-modal input{width:100%;min-height:3rem;padding:.65rem .8rem;border:1px solid var(--color-line);border-radius:.65rem;background:#fff;color:var(--color-ink);font:inherit}.scholarship-modal__email,.scholarship-modal form button,.scholarship-modal__consent{grid-column:1/-1}.scholarship-modal__consent{display:flex!important;align-items:flex-start;gap:.65rem;font-weight:600!important;line-height:1.4}.scholarship-modal__consent input{width:1.25rem;min-height:1.25rem;margin:.1rem 0 0;accent-color:var(--color-forest-dark)}.scholarship-modal form button{min-height:3.25rem;padding:.7rem 1.4rem;border:0;border-radius:var(--radius-button);background:var(--color-forest-dark);color:white;font:inherit;font-weight:750;cursor:pointer}.scholarship-modal form button:hover{background:var(--color-rust)}.scholarship-modal form button:disabled{cursor:wait;opacity:.7}.scholarship-modal__honeypot{position:absolute;left:-5000px}.scholarship-modal__privacy{margin:1rem 0 0;color:var(--color-ink-muted);font-size:.875rem}.scholarship-modal__error{margin:1rem 0 0;color:#9a3118;font-weight:700}:global(body.scholarship-modal-open){overflow:hidden}@media(max-width:47.999rem){.scholarship-modal form{grid-template-columns:1fr}.scholarship-modal__dialog{margin:0;padding:2rem}.scholarship-modal__close{top:.5rem;right:.5rem}}
</style>
