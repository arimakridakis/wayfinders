---
import { site } from '../../data/site';
import Container from './Container.astro';
---
<header class="site-header">
  <Container width="wide" class="header-inner">
    <a class="brand" href="/" aria-label={`${site.name}, home`}>
      <span class="logo-mark" aria-hidden="true">W</span><span>{site.name}</span>
    </a>
    <nav class="desktop-nav" aria-label="Primary"><ul>{site.navigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul></nav>
    <details class="mobile-menu">
      <summary aria-label="Open navigation"><span aria-hidden="true">Menu</span></summary>
      <nav aria-label="Mobile primary"><ul>{site.navigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul></nav>
    </details>
  </Container>
</header>
<style>
  .site-header { position: relative; z-index: 10; border-bottom: 1px solid var(--color-line); background: color-mix(in srgb, var(--color-page) 94%, transparent); }
  :global(.header-inner) { display: flex; min-height: 5rem; align-items: center; justify-content: space-between; gap: 1.5rem; }
  .brand { display: inline-flex; min-height: var(--touch-target); align-items: center; gap: .75rem; max-width: 18rem; color: var(--color-forest-dark); font-family: var(--font-display); font-size: 1rem; font-weight: 700; line-height: 1.1; text-decoration: none; }
  .logo-mark { display: grid; width: 2.5rem; aspect-ratio: 1; place-items: center; flex: none; border: 1px dashed var(--color-moss); border-radius: 50%; font-family: var(--font-sans); font-size: .75rem; }
  ul { display: flex; align-items: center; gap: 1.5rem; margin: 0; padding: 0; list-style: none; }
  nav a { display: inline-flex; min-height: var(--touch-target); align-items: center; font-size: .875rem; font-weight: 700; text-decoration: none; }
  nav a:hover { text-decoration: underline; }
  .mobile-menu { display: none; position: relative; }
  summary { display: inline-flex; min-width: var(--touch-target); min-height: var(--touch-target); align-items: center; justify-content: center; cursor: pointer; font-size: .875rem; font-weight: 750; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  @media (max-width: 47.999rem) {
    .desktop-nav { display: none; }
    .mobile-menu { display: block; }
    .mobile-menu nav { position: absolute; top: calc(100% + .6rem); right: 0; width: min(18rem, calc(100vw - (2 * var(--gutter)))); padding: 1rem; border: 1px solid var(--color-line); border-radius: var(--radius-card); background: var(--color-surface); box-shadow: var(--shadow-soft); }
    .mobile-menu ul { align-items: stretch; flex-direction: column; gap: .25rem; }
    .mobile-menu a { width: 100%; padding-inline: .5rem; }
  }
</style>
