---
import { site } from '../../data/site';
import Container from './Container.astro';
---
<header class="site-header">
  <Container width="wide" class="header-inner">
    <a class="brand" href="/" aria-label={`${site.name}, home`}>
      <img src="/images/branding/wayfinders-logo.webp" width="601" height="601" alt="Wayfinders on the Hudson" />
    </a>
    <nav class="desktop-nav" aria-label="Primary">
      <ul>
        {site.navigation.map((item) => (
          <li>
            {'children' in item ? (
              <details class="nav-dropdown">
                <summary>{item.label}<span class="chevron" aria-hidden="true"></span></summary>
                <ul class="dropdown-menu">
                  {item.children.map((child) => <li><a href={child.href}>{child.label}</a></li>)}
                </ul>
              </details>
            ) : (
              <a href={item.href}>{item.label}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <details class="mobile-menu">
      <summary aria-label="Open navigation"><span aria-hidden="true">Menu</span></summary>
      <nav aria-label="Mobile primary">
        <ul>
          {site.navigation.map((item) => (
            <li>
              {'children' in item ? (
                <details class="mobile-submenu">
                  <summary>{item.label}<span class="chevron" aria-hidden="true"></span></summary>
                  <ul>
                    {item.children.map((child) => <li><a href={child.href}>{child.label}</a></li>)}
                  </ul>
                </details>
              ) : (
                <a href={item.href}>{item.label}</a>
              )}
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </Container>
</header>
<script>
  const desktopBreakpoint = window.matchMedia('(min-width: 64rem)');
  const desktopDropdowns = Array.from(document.querySelectorAll<HTMLDetailsElement>('.desktop-nav .nav-dropdown'));

  const closeOtherDropdowns = (activeDropdown: HTMLDetailsElement) => {
    desktopDropdowns.forEach((dropdown) => {
      if (dropdown !== activeDropdown) dropdown.removeAttribute('open');
    });
  };

  desktopDropdowns.forEach((dropdown) => {
    dropdown.addEventListener('pointerenter', () => {
      if (!desktopBreakpoint.matches) return;
      closeOtherDropdowns(dropdown);
      dropdown.setAttribute('open', '');
    });

    dropdown.addEventListener('pointerleave', () => {
      if (desktopBreakpoint.matches) dropdown.removeAttribute('open');
    });

    dropdown.addEventListener('focusin', () => {
      closeOtherDropdowns(dropdown);
      dropdown.setAttribute('open', '');
    });

    dropdown.addEventListener('focusout', () => {
      window.setTimeout(() => {
        if (!dropdown.contains(document.activeElement)) dropdown.removeAttribute('open');
      });
    });
  });
</script>
<style>
  .site-header { position: relative; z-index: 10; background: transparent; }
  :global(.header-inner) { display: grid; min-height: 8.5rem; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: 1.5rem; }
  .brand { display: inline-flex; min-height: var(--touch-target); align-items: center; grid-column: 1; justify-self: start; transform: translateY(10px); text-decoration: none; }
  .brand img { display: block; width: clamp(5.9375rem, 8.75vw, 7.8125rem); height: auto; }
  ul { margin: 0; padding: 0; list-style: none; }
  .desktop-nav { grid-column: 2; justify-self: center; }
  .desktop-nav > ul { display: flex; align-items: center; gap: clamp(1.25rem, 2.4vw, 2.5rem); }
  nav a, nav summary { display: inline-flex; min-height: var(--touch-target); align-items: center; padding-inline: .25rem; color: var(--color-ink); font-size: 1rem; font-weight: 700; text-decoration: none; }
  nav a:hover, nav summary:hover { text-decoration: underline; }
  summary { cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .nav-dropdown { position: relative; }
  .nav-dropdown > summary { gap: .4rem; }
  .chevron { width: .45rem; height: .45rem; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: translateY(-.1rem) rotate(45deg); transition: transform var(--transition); }
  details[open] > summary .chevron { transform: translateY(.1rem) rotate(225deg); }
  .dropdown-menu { position: absolute; top: calc(100% + .25rem); left: -.75rem; width: max-content; min-width: 14rem; max-width: min(24rem, calc(100vw - (2 * var(--gutter)))); padding: .6rem; border: 1px solid var(--color-line); border-radius: var(--radius-card); background: var(--color-surface); box-shadow: var(--shadow-soft); }
  .dropdown-menu a { width: 100%; min-height: 2.5rem; padding: .25rem .65rem; border-radius: .5rem; font-weight: 650; }
  .dropdown-menu a:hover { background: var(--color-surface-muted); text-decoration: none; }
  .mobile-menu { display: none; position: relative; grid-column: 3; justify-self: end; }
  .mobile-menu > summary { min-width: var(--touch-target); min-height: var(--touch-target); align-items: center; justify-content: center; font-size: .875rem; font-weight: 750; }
  @media (max-width: 63.999rem) {
    :global(.header-inner) { min-height: 6rem; }
    .brand img { width: 5.3125rem; }
    .desktop-nav { display: none; }
    .mobile-menu { display: block; }
    .mobile-menu > nav { position: absolute; top: calc(100% + .6rem); right: 0; width: min(22rem, calc(100vw - (2 * var(--gutter)))); max-height: calc(100vh - 7rem); overflow-y: auto; padding: 1rem; border: 1px solid var(--color-line); border-radius: var(--radius-card); background: var(--color-surface); box-shadow: var(--shadow-soft); }
    .mobile-menu nav > ul { display: flex; align-items: stretch; flex-direction: column; gap: .25rem; }
    .mobile-menu a, .mobile-submenu > summary { width: 100%; padding-inline: .5rem; }
    .mobile-submenu > summary { justify-content: space-between; }
    .mobile-submenu ul { margin: .1rem 0 .5rem .75rem; padding-left: .6rem; border-left: 1px solid var(--color-line); }
    .mobile-submenu li + li { margin-top: .1rem; }
    .mobile-submenu a { min-height: 2.5rem; font-weight: 600; }
  }
  :global(body:has(main > .hero) .site-header) { position: absolute; top: 0; right: 0; left: 0; }
  :global(body:has(main > .hero) .site-header) nav a,
  :global(body:has(main > .hero) .site-header) nav summary { color: white; text-shadow: 0 1px 12px rgb(0 0 0 / .45); }
  :global(body:has(main > .hero) .site-header) nav a:hover,
  :global(body:has(main > .hero) .site-header) nav summary:hover { color: white; }
  :global(body:has(main > .hero) .site-header .dropdown-menu),
  :global(body:has(main > .hero) .site-header .mobile-menu > nav) { border-color: rgb(255 255 255 / .3); background: rgb(13 35 23 / .94); }
  :global(body:has(main > .hero) .site-header .dropdown-menu a:hover) { background: rgb(255 255 255 / .14); }
</style>
