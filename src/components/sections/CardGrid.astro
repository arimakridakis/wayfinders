---
interface Props { columns?: 'auto' | 2 | 3 | 4; }
const { columns = 'auto' } = Astro.props;
---
<div class:list={['card-grid', `columns-${columns}`]}><slot /></div>
<style>
  .card-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); gap: clamp(1rem, 2vw, 1.5rem); }
  .columns-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .columns-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .columns-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  @media (max-width: 63.999rem) { .columns-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 47.999rem) { .columns-2, .columns-3, .columns-4 { grid-template-columns: 1fr; } }
</style>
