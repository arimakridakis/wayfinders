---
interface Props { layout?: 'equal' | 'featured'; }
const { layout = 'equal' } = Astro.props;
---
<div class:list={['image-gallery', `layout-${layout}`]}><slot /></div>
<style>
  .image-gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .image-gallery :global(img), .image-gallery :global(.image-placeholder) { width: 100%; min-height: 14rem; object-fit: cover; }
  .image-gallery :global(img) { height: auto; aspect-ratio: 4 / 3; }
  .image-gallery :global(.image-placeholder) { height: 100%; }
  .layout-featured :global(> :first-child) { height: 100%; aspect-ratio: auto; grid-row: span 2; }
  @media (max-width: 47.999rem) { .image-gallery { grid-template-columns: 1fr 1fr; } .layout-featured :global(> :first-child) { grid-column: span 2; grid-row: auto; } }
  @media (max-width: 35.999rem) { .image-gallery { grid-template-columns: 1fr; } .layout-featured :global(> :first-child) { grid-column: auto; } }
</style>
