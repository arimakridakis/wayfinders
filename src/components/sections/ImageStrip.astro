---
interface ImageItem {
  src: string;
  alt: string;
}

interface Props {
  images: ImageItem[];
  label?: string;
}

const { images, label } = Astro.props;
---

<section class:list={['image-strip', `count-${images.length}`]} aria-label={label}>
  {images.map((image, index) => (
    <figure class:list={{ featured: index === 0 }}>
      <img src={image.src} alt={image.alt} loading="lazy" decoding="async" />
    </figure>
  ))}
</section>

<style>
  .image-strip { display:grid; grid-template-columns:1.25fr .875fr .875fr; gap:1rem; margin-top:clamp(2.5rem,5vw,4rem); }
  .count-1 { grid-template-columns:minmax(0, 34rem); justify-content:center; }
  .count-2 { grid-template-columns:repeat(2,minmax(0,1fr)); }
  figure { min-height:15rem; margin:0; overflow:hidden; border-radius:var(--radius-card); }
  figure.featured { min-height:21rem; }
  img { width:100%; height:100%; object-fit:cover; }
  @media (max-width:47.999rem) { .image-strip { grid-template-columns:1fr; } figure,figure.featured { min-height:18rem; } }
</style>
