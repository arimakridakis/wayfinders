---
import Container from '../global/Container.astro';

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  /** Retained so each page can receive a unique hero image in a future update. */
  image?: string;
  alt?: string;
  overlayOpacity?: number;
}

const { eyebrow, title, intro, image, overlayOpacity } = Astro.props;
---

<section class="page-hero" style={image || overlayOpacity !== undefined ? `${image ? `--hero-image: url("${image}");` : ''}${overlayOpacity !== undefined ? `--hero-overlay-max: ${overlayOpacity}; --hero-overlay-mobile: ${overlayOpacity};` : ''}` : undefined}>
  <Container width="wide" class="hero-inner">
    <div class="copy">
      {eyebrow && <p class="type-label">{eyebrow}</p>}
      <h1 class="type-page-title">{title}</h1>
      {intro && <p class="intro">{intro}</p>}
      <slot />
    </div>
  </Container>
</section>

<style>
  .page-hero {
    display: grid;
    min-height: calc(clamp(30rem, 67vh, 46rem) + 50px);
    align-items: center;
    padding-block: clamp(4.5rem, 10vw, 8rem);
    background:
      linear-gradient(90deg, rgb(8 28 18 / var(--hero-overlay-max, .86)) 0%, rgb(8 28 18 / calc(var(--hero-overlay-max, .86) * .8)) 48%, rgb(8 28 18 / calc(var(--hero-overlay-max, .86) * .35)) 100%),
      var(--hero-image, url('/images/heroes/GreenForest1.webp')) center / cover no-repeat;
    color: var(--color-surface);
  }

  .copy { max-width: 48rem; transform: translateY(50px); }
  h1 { margin: .65rem 0 0; color: var(--color-surface); font-size: calc(clamp(2.5rem, 6vw, 5rem) + var(--font-display-size-adjust) + var(--font-display-hero-size-adjust)); }
  .type-label { margin: 0; color: var(--color-cream); }
  .intro { max-width: 42rem; margin: 1.5rem 0 0; color: var(--color-surface); font-size: clamp(1.08rem, 2vw, 1.3rem); }
  .copy :global(h2), .copy :global(p), .copy :global(strong) { color: var(--color-surface); }

  :global(.page-hero .button) { border-color: var(--color-surface); }
  :global(.page-hero .button.primary) { background: var(--color-surface); color: var(--color-forest-dark); }
  :global(.page-hero .button.primary:hover) { border-color: var(--color-rust); background: var(--color-rust); color: white; }
  :global(.page-hero .button.secondary) { background: rgb(23 59 42 / .45); color: var(--color-surface); }
  :global(.page-hero .button.secondary:hover) { background: var(--color-cream); color: var(--color-forest-dark); }

  @media (max-width: 47.999rem) {
    .page-hero {
      min-height: calc(30rem + 50px);
      background:
        linear-gradient(rgb(8 28 18 / var(--hero-overlay-mobile, .76)), rgb(8 28 18 / var(--hero-overlay-mobile, .76))),
        var(--hero-image, url('/images/heroes/GreenForest1.webp')) center / cover no-repeat;
    }
  }
</style>
