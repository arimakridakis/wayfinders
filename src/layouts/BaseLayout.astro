---
import '../styles/global.css';
import SiteFooter from '../components/global/SiteFooter.astro';
import SiteHeader from '../components/global/SiteHeader.astro';
import NewsletterModal from '../components/global/NewsletterModal.astro';
import RegistrationModal from '../components/global/RegistrationModal.astro';
import { site } from '../data/site';
interface Props { title: string; description?: string; canonical?: URL | string; image?: string; }
const { title, description = site.description, canonical, image } = Astro.props;
const pageTitle = title === site.name ? title : `${title} | ${site.name}`;
const canonicalUrl = canonical ? String(canonical) : Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {image && <meta property="og:image" content={image} />}
    <!-- Placeholder favicon; replace only after brand approval. -->
    <link rel="icon" type="image/svg+xml" href="/icons/favicon-placeholder.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader />
    <main id="main-content" tabindex="-1"><slot /></main>
    <SiteFooter />
    <NewsletterModal />
    <RegistrationModal />
  </body>
</html>
<style>
  .skip-link { position: fixed; top: .75rem; left: .75rem; z-index: 100; padding: .75rem 1rem; transform: translateY(-180%); border-radius: .5rem; background: var(--color-forest-dark); color: white; font-weight: 750; }
  .skip-link:focus { transform: translateY(0); }
  :global(.section-heading h2) { display:flex; align-items:center; justify-content:center; gap:clamp(.45rem,1vw,.8rem); }
  :global(.section-heading h2) { gap:30px; }
  :global(.section-heading h2::before), :global(.section-heading h2::after) { transform:none; }
  :global(.section-heading h2::before), :global(.section-heading h2::after) { width:clamp(3.5rem,1.35em,9rem); height:1.2em; flex:none; background:center / contain no-repeat; content:''; }
  :global(.section-heading h2::before) { background-image:url('/images/decorative/leaf-left-small.png'); }
  :global(.section-heading h2::after) { background-image:url('/images/decorative/leaf-right-small.png'); }

  :global(#main-content > .hero:not(.home-hero)) {
    min-height: calc(min(48rem, 82vh) + 50px) !important;
  }

  :global(#main-content > .hero:not(.home-hero) .hero-content) {
    transform: translateY(50px);
  }

  @media (max-width: 47.999rem) {
    :global(.section-heading h2) { flex-wrap:wrap; }
    :global(#main-content > .hero:not(.home-hero)) {
      min-height: calc(42rem + 50px) !important;
    }

    :global(#main-content > .hero.hero--tall-mobile) {
      min-height: calc(44rem + 50px) !important;
    }
  }
</style>
