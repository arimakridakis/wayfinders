---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/sections/PageHero.astro'; import Section from '../components/global/Section.astro'; import Button from '../components/global/Button.astro';
const registerUrl='https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-3ef6531ada3d487b898212099c1dcf992a1795b6d4c24ce9acec1b23f8c3f88478a340b7890448bbb12595742a93316e?locale=EN_US&cta=copylistmultilink';
---
<BaseLayout title="Autumn 2026 Women’s Retreat" description="Gather around the fire at Lenoir Preserve for reflection, intention, rest, and connection."><PageHero eyebrow="Friday, September 18" title="Autumn 2026 Women’s Retreat" intro="Gather around the fire with other women as we downshift into quieter times." image="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/2747a8bf-7a1a-4a91-8295-fc9faf882066/IMG_3736.jpg?format=1200w" alt="Women gathering outdoors at a Wayfinders retreat"><Button href={registerUrl}>Reserve your spot</Button></PageHero>
<Section width="wide"><div class="facts"><article><p class="type-label">Date & time</p><h2 class="type-card">Friday, September 18</h2><p>1:30–5:30 pm</p></article><article><p class="type-label">Location</p><h2 class="type-card">Lenoir Preserve</h2><p>Yonkers, New York</p></article><article><p class="type-label">Cost</p><h2 class="type-card">$120</h2><p>Scholarships and payment plans are available.</p></article></div></Section>
<Section tone="alternate" width="wide"><div class="intro"><h2 class="type-section">Take a break.</h2><p>As the days darken this fall, we are here to hold this moment together. We will reflect on summer to keep the thread alive and set intentions as we enter autumn. Spots are intentionally limited.</p></div><div class="columns"><article><h2 class="type-card">Retreat tracks</h2><ul><li>Family of Origin</li><li>Ancient Goddess Cultures: What Our Grandmothers Knew About Culture Creation</li><li>Introduction to Vision Quest</li></ul></article><article><h2 class="type-card">What’s included</h2><ul><li>Fire circle and facilitation</li><li>Local, seasonal snacks and tea</li><li>Guided wellness treatments and meditations</li><li>Supplies for all activities</li><li>Ample time for rest and reflection</li></ul></article><article><h2 class="type-card">Possibilities</h2><ul><li>Sistering and ceremony</li><li>Relational rigor and rest</li><li>Engagement with the land</li><li>Forest yoga</li></ul></article></div></Section>
<Section width="wide"><p class="type-label">How it works</p><div class="steps"><article><span>1</span><h2 class="type-card">Reserve your spot</h2><p>Sign up to reserve your place.</p></article><article><span>2</span><h2 class="type-card">Review the welcome email</h2><p>We’ll send everything you need to know.</p></article><article><span>3</span><h2 class="type-card">Start dreaming</h2><p>Get excited for an adventure in restoration.</p></article></div><Button href={registerUrl}>Register for the retreat</Button></Section></BaseLayout>
<style>:global(.page-hero .button){margin-top:2rem}.facts,.columns,.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.facts article,.columns article,.steps article{padding:var(--card-padding);border:1px solid var(--color-line);border-radius:var(--radius-card);background:var(--color-surface)}.facts h2,.facts .type-label,.columns h2,.steps h2{margin:0}.facts p,.columns li,.steps p,.intro p{color:var(--color-ink-muted)}.intro{max-width:var(--width-prose);margin-bottom:2rem}.steps{margin:1rem 0 2rem}.steps span{display:grid;width:2.5rem;aspect-ratio:1;place-items:center;margin-bottom:1rem;border-radius:50%;background:var(--color-cream);font-weight:800}@media(max-width:47.999rem){.facts,.columns,.steps{grid-template-columns:1fr}}</style>
