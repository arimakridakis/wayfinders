---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/sections/PageHero.astro'; import Section from '../components/global/Section.astro'; import Button from '../components/global/Button.astro';
const qualities=['We are working on building a village and cultural repair','We explore earth connection & survival skills','Relationships & gratitude are central to our approach','Youth can experience rites of passage with our program'];
const roles=[{title:'Mentor Positions!',copy:'We are looking for Mentors to support our Nature Connection Programs (Base Camp) for 2nd-8th graders.',apply:'https://forms.gle/Ukcuf1nzXkvHFnca7'},{title:'Mentors-in-Training Internship!',copy:'We are looking for Mentors-in-Training to participate in our Nature-Guided Youth Mentor Program (Base Camp) for 2nd-8th graders.',apply:'https://forms.gle/Ukcuf1nzXkvHFnca7'}];
---
<BaseLayout title="Careers" description="Mentor and mentor-in-training opportunities with Wayfinders."><PageHero eyebrow="Work with us" title="Careers" intro="Join a fun, eco-centric, innovative, and collaborative team." image="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/56490829-d045-495a-83e5-2ecbaffe99d9/unsplash-image-uKVs2ovR0KY.jpg?format=1200w" alt="A group walking together through a forest" />
<Section width="wide"><div class="roles">{roles.map(role=><article><h2 class="type-card">{role.title}</h2><p>{role.copy} Learn more about Wayfinders on our <a href="/">home page</a>.</p><p>Please apply using the external application and email your resume or CV to <a href="mailto:wayfindersonthehudson@gmail.com">wayfindersonthehudson@gmail.com</a>.</p><Button href={role.apply}>Apply with Google Forms</Button></article>)}</div><p class="alternate-action">The public careers page also provides a <a href="https://forms.gle/5uQMaSNT6KH8369W8">second external application form</a>.</p></Section>
<Section tone="alternate" width="prose"><h2 class="type-section">About the Program</h2><p>Wayfinders on the Hudson provides nature-based, social-emotional learning opportunities for children and youth. The programs focus on nature connection, community building, social action, and coming of age. Our program is open to all youth ages 2nd-12th grade.</p><p>At Wayfinders on the Hudson, we integrate nature-based, collaborative, interdisciplinary project-based learning (PBL) and thoughtful self-reflection with high quality mentoring. Our mission is to support youth in their evolution as they grow from a child into a teenager by instilling nature connection, interdependence, confidence, leadership skills, and self-awareness, ultimately resulting in designing and building a life in which they thrive, and have the skills to engage in repairing the world.</p><h2 class="type-section">Our Team</h2><p>The most important part of any job is who you’re working with. Wayfinders on the Hudson is a startup program. Our team is FUN, eco-centric, integral, innovative and collaborative. We take risks and sometimes they flop, but we find ourselves constantly learning, and improving upon who we are and what we deliver, and our passion for bringing this program to life takes us into the unknowns with joy.</p></Section>
<Section width="wide"><h2 class="type-section">What Sets Wayfinders on the Hudson Apart?</h2><ul class="qualities">{qualities.map(item=><li>{item}</li>)}</ul></Section></BaseLayout>
<style>.roles,.qualities{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}.roles article,.qualities li{padding:var(--card-padding);border:1px solid var(--color-line);border-radius:var(--radius-card);background:var(--color-surface)}.roles h2{margin-top:0}.alternate-action{margin:1.5rem 0 0;color:var(--color-ink-muted)}.qualities{padding:0;list-style:none}.qualities li{font-family:var(--font-display);font-size:1.25rem}@media(max-width:47.999rem){.roles,.qualities{grid-template-columns:1fr}.roles :global(.button){width:100%}}</style>
