---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/sections/PageHero.astro'; import Section from '../components/global/Section.astro'; import Button from '../components/global/Button.astro'; import CardGrid from '../components/sections/CardGrid.astro'; import InfoCard from '../components/sections/InfoCard.astro';
const qualities=['We are working on building a village and cultural repair','We explore earth connection & survival skills','Relationships & gratitude are central to our approach','Youth can experience rites of passage with our program'];
const roles=[{title:'Mentor Positions!',copy:'We are looking for Mentors to support our Nature Connection Programs (Base Camp) for 2nd-8th graders.',instruction:'Please apply here and email your resume or CV to:',apply:'https://forms.gle/Ukcuf1nzXkvHFnca7',label:'Apply here'},{title:'Mentors-in-Training Internship!',copy:'We are looking for Mentors-in-Training to participate in our Nature-Guided Youth Mentor Program (Base Camp) for 2nd-8th graders.',instruction:'Please apply here. If you’d like, you can also email your CV to:',apply:'https://forms.gle/5uQMaSNT6KH8369W8',label:'Apply'}];
---
<BaseLayout title="Careers" description="Mentor and mentor-in-training opportunities with Wayfinders."><PageHero eyebrow="Work with us" title="Careers" intro="Join a fun, eco-centric, innovative, and collaborative team." image="/images/banners/bronx-circle.jpg" alt="Wayfinders participants gathered outdoors" />
<Section width="wide"><CardGrid columns={2}>{roles.map(role=><InfoCard heading={role.title} headingLevel="h2"><p>{role.copy} <a href="/">Learn more about Wayfinders here!</a></p><p>{role.instruction} <a href="mailto:wayfindersonthehudson@gmail.com">wayfindersonthehudson@gmail.com</a>.</p><Button slot="action" href={role.apply}>{role.label}</Button></InfoCard>)}</CardGrid></Section>
<Section tone="alternate" width="prose"><h2 class="type-section">About the Program</h2><p>Wayfinders on the Hudson provides nature-based, social-emotional learning opportunities for children and youth. The programs focus on nature connection, community building, social action, and coming of age. Our program is open to all youth ages 2nd-12th grade.</p><p>At Wayfinders on the Hudson, we integrate nature-based, collaborative, interdisciplinary project-based learning (PBL) and thoughtful self-reflection with high quality mentoring. Our mission is to support youth in their evolution as they grow from a child into a teenager by instilling nature connection, interdependence, confidence, leadership skills, and self-awareness, ultimately resulting in designing and building a life in which they thrive, and have the skills to engage in repairing the world.</p><h2 class="type-section">Our Team</h2><p>The most important part of any job is who you’re working with. Wayfinders on the Hudson is a startup program. Our team is FUN, eco-centric, integral, innovative and collaborative. We take risks and sometimes they flop, but we find ourselves constantly learning, and improving upon who we are and what we deliver, and our passion for bringing this program to life takes us into the unknowns with joy.</p></Section>
<Section width="wide"><h2 class="type-section">What Sets Wayfinders on the Hudson Apart?</h2><CardGrid columns={4}>{qualities.map(item=><InfoCard heading={item} headingLevel="h3" />)}</CardGrid></Section></BaseLayout>
<style>
  .page-hero .intro { font-family: var(--font-hand); font-size: calc(clamp(1.15rem, 2vw, 1.45rem) + var(--font-hand-size-adjust) + 8px); line-height: 1.1; }
  :global(.info-card .type-card) { margin-bottom: 25px; }
  .type-section { margin-bottom: 25px; }
  .type-section + p + p + .type-section { margin-top: 40px; }
</style>
