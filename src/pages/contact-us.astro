---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/sections/PageHero.astro'; import Section from '../components/global/Section.astro'; import Button from '../components/global/Button.astro';
---
<BaseLayout title="Contact Us" description="Contact Wayfinders to learn more, get involved, or register for a program."><PageHero eyebrow="Connect with Wayfinders" title="Contact Us" intro="We would love to hear from you! Contact us to learn more about our mission and work, get involved, or register for a program." image="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/8d8c5ce2-addd-4888-a32d-44925828c3f7/trees.jpeg?format=1200w" alt="Looking up into a canopy of trees"><Button href="mailto:wayfindersonthehudson@gmail.com">Email Wayfinders</Button></PageHero>
<Section width="wide"><div class="contact-grid"><div><h2 class="type-section">Let’s start a conversation</h2><p>Let us know if you are looking to register for our new Programs: Forest Movement, Wise Owls, Motherhood Rising: Tending the Roots, FREE Forest Bathing or for more information on Corporate Retreats, School Programs, Internships, Base Camp, Passages, or just want to stay in touch!</p><p>Please let us know if you would like to to set up an Information Session.</p></div><address><p class="type-label">Email</p><a href="mailto:wayfindersonthehudson@gmail.com">wayfindersonthehudson@gmail.com</a><p class="type-label">Call</p><a href="tel:+19173183888">(917) 318-3888</a></address></div></Section>
<Section tone="alternate" width="prose"><div class="newsletter"><p class="type-label">Join our mailing list</p><h2 class="type-section">Receive news and updates</h2><p>The current mailing-list submission destination has not yet been confirmed for the new site. In the meantime, email us and ask to join the list.</p><Button href="mailto:wayfindersonthehudson@gmail.com?subject=Join%20the%20Wayfinders%20mailing%20list">Ask to join by email</Button><p class="privacy">We respect your privacy.</p></div></Section></BaseLayout>
<style>:global(.page-hero .button){margin-top:2rem}.contact-grid{display:grid;grid-template-columns:1.4fr .8fr;gap:var(--column-gap)}.contact-grid h2{margin-top:0}address{padding:var(--card-padding);border-radius:var(--radius-card);background:var(--color-surface);font-style:normal}address .type-label{margin:0;color:var(--color-rust)}address .type-label~.type-label{margin-top:1.5rem}address a{overflow-wrap:anywhere}.newsletter{text-align:center}.newsletter h2{margin:.5rem 0}.privacy{font-size:.875rem;color:var(--color-ink-muted)}@media(max-width:47.999rem){.contact-grid{grid-template-columns:1fr}:global(.page-hero .button){width:100%}}</style>
