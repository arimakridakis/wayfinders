---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Section from '../components/global/Section.astro';
import Button from '../components/global/Button.astro';
import KeyDetails from '../components/sections/KeyDetails.astro';
import MediaSplit from '../components/sections/MediaSplit.astro';

const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY;
---
<BaseLayout title="Contact" description="Get in touch with Wayfinders on the Hudson.">
  <PageHero eyebrow="Connect with Wayfinders" title="Contact Us" intro="We would love to hear from you—whether you are curious about a program, our work, or getting involved." image="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/8d8c5ce2-addd-4888-a32d-44925828c3f7/trees.jpeg?format=1200w" alt="Looking up into a canopy of trees" />

  <Section width="wide">
    <MediaSplit align="start">
      <Fragment slot="copy">
        <p class="type-label contact-eyebrow">Start a conversation</p>
        <h2 class="type-section">We’d love to hear from you.</h2>
        <p>Have a question about a program, an information session, or ways to get involved? Send us a note and we’ll be in touch.</p>
        <p>We welcome questions about Base Camp, Forest Tots, Wise Owls, Motherhood Rising, retreats, school programs, internships, and more.</p>
        <KeyDetails heading="Contact details"><dt>Email</dt><dd><a href="mailto:wayfindersonthehudson@gmail.com">wayfindersonthehudson@gmail.com</a></dd><dt>Call</dt><dd><a href="tel:+19173183888">(917) 318-3888</a></dd></KeyDetails>
      </Fragment>
      <form slot="media" class="contact-form" data-contact-form data-recaptcha-site-key={recaptchaSiteKey}>
        <p class="type-label contact-eyebrow">Send a message</p>
        <h2 class="type-card">How can we help?</h2>
        <div class="name-fields">
          <label>First name <input name="firstName" autocomplete="given-name" required /></label>
          <label>Last name <input name="lastName" autocomplete="family-name" required /></label>
        </div>
        <label>Email address <input name="email" type="email" autocomplete="email" required /></label>
        <label>Message <textarea name="message" rows="6" required></textarea></label>
        <div class="contact-form__honeypot" aria-hidden="true"><label>Leave this field empty <input name="website" tabindex="-1" autocomplete="off" /></label></div>
        <button class="contact-form__submit" type="submit">Send message <span aria-hidden="true">→</span></button>
        <p class="contact-form__error" data-contact-error role="alert" hidden></p>
        <p class="contact-form__success" data-contact-success role="status" hidden>Thank you—your message is on its way. We’ll be in touch soon.</p>
      </form>
    </MediaSplit>
  </Section>

  <Section tone="alternate" width="wide">
    <div class="mailing-list">
      <p class="type-label contact-eyebrow">Stay connected</p>
      <h2 class="type-section">Join our Mailing List</h2>
      <p>Sign up for news, new programs, and invitations to spend more time together outdoors.</p>
      <Button newsletter>Sign up <span aria-hidden="true">→</span></Button>
      <p class="privacy">We respect your privacy. You can unsubscribe anytime.</p>
    </div>
  </Section>
</BaseLayout>

<script>
  type Recaptcha = { ready: (callback: () => void) => void; execute: (siteKey: string, options: { action: string }) => Promise<string>; };
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const siteKey = form.dataset.recaptchaSiteKey;
    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const errorPanel = form.querySelector<HTMLElement>('[data-contact-error]');
    const successPanel = form.querySelector<HTMLElement>('[data-contact-success]');
    let recaptchaLoader: Promise<Recaptcha> | null = null;
    const setError = (message = '') => {
      if (!errorPanel) return;
      errorPanel.textContent = message;
      errorPanel.toggleAttribute('hidden', !message);
    };
    const loadRecaptcha = () => {
      if (!siteKey) return Promise.reject(new Error('The contact form is temporarily unavailable.'));
      if (recaptchaLoader) return recaptchaLoader;
      recaptchaLoader = new Promise((resolve, reject) => {
        const existing = document.querySelector<HTMLScriptElement>('script[data-wayfinders-recaptcha]');
        const script = existing ?? document.createElement('script');
        const complete = () => {
          const recaptcha = (window as Window & { grecaptcha?: Recaptcha }).grecaptcha;
          if (recaptcha) resolve(recaptcha);
          else reject(new Error('We could not load spam protection.'));
        };
        if (existing && (window as Window & { grecaptcha?: Recaptcha }).grecaptcha) { complete(); return; }
        script.addEventListener('load', complete, { once: true });
        script.addEventListener('error', () => reject(new Error('We could not load spam protection.')), { once: true });
        if (!existing) {
          script.src = `https://www.google.com/recaptcha/api.js?render=${encodeURIComponent(siteKey)}`;
          script.async = true;
          script.defer = true;
          script.dataset.wayfindersRecaptcha = 'true';
          document.head.append(script);
        }
      });
      return recaptchaLoader;
    };
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      setError();
      successPanel?.setAttribute('hidden', '');
      if (submitButton) submitButton.disabled = true;
      try {
        const recaptcha = await loadRecaptcha();
        await new Promise<void>((resolve) => recaptcha.ready(resolve));
        const fields = new FormData(form);
        const response = await fetch('/api/contact', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ firstName: fields.get('firstName'), lastName: fields.get('lastName'), email: fields.get('email'), message: fields.get('message'), website: fields.get('website'), recaptchaToken: await recaptcha.execute(siteKey!, { action: 'contact_inquiry' }) }),
        });
        const result = await response.json() as { ok?: boolean; error?: string };
        if (!response.ok || !result.ok) throw new Error(result.error || 'We could not send your message. Please try again.');
        form.reset();
        successPanel?.removeAttribute('hidden');
      } catch (error) {
        setError(error instanceof Error ? error.message : 'We could not send your message. Please try again.');
      } finally {
        if (submitButton) submitButton.disabled = false;
      }
    });
  }
</script>

<style>
  .contact-eyebrow{margin:0 0:.65rem;color:var(--color-rust)}.contact-form{display:grid;gap:1.25rem;padding:clamp(1.5rem,4vw,2.75rem);border:1px solid var(--color-line);border-radius:var(--radius-card);background:var(--color-surface);box-shadow:var(--shadow-soft)}.contact-form h2{margin:-.5rem 0 .25rem}.contact-form label{display:grid;gap:.45rem;color:var(--color-forest-dark);font-size:1.1875rem;font-weight:750}.contact-form input,.contact-form textarea{width:100%;padding:.8rem 1rem;border:1px solid var(--color-line);border-radius:.8rem;background:var(--color-page);color:var(--color-ink);font:inherit}.contact-form textarea{resize:vertical}.name-fields{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.contact-form__submit{justify-self:start;min-height:var(--button-height);padding:.65rem 1.4rem;border:2px solid var(--color-forest-dark);border-radius:var(--radius-button);background:var(--color-forest-dark);color:#fff;font:inherit;font-size:1.1875rem;font-weight:750;cursor:pointer}.contact-form__submit:hover{background:var(--color-rust);border-color:var(--color-rust)}.contact-form__submit:disabled{cursor:wait;opacity:.7}.contact-form__honeypot{position:absolute;left:-5000px}.contact-form__error{margin:0;color:#9a3118;font-weight:750}.contact-form__success{margin:0;color:var(--color-success);font-weight:750}.mailing-list{max-width:55rem;margin-inline:auto;text-align:center}.mailing-list h2{margin:.25rem 0 1rem}.mailing-list p:not(.privacy){max-width:43rem;margin-inline:auto}.mailing-list :global(.button){margin-top:1rem}.privacy{margin:1rem 0 0;color:var(--color-ink-muted);font-size:1.1875rem}@media(max-width:47.999rem){.name-fields{grid-template-columns:1fr}}
</style>
