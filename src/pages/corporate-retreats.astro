---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/sections/PageHero.astro'; import Section from '../components/global/Section.astro'; import Button from '../components/global/Button.astro';
const benefits=[['Tune in to your senses','When work happens at desks and through video calls, our innate skills at reading body language and being part of an interconnected community can atrophy. Wayfinders begins with tuning back in.'],['Tune into the seasons','Work ebbs and flows just like the seasons. When we align our rhythms with nature, we become more grounded, pace ourselves, connect with purpose, and discover that slowing down can make us more productive.'],['Meet your team in a new way','Being outside and playing with colleagues brings people together in ways that do not happen within four conference-room walls. New angles can support deeper engagement at work.']];
---
<BaseLayout title="Corporate Retreats" description="Nature connection, team building, and social-emotional learning for healthier workplaces."><PageHero eyebrow="Wayfinders for organizations" title="Corporate Retreats" intro="Get outside and become the best company you can be." image="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/ad398566-f667-4223-8bcf-262c0a6d3661/IMG_4469.jpg?format=1200w" alt="Colleagues participating in a Wayfinders corporate retreat"><Button href="mailto:wayfindersonthehudson@gmail.com?subject=Corporate%20Retreat">Learn more</Button></PageHero>
<Section width="wide"><div class="benefits">{benefits.map(([title,copy])=><article><h2 class="type-card">{title}</h2><p>{copy}</p></article>)}</div></Section>
<Section tone="alternate" width="wide"><div class="gallery"><img src="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/29f39634-d2e4-4e47-af7e-df4d460b0f65/_DSC9058.jpg?format=1200w" alt="A team collaborating outdoors" width="1200" height="800" loading="lazy" /><img src="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/9a0cac0e-a455-4be0-9e99-5d26ab5c6ddc/_DSC9116.jpg?format=1200w" alt="Corporate retreat participants connecting in nature" width="1200" height="800" loading="lazy" /></div><blockquote><p>“We are still feeling the good vibes from Monday! It really set the stage for a very productive two-day planning session. We got a lot done.”</p><cite>Jordan Zelniker, CIO, Econoco Corporation</cite></blockquote></Section>
<Section><div class="cta"><h2 class="type-section">Get to know your colleagues in a whole new light.</h2><Button href="mailto:wayfindersonthehudson@gmail.com?subject=Corporate%20Retreat">Start a conversation</Button></div></Section></BaseLayout>
<style>:global(.page-hero .button){margin-top:2rem}.benefits{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.benefits article{padding:var(--card-padding);border:1px solid var(--color-line);border-radius:var(--radius-card);background:var(--color-surface)}.benefits h2{margin:0}.benefits p{color:var(--color-ink-muted)}.gallery{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}.gallery img{width:100%;height:25rem;object-fit:cover;border-radius:var(--radius-card)}blockquote{max-width:var(--width-prose);margin:3rem auto 0;font-family:var(--font-display);font-size:clamp(1.35rem,2.5vw,2rem);line-height:1.4}cite{display:block;margin-top:1rem;font-family:var(--font-sans);font-size:.9rem;font-style:normal;color:var(--color-ink-muted)}.cta{display:flex;align-items:center;justify-content:space-between;gap:2rem}.cta h2{max-width:45rem;margin:0}@media(max-width:47.999rem){.benefits,.gallery{grid-template-columns:1fr}.gallery img{height:18rem}.cta{align-items:flex-start;flex-direction:column}.cta :global(.button){width:100%}}</style>
