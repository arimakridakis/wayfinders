---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/sections/PageHero.astro'; import Section from '../components/global/Section.astro'; import Button from '../components/global/Button.astro';
const benefits=[['Tune in to your senses','When you sit at a desk and only communicate via video conferences and calls, your innate skills at reading body language and being part of an interconnected community, can atrophy. Wayfinders begins with tuning back in.'],['Tune into the seasons','Work ebbs and flows just like the seasons change. When we syncopate our rhythms with nature, we harness the power to become more grounded, pace ourselves, connect with our purpose, and find out that sometimes slowing down can actually make us more productive.'],['Meet your team in a new way','Being outside and playing with your colleagues brings you together in ways that do not happen inside four walls of a conference room. Your true nature is revealed and you see each other through new angles that support your engagement at work.']];
const images = ['29f39634-d2e4-4e47-af7e-df4d460b0f65/_DSC9058.jpg','9a0cac0e-a455-4be0-9e99-5d26ab5c6ddc/_DSC9116.jpg','262c87c4-04b2-4b4c-9969-8c1dd9374d1c/_DSC9066.jpg','c6e2545c-bd7a-4a9e-abc6-faf5da0f74f0/IMG_4471.jpg','7efc01f4-59ce-4f70-898f-f323158c4e2f/Screenshot+2023-12-13+at+2.52.25%E2%80%AFPM.jpeg'];
---
<BaseLayout title="Corporate Retreats" description="Get outside and become the best company you can be."><PageHero eyebrow="Wayfinders for organizations" title="Corporate Retreats" intro="Get outside and become the best company you can be" image="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/ad398566-f667-4223-8bcf-262c0a6d3661/IMG_4469.jpg?format=1200w" alt="Colleagues participating in an outdoor retreat"><Button href="/contact-us">Learn more</Button></PageHero>
<Section width="wide"><div class="benefits">{benefits.map(([title,copy])=><article><h2 class="type-card">{title}</h2><p>{copy}</p></article>)}</div></Section>
<Section tone="alternate" width="wide"><div class="gallery">{images.map((image) => <img src={`https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/${image}?format=1200w`} alt="" width="1200" height="800" loading="lazy" />)}</div><blockquote><p>“We are still feeling the good vibes from Monday! Even though it didn’t feel like a Monday! Hahaha.</p><p>Thank you again for putting together such an impactful experience for our team. It really set the stage for a very productive 2-day planning session. We got A LOT done!</p><p>Really appreciate all you did.”</p><cite>Quote from Jordan Zelniker, CIO, Econoco Corporation on Wayfinders Corporate Retreats</cite></blockquote></Section>
<Section><div class="cta"><h2 class="type-section">Get to know your colleagues in a whole new light!</h2><Button href="/contact-us">Learn more</Button></div></Section></BaseLayout>
<style>:global(.page-hero .button){margin-top:2rem}.benefits{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.benefits article{padding:var(--card-padding);border:1px solid var(--color-line);border-radius:var(--radius-card);background:var(--color-surface)}.benefits h2{margin:0}.benefits p{color:var(--color-ink-muted)}.gallery{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}.gallery img{width:100%;height:25rem;object-fit:cover;border-radius:var(--radius-card)}.gallery img:last-child{grid-column:1/-1}blockquote{max-width:var(--width-prose);margin:3rem auto 0;font-family:var(--font-display);font-size:clamp(1.35rem,2.5vw,2rem);line-height:1.4}cite{display:block;margin-top:1rem;font-family:var(--font-sans);font-size:.9rem;font-style:normal;color:var(--color-ink-muted)}.cta{display:flex;align-items:center;justify-content:space-between;gap:2rem}.cta h2{max-width:45rem;margin:0}@media(max-width:47.999rem){.benefits,.gallery{grid-template-columns:1fr}.gallery img,.gallery img:last-child{grid-column:auto;height:18rem}.cta{align-items:flex-start;flex-direction:column}.cta :global(.button){width:100%}}</style>
