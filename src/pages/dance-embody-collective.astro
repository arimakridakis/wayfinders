---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/sections/PageHero.astro'; import Section from '../components/global/Section.astro'; import Button from '../components/global/Button.astro';
---
<BaseLayout title="Dance Embody Collective" description="A monthly evening of connection, somatic exploration, listening, facilitation, and ecstatic dance in Irvington."><PageHero eyebrow="Connection and somatic exploration" title="Dance Embody Collective" intro="Dance as a sober meditation and freeform revelation." image="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/3273a57a-857c-4623-8875-7c5838ba7b57/IMG_1760.jpg?format=1200w" alt="People moving together during a Dance Embody gathering"><div class="actions"><Button href="https://register.capturepoint.com/reg/cat_program_list_detail.cfm?season_id=24610&program_id=2880221">Register</Button><Button href="http://danceembody.com" variant="secondary">More information</Button></div></PageHero>
<Section width="wide"><div class="facts"><article><p class="type-label">Dates</p><h2 class="type-card">Second Thursday</h2><p>September 10, October 8, November 12, December 10, and January 14</p></article><article><p class="type-label">Time & format</p><h2 class="type-card">7:00–9:00 pm</h2><p>7:00 listening circle<br />7:30 guest facilitation<br />8:00 ecstatic dance</p></article><article><p class="type-label">Location</p><h2 class="type-card">Irvington Recreation</h2><p>71 Main Street, Irvington</p></article></div><div class="fee"><p><strong>$100</strong> for residents and school-district participants<br /><strong>$120</strong> for non-residents</p><p>Registration opens June 22.</p></div></Section></BaseLayout>
<style>.actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:2rem}.facts{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.facts article{padding:var(--card-padding);border:1px solid var(--color-line);border-radius:var(--radius-card);background:var(--color-surface)}.facts h2,.facts .type-label{margin:0}.facts p{color:var(--color-ink-muted)}.fee{display:flex;justify-content:space-between;gap:2rem;margin-top:2rem;padding:var(--card-padding);border-radius:var(--radius-card);background:var(--color-cream)}@media(max-width:47.999rem){.facts{grid-template-columns:1fr}.actions :global(.button){width:100%}.fee{flex-direction:column;gap:0}}</style>
