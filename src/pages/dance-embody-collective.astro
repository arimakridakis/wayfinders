---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/sections/PageHero.astro'; import Section from '../components/global/Section.astro'; import Button from '../components/global/Button.astro'; import CardGrid from '../components/sections/CardGrid.astro'; import InfoCard from '../components/sections/InfoCard.astro'; import Callout from '../components/sections/Callout.astro';
---
<BaseLayout title="Motherhood Rising" description="Join us for connection and somatic exploration, where dance is a sober meditation and freeform revelation."><PageHero eyebrow="Source browser title: Motherhood Rising" title="Dance Embody Collective" intro="Join us for connection and somatic exploration, where dance is a sober meditation and freeform revelation." image="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/3273a57a-857c-4623-8875-7c5838ba7b57/IMG_1760.jpg?format=1200w" alt="People moving together indoors"><div class="actions"><Button href="https://register.capturepoint.com/reg/cat_program_list_detail.cfm?season_id=24610&program_id=2880221">Registration opens on June 22nd!</Button><Button href="http://danceembody.com" variant="secondary">danceembody.com</Button></div></PageHero>
<Section width="wide"><CardGrid columns={3}><InfoCard label="Dates & Times:" heading="Second Thursday of the month from September to January from 7-9 PM" headingLevel="h2"><ul><li>September 10th</li><li>October 8th</li><li>November 12th</li><li>December 10th</li><li>January 14th</li></ul></InfoCard><InfoCard label="Format:" heading="7:00 Opening Listening Circle" headingLevel="h2"><ul><li>7:30 Rotating Guest Facilitation</li><li>8:00 Ecstatic Dance</li></ul></InfoCard><InfoCard label="Location:" heading="Irvington Recreation Department (71 Main St. Irvington)" headingLevel="h2" /></CardGrid><div class="fee"><Callout><p><strong>Fee:</strong><br />$100 for Resident/School District, $120 for Non-Resident</p><p>More info: <a href="http://danceembody.com">danceembody.com</a><br />Register now at <a href="http://register.capturepoint.com/villageofirvington">register.capturepoint.com/villageofirvington</a></p></Callout></div></Section></BaseLayout>
<style>.actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:2rem}.fee{display:flex;justify-content:space-between;gap:2rem;margin-top:2rem;}@media(max-width:47.999rem){.actions :global(.button){width:100%}.fee{flex-direction:column;gap:0}}</style>
