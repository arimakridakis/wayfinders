---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/global/Container.astro';
import Button from '../components/global/Button.astro';
import NatureIcon from '../components/global/NatureIcon.astro';

const registration = 'https://register.capturepoint.com/reg/cat_program_list_detail.cfm?season_id=24610&program_id=2880221';
const details = [
  { icon: 'calendar', label: 'Dates & times', title: 'Second Thursday of the month', copy: 'September 10th · October 8th · November 12th · December 10th · January 14th · 7–9 PM' },
  { icon: 'heart', label: 'Format', title: 'Listen, move, and dance', copy: '7:00 Opening Listening Circle · 7:30 Rotating Guest Facilitation · 8:00 Ecstatic Dance' },
  { icon: 'mountain', label: 'Location', title: 'Irvington Recreation Department', copy: '71 Main St., Irvington' },
] as const;
---
<BaseLayout title="Dance Embody Collective" description="Join us for connection and somatic exploration, where dance is a sober meditation and freeform revelation.">
  <section class="hero">
    <Container width="wide" class="hero-content">
      <p class="type-label">Dance Embody</p>
      <h1>Dance <span>Collective</span></h1>
      <p class="hero-intro">Join us for connection and somatic exploration, where dance is a sober meditation and freeform revelation.</p>
      <div class="hero-actions"><Button href={registration}>Registration opens on June 22nd! <span aria-hidden="true">→</span></Button><Button href="http://danceembody.com" variant="secondary">danceembody.com</Button></div>
    </Container>
  </section>

  <section class="program chapter">
    <Container width="wide"><header class="section-heading"><p class="type-label">A monthly gathering</p><h2>Make space to move.</h2><p>A circle for listening, guest facilitation, and ecstatic dance.</p></header><div class="detail-grid">{details.map((detail) => <article><span class="icon"><NatureIcon name={detail.icon} size={38} /></span><p class="type-label">{detail.label}</p><h3>{detail.title}</h3><p>{detail.copy}</p></article>)}</div></Container>
  </section>

  <section class="rhythm chapter"><Container width="wide" class="rhythm-grid"><div class="rhythm-copy"><p class="type-label">The evening unfolds</p><h2>Begin by listening. End in movement.</h2><ol><li><span>7:00</span><div><h3>Opening Listening Circle</h3></div></li><li><span>7:30</span><div><h3>Rotating Guest Facilitation</h3></div></li><li><span>8:00</span><div><h3>Ecstatic Dance</h3></div></li></ol><p class="handwritten">A sober meditation and freeform revelation.</p></div><div class="rhythm-image"><img src="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/3273a57a-857c-4623-8875-7c5838ba7b57/IMG_1760.jpg?format=1200w" alt="People moving together indoors" width="1200" height="900" loading="lazy" /></div></Container></section>

  <section class="closing chapter"><Container width="wide" class="closing-grid"><div><p class="type-label">Join the collective</p><h2>Come as you are.</h2><p><strong>Fee:</strong><br />$100 for Resident/School District, $120 for Non-Resident</p></div><aside><p>More info: <a href="http://danceembody.com">danceembody.com</a><br />Register now at <a href="http://register.capturepoint.com/villageofirvington">register.capturepoint.com/villageofirvington</a></p><Button href={registration} variant="secondary">Register now <span aria-hidden="true">→</span></Button></aside></Container></section>
</BaseLayout>

<style>
  .chapter{padding-block:clamp(5rem,10vw,9rem)}.hero{position:relative;display:grid;min-height:min(48rem,82vh);align-items:center;isolation:isolate;background:url('https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/3273a57a-857c-4623-8875-7c5838ba7b57/IMG_1760.jpg?format=1600w') center / cover no-repeat;color:white}.hero::after{position:absolute;z-index:-1;inset:0;content:'';background:linear-gradient(90deg,rgb(18 29 23 / .9),rgb(18 29 23 / .64) 48%,rgb(18 29 23 / .2) 80%)}:global(.hero-content){padding-block:5rem}.hero .type-label,.closing .type-label{color:#e3dda3}h1{max-width:43rem;margin:.5rem 0 1rem;color:white;font-family:var(--font-display);font-size:calc(clamp(4rem,9vw,7.4rem) + var(--font-display-size-adjust));font-weight:500;letter-spacing:-.04em;line-height:.78}h1 span{display:block;margin:.18em 0 0 .1em;color:#d3c769;font-family:var(--font-hand);font-size:.72em;font-weight:500;letter-spacing:0;line-height:1}.hero-intro{max-width:37rem;font-size:clamp(1.15rem,2vw,1.45rem);line-height:1.55}.hero-actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:2rem}.hero-actions :global(.secondary){border-color:white;color:white}
  .program{background:linear-gradient(120deg,#fbf8f0,#f5f1e7)}.section-heading{max-width:50rem;margin:0 auto clamp(2.5rem,5vw,4rem);text-align:center}.section-heading .type-label,.rhythm .type-label{color:var(--color-moss)}.section-heading h2,.rhythm h2,.closing h2{margin:.3rem 0 .6rem;font-family:var(--font-display);font-size:calc(clamp(2.7rem,5vw,4.5rem) + var(--font-display-size-adjust));font-weight:600;letter-spacing:-.025em;line-height:1}.section-heading>p:last-child{margin:0;font-size:1.15rem}.detail-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(1rem,2vw,1.5rem)}.detail-grid article{padding:clamp(1.5rem,3vw,2.25rem);border:1px solid rgb(49 88 67 / .12);border-radius:var(--radius-card);background:rgb(255 253 247 / .78);box-shadow:var(--shadow-soft)}.icon{display:grid;width:4.8rem;aspect-ratio:1;place-items:center;border-radius:50%;background:var(--color-cream);color:var(--color-earth)}.detail-grid article:nth-child(2) .icon{background:#e3e8dc;color:var(--color-moss)}.detail-grid article:nth-child(3) .icon{background:#dce7e9;color:#406b7b}.detail-grid .type-label{margin:1.5rem 0 .45rem;color:var(--color-earth)}.detail-grid h3{margin:0;color:var(--color-forest-dark);font-family:var(--font-display);font-size:calc(clamp(1.65rem,3vw,2.25rem) + var(--font-display-size-adjust));line-height:1.05}.detail-grid p:last-child{line-height:1.65}
  .rhythm{background:#e8ebdf}.rhythm-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(3rem,7vw,7rem);align-items:center}.rhythm-copy{max-width:35rem}.rhythm-copy ol{margin:2rem 0;padding:0;list-style:none}.rhythm-copy li{display:grid;grid-template-columns:5rem 1fr;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--color-line)}.rhythm-copy li>span{color:var(--color-earth);font-family:var(--font-display);font-size:calc(1.45rem + var(--font-display-size-adjust))}.rhythm-copy h3{margin:0;font-family:var(--font-display);font-size:calc(1.5rem + var(--font-display-size-adjust))}.handwritten{color:var(--color-earth);font-family:var(--font-hand);font-size:clamp(1.6rem,3vw,2.2rem);line-height:1.1}.rhythm-image{overflow:hidden;min-height:32rem;border-radius:50% 50% 0 0}.rhythm-image img{width:100%;height:100%;object-fit:cover}
  .closing{background:linear-gradient(90deg,rgb(13 35 23 / .94),rgb(13 35 23 / .75)),url('/images/banners/fire-circle-9.jpg') center / cover;color:white}.closing-grid{display:grid;grid-template-columns:1.5fr .7fr;gap:clamp(3rem,7vw,6rem);align-items:center}.closing h2{color:white;font-size:calc(clamp(3.5rem,7vw,6rem) + var(--font-display-size-adjust))}.closing aside{padding-left:clamp(2rem,5vw,4rem);border-left:1px solid rgb(255 255 255 / .5)}.closing aside a{color:white}.closing aside :global(.button){margin-top:1rem;border-color:white;color:white}
  @media(max-width:63.999rem){.detail-grid{grid-template-columns:1fr}.rhythm-grid,.closing-grid{grid-template-columns:1fr}.rhythm-image{min-height:26rem}.closing aside{padding:2rem 0 0;border-top:1px solid rgb(255 255 255 / .5);border-left:0}}@media(max-width:47.999rem){.hero{min-height:42rem;background-position:62% center}.hero::after{background:rgb(18 29 23 / .72)}h1{font-size:calc(clamp(3.8rem,18vw,5.8rem) + var(--font-display-size-adjust))}.hero-actions{flex-direction:column}.hero-actions :global(.button){width:100%}}
</style>
