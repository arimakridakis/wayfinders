---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/sections/PageHero.astro'; import Section from '../components/global/Section.astro'; import Button from '../components/global/Button.astro';
const donations=[
['$50','4e8bc443ca754c2f8624226ca41b6bbddad4457951d047ae9d1f66f42efaf3d3b25ece104e394248b40a13f736a544a5'],['$100','b9e9a292b0484548afdfce0d7eca50d4579a3e2a457f43d1a3e836da5d6e7698d4f4b5a5aa7e4c059d73366463701c55'],['$250','bfa38a213eb548fab627b400f34351d6d13c36ec5c0049308b0884f5ec1eb205b104746c3f2c4fc1afbe04f2dd3643c0'],['$500','72deedd3bc4a4561901eab9f29d29c53a0090fa0da9847df95a0e34e742f0ecd59e40b04a3ad4e738eb61fede9367378'],['$750','a6ae76611d7f4be7a0636ef5e2ba49da365ea5d6de6e4d15bb813efd932ab722e22efa427e5e4d50a720dbb0c1172204'],['$1,000','49960a665dba4465a2ec7b4f757b1c03917ed1b0f58c4f9baaa114c17717e7a764c6db0e676f4bfea8d26510483760f0'],['$1,500','2a44055a90a0403eb30c183ba44a65e3afd334464d334896aed8a3f74fcf5dd331a02e49175f497cbba73790a125eb0c'],['$2,000','9fe4f37889b54c25bcb7885e1453fb46ca6e8f62d015407ab58ae60812afd9cd53662b37d09f485ab64b3d4a6d836b06']];
const url=(token:string)=>`https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-${token}?locale=EN_US`;
---
<BaseLayout title="Donate" description=""><PageHero eyebrow="Support Wayfinders" title="Support Wayfinders!" intro="From the newborns in our Motherhood Rising program to the Wise Owls in our 60+ program, we guide hundreds of diverse people outside to connect with themselves, each other, and the earth!" image="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/328f5bcb-fb4b-4472-986f-a19fa4c5af81/2-Christian+with+big+smile+and+hearts.jpg?format=1200w" alt="A smiling Wayfinders participant holding heart-shaped natural objects" />
<Section width="wide"><div class="support"><div><p>Wayfinders gets people <strong>off screens and into nature</strong> to remember simple joys, reduce anxiety, increase mindfulness, and provide a much-needed reset from our device-centric world so we can <strong>re-connect with ourselves, each other, and the earth</strong>. Your <strong>support</strong> is vital to expanding Wayfinders programs and reaching more participants.</p></div><div><h2 class="type-section">Your donation helps us grow more Wayfinders!</h2><div class="amounts" aria-label="Donation amounts">{donations.map(([amount,token])=><Button href={url(token)}>Donate {amount}</Button>)}<Button href={url(donations[1][1])}>Donate $618 (scholarship for 1 child)</Button></div></div></div></Section>
<Section tone="alternate" width="wide"><div class="impact"><img src="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/1635280493765-WQVSU9MC959GIKXONBTP/unsplash-image-qgHGDbbSNm8.jpg?format=1200w" alt="Hands holding a young plant" width="1200" height="800" loading="lazy"/><div><h2 class="type-section">Your contribution moves us closer to meeting our mission of fostering experiential opportunities with nature-connection and social emotional learning, in an effort to develop future sustainability leaders, address mental health issues, and create more equitable access to nature programs.</h2><p>All donations help support Wayfinders!</p><p><strong>$1,000 provides a full scholarship for one participant for a season!</strong></p><p>All other amounts provide partial scholarships and funding for the program.</p><h3 class="type-card">Click on “Support” to email us about other ways you would like to get involved!</h3><Button href="mailto:wayfindersonthehudson@gmail.com?subject=WAYFINDERS%20SUPPORT!">Support</Button></div></div></Section></BaseLayout>
<style>.support,.impact{display:grid;grid-template-columns:.85fr 1.15fr;gap:var(--column-gap);align-items:start}.support h2,.impact h2{margin-top:0}.amounts{display:grid;grid-template-columns:repeat(2,1fr);gap:.75rem}.impact img{width:100%;height:28rem;object-fit:cover;border-radius:var(--radius-card)}@media(max-width:47.999rem){.support,.impact{grid-template-columns:1fr}.amounts{grid-template-columns:1fr}.impact img{height:18rem}.impact :global(.button){width:100%}}</style>
