---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/sections/PageHero.astro'; import Section from '../components/global/Section.astro'; import Button from '../components/global/Button.astro'; import MediaSplit from '../components/sections/MediaSplit.astro'; import CallToAction from '../components/sections/CallToAction.astro';
const donations=[
['$50','4e8bc443ca754c2f8624226ca41b6bbddad4457951d047ae9d1f66f42efaf3d3b25ece104e394248b40a13f736a544a5'],['$100','b9e9a292b0484548afdfce0d7eca50d4579a3e2a457f43d1a3e836da5d6e7698d4f4b5a5aa7e4c059d73366463701c55'],['$250','bfa38a213eb548fab627b400f34351d6d13c36ec5c0049308b0884f5ec1eb205b104746c3f2c4fc1afbe04f2dd3643c0'],['$500','72deedd3bc4a4561901eab9f29d29c53a0090fa0da9847df95a0e34e742f0ecd59e40b04a3ad4e738eb61fede9367378'],['$750','a6ae76611d7f4be7a0636ef5e2ba49da365ea5d6de6e4d15bb813efd932ab722e22efa427e5e4d50a720dbb0c1172204','Donate $750 to sponsor a child for a season'],['$1,000','49960a665dba4465a2ec7b4f757b1c03917ed1b0f58c4f9baaa114c17717e7a764c6db0e676f4bfea8d26510483760f0'],['$1,500','2a44055a90a0403eb30c183ba44a65e3afd334464d334896aed8a3f74fcf5dd331a02e49175f497cbba73790a125eb0c'],['$2,000','9fe4f37889b54c25bcb7885e1453fb46ca6e8f62d015407ab58ae60812afd9cd53662b37d09f485ab64b3d4a6d836b06']];
const url=(token:string)=>`https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-${token}?locale=EN_US`;
---
<BaseLayout title="Donate" description=""><PageHero eyebrow="Support Wayfinders" title="Support Wayfinders!" image="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/328f5bcb-fb4b-4472-986f-a19fa4c5af81/2-Christian+with+big+smile+and+hearts.jpg?format=1200w" alt="A smiling Wayfinders participant holding heart-shaped natural objects" />
<Section width="wide"><div class="donation-intro"><h2 class="type-section">Your donation helps us grow more Wayfinders!</h2><div class="donation-intro__grid"><div class="donation-copy"><p>From the newborns in our Motherhood Rising program to the Wise Owls in our 60+ program, we guide hundreds of diverse people outside to connect with themselves, each other, and the earth!</p><p>Wayfinders gets people <strong>off screens and into nature</strong> to remember simple joys, reduce anxiety, increase mindfulness, and provide a much-needed reset from our device-centric world so we can <strong>re-connect with ourselves, each other, and the earth</strong>. Your <strong>support</strong> is vital to expanding Wayfinders programs and reaching more participants.</p></div><div class="amounts" aria-label="Donation amounts">{donations.map(([amount,token,label])=><Button href={url(token)}>{label ?? `Donate ${amount}`}</Button>)}</div></div></div></Section>
<Section tone="alternate" width="wide"><MediaSplit imagePosition="left" align="start"><img slot="media" src="/images/content/compost-crew-1.jpg" alt="A young Wayfinders participant helping with stewardship work" width="1404" height="2106" loading="lazy"/><Fragment slot="copy"><p class="donation-mission">Your contribution helps us fulfill our mission of creating meaningful opportunities for nature connection and social-emotional learning.</p><p class="donation-mission">Together, we are nurturing future sustainability leaders, supporting mental well-being, and expanding equitable access to transformative experiences in nature.</p><p class="donation-support">All donations help support Wayfinders!</p><p><strong>$750 provides a full scholarship for one participant for a season!</strong></p><p>All other amounts provide partial scholarships and funding for the program.</p></Fragment></MediaSplit></Section><Section><CallToAction heading="Support Wayfinders in another way"><p>Tell us about other ways you would like to get involved!</p><Fragment slot="actions"><Button support variant="secondary">Support</Button></Fragment></CallToAction></Section></BaseLayout>
<style>.donation-intro>h2{margin:0 0 clamp(2rem,5vw,4rem)}.donation-intro__grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);gap:clamp(2rem,6vw,6rem);align-items:start}.donation-copy p{margin:0;font-size:19px}.donation-copy p+p{margin-top:20px}.amounts{display:grid;grid-template-columns:repeat(2,1fr);gap:.75rem}.donation-mission{margin:0;font-family:var(--font-display);font-size:calc(clamp(2rem,4vw,3.5rem) + var(--font-display-size-adjust) - 10px);font-weight:400;line-height:1.08;letter-spacing:-.025em}.donation-mission+.donation-mission{margin-top:30px}.donation-support{margin-top:30px}@media(max-width:47.999rem){.donation-intro__grid,.amounts{grid-template-columns:1fr}}</style>
