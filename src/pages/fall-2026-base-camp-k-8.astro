---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Section from '../components/global/Section.astro';
import Button from '../components/global/Button.astro';
const options = [
  {day:'Tuesdays',ages:'1st–8th graders',dates:'10 weeks · September 22–November 24',time:'3:45–5:45 pm',href:'https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-46a9b4dfa26d4d4389eca15a85435c825b11d31d1d4b437cab8e2493d14104b98cd623f49faf4c59893113898372b577?locale=EN_US&cta=saveandcopylink'},
  {day:'Wednesdays',ages:'1st–8th graders',dates:'10 weeks · September 23–December 9 (skips November 11 and 25)',time:'3:45–5:45 pm',href:'https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-7fd8a8bc9e044b01bf85240931b5fbd4f5a757626a27445693f09090d6789ea3672fa74484ef49e8aa9d515af2163300?locale=EN_US&cta=saveandcopylink'},
  {day:'Thursdays',ages:'Kindergarten',dates:'10 weeks · September 24–December 3 (skips November 26)',time:'3:45–5:00 pm',href:'https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-9298690de1c848788cdeb6c69feb477841b288d9604a49899aa0b671da5468a018d3bfb80ecc401bbb43412950e21e7e?locale=EN_US&cta=copylistmultilink'},
];
const expectations = ['Weekly fire circles: Share gratitude, sing, and deepen group connection.','Nature-connection games: Immersive, playful activities that teach about the local ecosystem through direct experience.','Social-emotional learning: A focus on inclusion, kindness, and community care woven into every activity.','Leadership opportunities: Seasoned Wayfinders mentor and lead new participants, strengthening confidence and group bonds.','Skills: Fire building and tending, knife skills, shelter building, plant identification and foraging, earth art, songs'];
---
<BaseLayout title="Fall 2026 Base Camp K–8" description="Wayfinders Fall Base Camp meets after school on Tuesdays, Wednesdays, and Thursdays at Lenoir Preserve.">
  <PageHero eyebrow="Wayfinders Fall 2026" title="Wayfinders Fall Base Camp" intro="Outdoor play, community building, and leadership development for Kindergarten through 8th grade." image="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/ef419cc4-de2f-4a90-b988-f5144d29feb7/IMG_0165.jpeg?format=1200w" alt="Wayfinders Base Camp participants outdoors together"><p class="location"><strong>Lenoir Preserve</strong> · 19 Dudley Street, Yonkers</p></PageHero>
  <Section width="wide"><div class="notice"><strong>Limited Spaces & Scholarships Available!</strong> FREE Breathwork Sessions for Parents & Caregivers at Drop Off (first session on 9/22 or 9/23) - 4-5:30pm. Open to the Public! (see button below to register)</div><div class="options">{options.map((option) => <article><p class="type-label">{option.ages}</p><h2 class="type-section">{option.day}</h2><p>{option.dates}</p><p>{option.time}</p><Button href={option.href}>Register</Button></article>)}</div></Section>
  <Section width="wide"><div class="details-copy"><p class="type-label">Details</p><h2 class="type-section">All Fall 2026 meeting dates</h2><h3 class="type-card">1st- 8th Graders:</h3><p>3:45 - 5:45 pm @ Lenoir Preserve - 19 Dudley St. Yonkers</p><p><strong>Tuesdays:</strong> 9/22, 9/29, 10/6, 10/13, 10/20, 10/27, 11/3, 11/10, 11/17, 11/24</p><p><strong>Wednesdays:</strong> 9/23, 9/30, 10/7, 10/14, 10/21, 10/28, 11/4, (Skip 11/11), 11/18, (skip 11/25), 12/2, 12/9</p><h3 class="type-card">Kindergarteners:</h3><p>3:45 - 5:00 pm @ Lenoir Preserve - 19 Dudley St. Yonkers</p><p><strong>Thursdays:</strong> 9/24, 10/1, 10/8, 10/15, 10/22, 10/29, 11/5, 11/12, 11/19, (skip 11/26), 12/3</p></div></Section>
  <Section tone="alternate" width="wide"><div class="split"><div><p class="type-label">Growing community together</p><h2 class="type-section">Connected through nature, kindness, and play.</h2><p>Wayfinders Base Camp connects us with ourselves, each other, and the earth. Our fall session offers weekly gatherings that blend outdoor play, community-building, and leadership development.</p><ul>{expectations.map((item) => <li>{item}</li>)}</ul></div><img src="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/3b8bbe34-7a41-4a5e-95b6-2381442780c7/IMG_1715.jpeg?format=1200w" alt="Children exploring during Wayfinders Base Camp" width="1200" height="900" loading="lazy" /></div></Section>
  <Section width="wide"><div class="detail-grid"><article><h2 class="type-card">Why join</h2><p>Build friendships and a supportive community. Learn about the natural world through play. Grow emotionally and as a leader in a welcoming environment.</p><p>Our community is strong—and keeps growing stronger. Join us this fall to get active, energized, and connected.</p></article><article><h2 class="type-card">Restoration Nation</h2><p>We explore our local ecosystem through planting native trees, shrubs, grasses, and forbs in our ecosystem restoration project at Lenoir Preserve. We tend the land by removing invasive plants, and watering newly planted natives. We may repair the deer exclosure we installed to ensure it’s still protecting the restoration area.</p></article><article><h2 class="type-card">Age groups</h2><p>Same age and mixed age opportunities are available throughout Base Camp: Mixed age groups foster personal growth and village building; younger kids look up to older kids as role models; older kids grow into strong leaders as they facilitate activities and work with younger kids.<br /><br />Base Camp meets after school on Tuesday and Wednesday afternoons for 1st-8th graders (some participants join us for both days)<br /><br />Thursdays for Kindergarteners!</p></article><article><h2 class="type-card">Weather</h2><p>Takes place outdoors in the nature preserve with indoor space and activities available. Weather appropriate clothing is required and participants are advised on how to prepare.</p></article></div><div class="gallery"><img src="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/61ddf4e9-9f95-49fe-840c-b71ec5ad8b77/IMG_3626.jpg?format=1200w" alt="Children gathered in the woods" width="1200" height="900" loading="lazy" /><img src="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/954b56d9-449c-48af-bdcf-8600061b497e/IMG_2939.jpg?format=1200w" alt="Wayfinders participants outdoors" width="1200" height="900" loading="lazy" /><img src="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/162da3a6-5e50-42b1-b7d5-d572a21e23e7/bryte+and+jude.jpg?format=1200w" alt="Two children exploring outdoors" width="1200" height="900" loading="lazy" /></div><div class="cta"><h2 class="type-section">Open to all.</h2><div><Button href="https://forms.gle/bMqwnJeoiTaaBRiz6" variant="secondary">Register for breathwork</Button><Button href="https://www.wayfindersonthehudson.com/scholarships-1">Apply for a scholarship</Button></div></div><p class="contact"><a href="mailto:wayfindersonthehudson@gmail.com">wayfindersonthehudson@gmail.com</a><br />(917) 318-3888</p></Section>
</BaseLayout>
<style>
  .location { margin-top:1.5rem; }.notice { margin-bottom:2rem;padding:1.25rem;border-left:.35rem solid var(--color-rust);background:var(--color-cream); }
  .options,.detail-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:1rem; }.options article,.detail-grid article { padding:var(--card-padding);border:1px solid var(--color-line);border-radius:var(--radius-card);background:var(--color-surface);box-shadow:var(--shadow-soft); }.options h2,.options .type-label,.detail-grid h2{margin:0}.options article{display:flex;align-items:flex-start;flex-direction:column}.options article p:nth-of-type(2){flex:1}.split{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:var(--column-gap)}.split img{width:100%;height:32rem;object-fit:cover;border-radius:var(--radius-card)}.split p,.split li,.detail-grid p{color:var(--color-ink-muted)}.detail-grid{grid-template-columns:repeat(2,1fr)}.cta{display:flex;align-items:center;justify-content:space-between;gap:2rem;margin-top:3rem;padding:var(--card-padding);border-radius:var(--radius-card);background:var(--color-forest-dark);color:var(--color-cream)}.cta h2{margin:0;color:inherit}.cta div{display:flex;flex-wrap:wrap;gap:.75rem}
  .cta :global(.secondary){border-color:var(--color-cream);color:var(--color-cream)}.cta :global(.secondary:hover){border-color:var(--color-cream);background:var(--color-cream);color:var(--color-forest-dark)}
  .gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:3rem}.gallery img{width:100%;height:16rem;object-fit:cover;border-radius:var(--radius-card)}.contact{margin-top:2rem}.details-copy{max-width:var(--width-prose)}@media(max-width:47.999rem){.options,.detail-grid,.split,.gallery{grid-template-columns:1fr}.split img{height:20rem}.cta{align-items:flex-start;flex-direction:column}.cta :global(.button){width:100%}.cta div{width:100%}}
</style>
