---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Section from '../components/global/Section.astro';
import ProgramCard from '../components/cards/ProgramCard.astro';
import CardGrid from '../components/sections/CardGrid.astro';
const programs = [
  ['Motherhood Rising: Tending the Roots (6 weeks - 12 months)','Provides new parents/ guardians/ caregivers with a space to connect with themselves and their babies, build community with other caregivers, and the earth. Program includes both active movement (hiking & stretching), and sharing time. Indoor time in the nature center is available as needed.','/motherhood-rising-6-weeks-12-months','https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/95933549-62ba-461b-a6af-327f93917380/IMG_1780.jpg?format=1200w','A caregiver holding a baby outdoors'],
  ['Forest Tots (12 - 30 months)','Play-based, sensory rich experience in nature where toddlers and caregivers will be nourished from hands on experiences together outdoors. Free play inspired by thoughtful nature-based invitations allow children to engage deeply. A short circle time with songs and finger plays related to the seasons will sweetly round out the time together.','/forest-tots-12-30-months','https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/280a8097-6a1d-478d-b98d-8be8399cda20/IMG_9287.jpg?format=1200w','A young child exploring outdoors'],
  ['Base Camp (After School Program) - Tues. & Weds 1st-8th Grades; Thurs Kindergarten only','Explore connections with ourselves, each other & the earth through weekly fire circles and immersive nature connection games & activities, social emotional learning, leadership development, survival skills, and community building.','/fall-2026-base-camp-k-8','https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/61ddf4e9-9f95-49fe-840c-b71ec5ad8b77/IMG_3626.jpg?format=1200w','Children gathered together in the woods'],
  ['Rose Blossoms (12-15 year old girls)','A blossoming community of young women ages 12–15 exploring Wayfinders’ values of caring for ourselves, each other, & the Earth. Meets 6 times over the 2026-27 school year for camping & weekend programs for exploration of coming of age. Culminates with a rite of passage experience.','/rose-blossoms-12-15-year-old-girls','https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/3c4b2445-10f9-412d-9f12-db2f241ab522/bella+and+charley.jpg?format=1200w','Two young people outdoors'],
  ['Internships - 6th-12th Grades','Provides teens with the essential skills & character building to effectively mentor youth. Participants receive a Wayfinder’s Mentorship Certification. 6th & 8th Graders (Mini Mentors) - Wayfinders who have participated for more than 2 seasons are eligible. 9th & 10th Graders (Jr. Mentors) - Community Service Hrs. 11th & 12th Graders (Mentor in Training) - Community service hrs or stipend.','/internships','https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/1654967677275-LC008BNCTALQGB839X4J/Rebecca+with+Girls.jpeg?format=1200w','A mentor with young participants outdoors'],
  ['Wise Owls (55+)','“Wise Owls” is a walking and talking program that provides a space for people 55+ to pause to bring more meaning to this moment, feel gratitude, and connect with others in the same stage of life as they explore their connection to nature.','/wise-owls-55-1','https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/d7fcfdd8-cdf7-45ed-9c89-798fac288223/IMG_1769.jpg?format=1200w','Adults walking together outdoors'],
  ['Corporate Retreats (Adults)','Team Building meets nature connection and Social Emotional Learning to create healthy workplaces and teams.','/corporate-retreats','https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/ad398566-f667-4223-8bcf-262c0a6d3661/IMG_4469.jpg?format=1200w','Adults participating in a nature-based retreat'],
  ['School Programs (All Ages)','Wayfinders provides orientations, after-school programs, in-school programs, field trips, and professional development.','/school-programs','https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/29f39634-d2e4-4e47-af7e-df4d460b0f65/_DSC9058.jpg?format=1200w','Students taking part in an outdoor activity'],
  ['Walk & Talks','Nature-informed walk and talk therapy for individuals seeking a therapeutic experience that extends beyond the traditional office setting.','/','https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/e24fef2d-985f-424f-a81a-00548c58060c/IMG_0468.jpg?format=1200w','A wooded trail'],
];
---
<BaseLayout title="Fall 2026 Programs Overview" description="Explore Fall 2026 programs from Wayfinders on the Hudson.">
  <PageHero eyebrow="FALL 2026 PROGRAMS" title="Fall 2026 Programs" intro="Spend some screen-free time in the woods! Scholarships & Payment Plans are available for all programs!" image="/images/banners/lark2.jpg" alt="A lark perched in a meadow" overlayOpacity={0.5} />
  <Section width="wide"><CardGrid columns={3}>{programs.map(([title,description,href,image,alt]) => <ProgramCard {title} {description} {href} {image} {alt} />)}</CardGrid></Section>
</BaseLayout>
