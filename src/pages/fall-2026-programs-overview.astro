---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Section from '../components/global/Section.astro';
import ProgramCard from '../components/cards/ProgramCard.astro';
const programs = [
  ['Motherhood Rising: Tending the Roots (6 weeks–12 months)','A space for caregivers to connect with themselves and their babies, build community, move, hike, stretch, and share.','/motherhood-rising-6-weeks-12-months','https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/95933549-62ba-461b-a6af-327f93917380/IMG_1780.jpg?format=1200w','Caregiver and baby spending time outdoors'],
  ['Forest Tots (12–30 months)','A play-based, sensory-rich experience where toddlers and caregivers learn from hands-on experiences together outdoors.','/forest-tots-12-30-months','https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/280a8097-6a1d-478d-b98d-8be8399cda20/IMG_9287.jpg?format=1200w','A young child exploring nature'],
  ['Base Camp (K–8)','Weekly fire circles, immersive nature games, social-emotional learning, leadership development, survival skills, and community building.','/fall-2026-base-camp-k-8','https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/61ddf4e9-9f95-49fe-840c-b71ec5ad8b77/IMG_3626.jpg?format=1200w','Wayfinders children gathered in the woods'],
  ['Rose Blossoms (ages 12–15)','A community of young women exploring care for ourselves, each other, and the earth through camping, weekend programs, and rites of passage.','/rose-blossoms-12-15-year-old-girls','https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/3c4b2445-10f9-412d-9f12-db2f241ab522/bella+and+charley.jpg?format=1200w','Two Rose Blossoms participants outdoors'],
  ['Internships (grades 6–12)','Mentorship and character-building opportunities for Mini Mentors, Junior Mentors, and Mentors in Training.','/internships','https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/1654967677275-LC008BNCTALQGB839X4J/Rebecca+with+Girls.jpeg?format=1200w','A Wayfinders mentor with young participants'],
  ['Wise Owls (55+)','A walking and talking program for people 55+ to pause, feel gratitude, and connect with peers and nature.','/wise-owls-55-1','https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/d7fcfdd8-cdf7-45ed-9c89-798fac288223/IMG_1769.jpg?format=1200w','Adults walking together in nature'],
  ['Autumn Women’s Retreat','Gather around the fire to reflect on summer, set intentions for autumn, rest, and connect.','/autumn-2026-womens-retreat','https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/2747a8bf-7a1a-4a91-8295-fc9faf882066/IMG_3736.jpg?format=1200w','Women gathering outdoors for a retreat'],
  ['Dance Embody Collective','A monthly evening of listening, guest facilitation, ecstatic dance, and somatic exploration.','/dance-embody-collective','https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/3273a57a-857c-4623-8875-7c5838ba7b57/IMG_1760.jpg?format=1200w','People dancing and moving together'],
  ['Corporate Retreats','Team building meets nature connection and social-emotional learning to create healthier workplaces and teams.','/corporate-retreats','https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/ad398566-f667-4223-8bcf-262c0a6d3661/IMG_4469.jpg?format=1200w','Adults participating in a nature-based retreat'],
  ['School Programs','Orientations, after-school and in-school programs, field trips, and professional development for all ages.','/school-programs','https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/29f39634-d2e4-4e47-af7e-df4d460b0f65/_DSC9058.jpg?format=1200w','Students taking part in an outdoor activity'],
  ['Walk & Talks','Nature-informed walk and talk therapy for people seeking an experience beyond the traditional office setting.','/walk-talks','https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/e24fef2d-985f-424f-a81a-00548c58060c/IMG_0468.jpg?format=1200w','A wooded trail for a nature-informed walk'],
];
---
<BaseLayout title="Fall 2026 Programs" description="Explore Fall 2026 nature-connection programs from Wayfinders on the Hudson.">
  <PageHero eyebrow="Programs for all ages" title="Fall 2026 Programs" intro="Spend some screen-free time in the woods. Scholarships and payment plans are available for all programs." image="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/95933549-62ba-461b-a6af-327f93917380/IMG_1780.jpg?format=1200w" alt="Wayfinders participants enjoying time together outdoors" />
  <Section width="wide"><div class="program-grid">{programs.map(([title,description,href,image,alt]) => <ProgramCard {title} {description} href={['/motherhood-rising-6-weeks-12-months','/forest-tots-12-30-months','/fall-2026-base-camp-k-8','/rose-blossoms-12-15-year-old-girls','/wise-owls-55-1','/autumn-2026-womens-retreat','/dance-embody-collective','/corporate-retreats','/walk-talks'].includes(href) ? href : `https://www.wayfindersonthehudson.com${href}`} {image} {alt} />)}</div></Section>
</BaseLayout>
<style>.program-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1.25rem; } @media (max-width:63.999rem){.program-grid{grid-template-columns:repeat(2,1fr)}} @media (max-width:35.999rem){.program-grid{grid-template-columns:1fr}}</style>
