---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/global/Container.astro';
import Button from '../components/global/Button.astro';
import NatureIcon from '../components/global/NatureIcon.astro';
import ProgramOption from '../components/cards/ProgramOption.astro';
import '../styles/family-program.css';
const seriesUrl = 'https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-e57d8a719ec34ad78f6346fc649906397304388497fa402a92590b8d031364fea6d84edf59c54ea7bd395ac1e98867cc?locale=EN_US&cta=saveandcopylink';
const singleUrl = 'https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-dbb80ffdf02349448f5ac0b9e608a6c33513e0223def4d5fb5d83db2c5f452afe4621dea2a7e487b965b095b40a9c2ae?locale=EN_US&cta=saveandcopylink';
const image = 'https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/72e5bec5-fcd3-4ea8-b448-dff43ddb2fc7/IMG_9286.jpg?format=1200w';
---
<BaseLayout title="Forest Tots" description="A play-based outdoor program for toddlers ages 12–30 months and their caregivers at Lenoir Preserve.">
  <main class="family-program" style={`--closing-image:url('${image}')`}>
    <section class="hero" style={`background-image:url('${image}')`}><Container width="wide" class="hero-content"><p class="type-label">Toddlers and caregivers</p><h1>Forest <span>Tots</span></h1><p class="hero-intro">A play-based, sensory-rich experience in nature for toddlers ages 12–30 months and their caregivers.</p><p><strong>Lenoir Preserve</strong> · 19 Dudley Street, Yonkers</p><a class="hero-note" href="#register"><NatureIcon name="heart" size={30} /><span>Wonder grows here:<br /><strong>explore nature together</strong></span></a></Container></section>
    <section id="register" class="choices chapter"><Container width="wide"><header class="section-heading"><p class="type-label">Choose how you’ll join us</p><h2>Meet us in the forest</h2><p>Tuesdays, September 22–November 24 · 10:00–11:15 am</p></header><div class="option-grid"><ProgramOption title="Full series" label="10 weekly sessions" date="September 22 & 29; October 6, 13, 20 & 27; November 3, 10, 17 & 24" time="10:00–11:15 am · $350" href={seriesUrl} icon="leaf" /><ProgramOption title="Single session" label="A flexible first visit" date="Choose one available Tuesday" time="10:00–11:15 am · $40" href={singleUrl} icon="heart" accent="earth" /></div><p class="availability"><NatureIcon name="leaf" size={24} /><strong><a href="/scholarships-1">Scholarships available.</a></strong></p></Container></section>
    <section class="story chapter"><Container width="wide" class="story-grid"><div class="story-image"><img src="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/89d7429d-91e8-4b55-8830-854ce818efc4/hannah+and+dimitri.jpeg?format=1200w" alt="Hannah Van Dolsen outdoors with her child Dimitri" width="1200" height="900" loading="lazy" /></div><div><p class="type-label">What to expect</p><h2>Hands-on wonder, together.</h2><p>Play-based, sensory-rich outdoor experiences are designed for toddlers and their caregivers.</p><ul><li><NatureIcon name="leaf" size={25} /><span>Hands-on, nature-focused activities and free play prompted by thoughtful invitations to explore</span></li><li><NatureIcon name="community" size={25} /><span>Short circle time with seasonal songs and finger plays</span></li><li><NatureIcon name="heart" size={25} /><span>Opportunities for parent–child bonding and sensory development in a natural setting</span></li></ul><p class="handwritten">Small hands, big discoveries.</p></div></Container></section>
    <section class="experience chapter"><Container width="wide"><header class="section-heading"><p class="type-label">A morning at Forest Tots</p><h2>Room to discover and connect</h2></header><div class="experience-grid"><article><NatureIcon name="leaf" size={54} /><h3>Explore freely</h3><p>Follow thoughtful invitations into seasonal, sensory-rich play.</p></article><article><NatureIcon name="community" size={54} /><h3>Gather together</h3><p>Share songs, finger plays, and a short circle with new friends.</p></article><article><NatureIcon name="heart" size={54} /><h3>Deepen your bond</h3><p>Make space for connection between caregiver, child, and nature.</p></article></div></Container></section>
    <section class="details chapter"><Container width="wide"><div class="details-layout"><header><p class="type-label">Your guide in the forest</p><h2>Meet Hannah Van Dolsen</h2><p>Forest Tots is led by Hannah Van Dolsen, former forest school teacher (Little Leaf). Hannah has her own little one, Dimitri, and is passionate about raising him and all young ones in deep connection with nature.</p></header><dl class="detail-list"><div><dt>When</dt><dd>Tuesdays, September 22–November 24 · 10:00–11:15 am</dd></div><div><dt>Where</dt><dd>Lenoir Preserve · 19 Dudley Street, Yonkers</dd></div><div><dt>Cost</dt><dd>$350 for the series (10 sessions) · $40 for individual sessions</dd></div><div><dt>Learn more</dt><dd><a href="https://www.wayfindersonthehudson.com/hannah-van-dolsen">Learn more about Hannah</a></dd></div></dl></div></Container></section>
    <section class="closing chapter"><Container width="wide" class="closing-grid"><div><p class="type-label">Let wonder lead the way</p><h2>Ready to explore?</h2><p>Choose the full series or join us for one Forest Tots session.</p><div class="closing-actions"><Button href={seriesUrl}>Register for the series</Button><Button href={singleUrl}>Register for one session</Button></div></div><aside><h3>Questions?</h3><p><a href="mailto:wayfindersonthehudson@gmail.com">wayfindersonthehudson@gmail.com</a><br />(917) 318-3888</p></aside></Container></section>
  </main>
</BaseLayout>
