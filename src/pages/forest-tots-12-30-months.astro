---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Section from '../components/global/Section.astro';
import Button from '../components/global/Button.astro';
const seriesUrl = 'https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-e57d8a719ec34ad78f6346fc649906397304388497fa402a92590b8d031364fea6d84edf59c54ea7bd395ac1e98867cc?locale=EN_US&cta=saveandcopylink';
const singleUrl = 'https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-dbb80ffdf02349448f5ac0b9e608a6c33513e0223def4d5fb5d83db2c5f452afe4621dea2a7e487b965b095b40a9c2ae?locale=EN_US&cta=saveandcopylink';
---
<BaseLayout title="Forest Tots" description="A play-based outdoor program for toddlers ages 12–30 months and their caregivers at Lenoir Preserve.">
  <PageHero eyebrow="Toddlers and caregivers" title="Forest Tots" intro="A play-based, sensory-rich experience in nature for toddlers ages 12–30 months and their caregivers." image="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/72e5bec5-fcd3-4ea8-b448-dff43ddb2fc7/IMG_9286.jpg?format=1200w" alt="A toddler exploring outdoors at Forest Tots"><div class="actions"><Button href={seriesUrl}>Register for the series</Button><Button href={singleUrl} variant="secondary">Register for one session</Button></div></PageHero>
  <Section width="wide"><div class="facts"><article><p class="type-label">When</p><h2 class="type-card">Tuesdays, September 22–November 24</h2><p>10:00–11:15 am</p><p>September 22 & 29; October 6, 13, 20 & 27; November 3, 10, 17 & 24</p></article><article><p class="type-label">Where</p><h2 class="type-card">Lenoir Preserve</h2><p>19 Dudley Street, Yonkers</p></article><article><p class="type-label">Cost</p><h2 class="type-card">Choose what works</h2><p>$350 for the 10-session series<br />$40 for an individual session</p><a href="/scholarships-1">Scholarships available</a></article></div></Section>
  <Section tone="alternate" width="wide"><div class="split"><div><p class="type-label">What to expect</p><h2 class="type-section">Hands-on wonder, together.</h2><ul><li>Play-based, sensory-rich outdoor experiences designed for toddlers and their caregivers.</li><li>Nature-focused activities and free play prompted by thoughtful invitations to explore.</li><li>Short circle time with seasonal songs and finger plays.</li><li>Opportunities for parent–child bonding and sensory development in a natural setting.</li></ul></div><img src="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/89d7429d-91e8-4b55-8830-854ce818efc4/hannah+and+dimitri.jpeg?format=1200w" alt="Hannah Van Dolsen outdoors with her child Dimitri" width="1200" height="900" loading="lazy" /></div></Section>
  <Section width="prose"><p class="type-label">Your facilitator</p><h2 class="type-section">Hannah Van Dolsen</h2><p class="bio">Forest Tots is led by Hannah Van Dolsen, former forest school teacher at Little Leaf. Hannah has her own little one, Dimitri, and is passionate about raising him and all young ones in deep connection with nature.</p><Button href="https://www.wayfindersonthehudson.com/hannah-van-dolsen" variant="secondary">Learn more about Hannah</Button></Section>
</BaseLayout>
<style>.actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:2rem}.facts{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.facts article{padding:var(--card-padding);border:1px solid var(--color-line);border-radius:var(--radius-card);background:var(--color-surface);box-shadow:var(--shadow-soft)}.facts h2,.facts .type-label{margin:0}.facts p{color:var(--color-ink-muted)}.split{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:var(--column-gap)}.split h2{margin-top:.75rem}.split li,.bio{color:var(--color-ink-muted)}.split img{width:100%;height:32rem;object-fit:cover;border-radius:var(--radius-card)}.bio{font-size:1.1rem}@media(max-width:47.999rem){.facts,.split{grid-template-columns:1fr}.split img{height:20rem}.actions :global(.button){width:100%}}</style>
