---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Section from '../components/global/Section.astro';
import Button from '../components/global/Button.astro';
import CardGrid from '../components/sections/CardGrid.astro';
import InfoCard from '../components/sections/InfoCard.astro';
import MediaSplit from '../components/sections/MediaSplit.astro';
import CallToAction from '../components/sections/CallToAction.astro';
const seriesUrl = 'https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-e57d8a719ec34ad78f6346fc649906397304388497fa402a92590b8d031364fea6d84edf59c54ea7bd395ac1e98867cc?locale=EN_US&cta=saveandcopylink';
const singleUrl = 'https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-dbb80ffdf02349448f5ac0b9e608a6c33513e0223def4d5fb5d83db2c5f452afe4621dea2a7e487b965b095b40a9c2ae?locale=EN_US&cta=saveandcopylink';
---
<BaseLayout title="Forest Tots" description="A play-based outdoor program for toddlers ages 12–30 months and their caregivers at Lenoir Preserve.">
  <PageHero eyebrow="Toddlers and caregivers" title="Forest Tots" intro="A play-based, sensory-rich experience in nature for toddlers ages 12–30 months and their caregivers." image="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/72e5bec5-fcd3-4ea8-b448-dff43ddb2fc7/IMG_9286.jpg?format=1200w" alt="A toddler exploring outdoors at Forest Tots"><div class="actions"><Button href={seriesUrl}>Register for the series</Button><Button href={singleUrl} variant="secondary">Register for one session</Button></div></PageHero>
  <Section width="wide"><CardGrid columns={3}><InfoCard label="When" heading="Tuesdays, September 22–November 24" headingLevel="h2"><p>10:00–11:15 am</p><p>September 22 & 29; October 6, 13, 20 & 27; November 3, 10, 17 & 24</p></InfoCard><InfoCard label="Where" heading="Lenoir Preserve" headingLevel="h2"><p>19 Dudley Street, Yonkers</p></InfoCard><InfoCard label="Cost" heading="Choose what works" headingLevel="h2"><p>$350 for the series (10 sessions)<br />$40 for individual sessions</p><a href="/scholarships-1">Scholarships available</a></InfoCard></CardGrid></Section>
  <Section tone="alternate" width="wide"><MediaSplit><div slot="copy"><p class="type-label">What to expect</p><h2 class="type-section">Hands-on wonder, together.</h2><ul><li>Play-based, sensory-rich outdoor experiences designed for toddlers and their caregivers</li><li>Hands-on, nature-focused activities and free play prompted by thoughtful invitations to explore</li><li>Short circle time with seasonal songs and finger plays</li><li>Opportunities for parent–child bonding and sensory development in a natural setting</li></ul></div><img slot="media" src="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/89d7429d-91e8-4b55-8830-854ce818efc4/hannah+and+dimitri.jpeg?format=1200w" alt="Hannah Van Dolsen outdoors with her child Dimitri" width="1200" height="900" loading="lazy" /></MediaSplit></Section>
  <Section width="wide"><CallToAction heading="Hannah Van Dolsen"><p>Forest Tots is led by Hannah Van Dolsen, former forest school teacher (Little Leaf). Hannah has her own little one, Dimitri, and is passionate about raising him and all young ones in deep connection with nature.</p><Fragment slot="actions"><Button href="https://www.wayfindersonthehudson.com/hannah-van-dolsen" variant="secondary">Learn more about Hannah</Button></Fragment></CallToAction><p class="contact"><a href="mailto:wayfindersonthehudson@gmail.com">wayfindersonthehudson@gmail.com</a><br />(917) 318-3888</p></Section>
</BaseLayout>
<style>.actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:2rem}.contact{margin-top:2rem}@media(max-width:47.999rem){.actions :global(.button){width:100%}}</style>
