---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/global/Container.astro';
import Button from '../components/global/Button.astro';
import NatureIcon from '../components/global/NatureIcon.astro';

const camps = [
  { icon: 'leaf', date: 'October 12, 2026', title: 'Indigenous Peoples’ Day', time: '9am – 3pm', href: 'https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-a140319a9f4d4508b941abd80c3fc726c804061eb2b14da4b2e13aab088acfd9f7d9f18354b7404b8dffca8f1341ea03?locale=EN_US&cta=saveandcopylink' },
  { icon: 'fire', date: 'November 11, 2026', title: 'Veteran’s Day', time: '9am – 3pm', href: 'https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-9ce099ef3d2143b281148a0cb7d8032c170c415fde3b4d7e8d1aa166d9edbf4bb8fe86c956e64a10b057de8c9b10d101?locale=EN_US&cta=saveandcopylink' },
] as const;
---
<BaseLayout title="Holiday Camps (1st–8th graders)" description="Wayfinders Holiday Camps for 1st through 8th graders at Lenoir Preserve.">
  <section class="hero"><Container width="wide" class="hero-content"><p class="type-label">1st–8th graders</p><h1>Holiday <span>Camps</span></h1><p class="hero-intro">A day outdoors at Lenoir Preserve, for play, connection, and seasonal wonder.</p><a class="hero-note" href="#camps"><NatureIcon name="heart" size={31} /><span>Scholarships and sibling<br /><strong>discounts available</strong></span></a></Container></section>
  <section id="camps" class="camps chapter"><Container width="wide"><header class="section-heading"><p class="type-label">Choose your camp day</p><h2>Make a day in nature.</h2><p>Join Wayfinders at Lenoir Preserve during the school holiday.</p></header><div class="camp-grid">{camps.map((camp) => <article><span class="icon"><NatureIcon name={camp.icon} size={40} /></span><p class="type-label">{camp.date}</p><h3>{camp.title}</h3><div class="camp-info"><p><NatureIcon name="clock" size={21} />{camp.time}</p><p><NatureIcon name="mountain" size={21} />Lenoir Preserve</p></div><Button href={camp.href}>Register <span aria-hidden="true">→</span></Button></article>)}</div></Container></section>
  <section class="together chapter"><Container width="wide" class="together-grid"><div class="together-copy"><p class="type-label">Time outside matters</p><h2>A little extra room to explore.</h2><p>Holiday Camps give 1st through 8th graders a full day at Lenoir Preserve.</p><p class="handwritten">A school day off, spent in the woods.</p></div><div class="together-image"><img src="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/ed45a473-af40-4eb2-a839-dfdb2ca0da09/IMG_1415.jpeg?format=1200w" alt="Two children outdoors at a Wayfinders camp" width="1200" height="1400" loading="lazy" /></div></Container></section>
  <section class="closing chapter"><Container width="wide" class="closing-grid"><div><p class="type-label">Everyone is welcome</p><h2>Scholarships and sibling discounts are available.</h2><p>Learn more about scholarship support for Wayfinders programs.</p></div><aside><Button href="/scholarships-1" variant="secondary">Learn about scholarships <span aria-hidden="true">→</span></Button></aside></Container></section>
</BaseLayout>
<style>
  .chapter{padding-block:clamp(5rem,10vw,9rem)}.hero{position:relative;display:grid;min-height:calc(min(48rem,82vh) + 50px);align-items:center;isolation:isolate;background:url('/images/heroes/holiday-camps-leaves-2.jpg') center / cover no-repeat;color:white}.hero::after{position:absolute;z-index:-1;inset:0;content:'';background:linear-gradient(90deg,rgb(10 27 17 / .9),rgb(10 27 17 / .63) 48%,rgb(10 27 17 / .12) 80%)}:global(.hero-content){padding-block:5rem;transform:translateY(50px)}.hero .type-label,.closing .type-label{color:#e3dda3}h1{max-width:43rem;margin:.5rem 0 1rem;color:white;font-family:var(--font-display);font-size:clamp(4rem,9vw,7.4rem);font-weight:500;letter-spacing:-.04em;line-height:.78}h1 span{display:block;margin:.18em 0 0 .1em;color:#d3c769;font-family:var(--font-hand);font-size:.72em;font-weight:500;letter-spacing:0;line-height:1}.hero-intro{max-width:37rem;font-size:clamp(1.15rem,2vw,1.45rem);line-height:1.55}.hero-note{display:inline-flex;align-items:center;gap:1rem;margin-top:1.8rem;padding:.75rem 1.25rem;border-radius:1rem;background:rgb(101 120 79 / .9);color:white;font-size:.8rem;letter-spacing:.1em;line-height:1.45;text-decoration:none;text-transform:uppercase}
  .camps{background:linear-gradient(120deg,#fbf8f0,#f5f1e7)}.section-heading{max-width:50rem;margin:0 auto clamp(2.5rem,5vw,4rem);text-align:center}.section-heading .type-label,.together .type-label{color:var(--color-moss)}.section-heading h2,.together h2,.closing h2{margin:.3rem 0 .6rem;font-family:var(--font-display);font-size:clamp(2.7rem,5vw,4.5rem);font-weight:600;letter-spacing:-.025em;line-height:1}.section-heading>p:last-child{margin:0;font-size:1.15rem}.camp-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(1rem,2vw,1.5rem);max-width:58rem;margin:auto}.camp-grid article{padding:clamp(1.5rem,3vw,2.5rem);border:1px solid rgb(49 88 67 / .12);border-radius:var(--radius-card);background:rgb(255 253 247 / .78);box-shadow:var(--shadow-soft)}.icon{display:grid;width:4.8rem;aspect-ratio:1;place-items:center;border-radius:50%;background:var(--color-page-alt);color:var(--color-moss)}.camp-grid article:nth-child(2) .icon{background:var(--color-cream);color:var(--color-earth)}.camp-grid .type-label{margin:1.5rem 0 .45rem;color:var(--color-moss)}.camp-grid h3{margin:0;color:var(--color-forest-dark);font-family:var(--font-display);font-size:clamp(1.9rem,3.5vw,2.7rem);line-height:1.05}.camp-info{display:grid;gap:.6rem;margin:1.75rem 0}.camp-info p{display:flex;align-items:center;gap:.65rem;margin:0}.camp-info :global(svg){color:var(--color-moss)}
  .together{background:#e8ebdf}.together-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(3rem,7vw,7rem);align-items:center}.together-copy{max-width:35rem}.handwritten{color:var(--color-earth);font-family:var(--font-hand);font-size:clamp(1.6rem,3vw,2.2rem);line-height:1.1}.together-image{overflow:hidden;min-height:32rem;border-radius:50% 50% 0 0}.together-image img{width:100%;height:100%;object-fit:cover}.closing{background:linear-gradient(90deg,rgb(13 35 23 / .94),rgb(13 35 23 / .75)),url('https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/bec60d19-ef19-48b3-9572-ef292cb5611f/IMG_1431+%282%29.jpeg?format=1600w') center / cover;color:white}.closing-grid{display:grid;grid-template-columns:1.5fr .7fr;gap:clamp(3rem,7vw,6rem);align-items:center}.closing h2{color:white;font-size:clamp(3.5rem,7vw,6rem)}.closing aside{padding-left:clamp(2rem,5vw,4rem);border-left:1px solid rgb(255 255 255 / .5)}.closing aside :global(.button){border-color:white;color:white}
  @media(max-width:63.999rem){.together-grid,.closing-grid{grid-template-columns:1fr}.together-image{min-height:26rem}.closing aside{padding:2rem 0 0;border-top:1px solid rgb(255 255 255 / .5);border-left:0}}@media(max-width:47.999rem){.hero{min-height:calc(42rem + 50px);background-position:62% center}.hero::after{background:rgb(10 27 17 / .72)}h1{font-size:clamp(3.8rem,18vw,5.8rem)}.camp-grid{grid-template-columns:1fr}}
  @media(min-width:48rem){.hero::after{background:linear-gradient(90deg,rgb(10 27 17 / .9) 0%,rgb(10 27 17 / 0) 85%)}}
</style>
