---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Section from '../components/global/Section.astro';
import Button from '../components/global/Button.astro';
import CardGrid from '../components/sections/CardGrid.astro';
import InfoCard from '../components/sections/InfoCard.astro';
import MediaSplit from '../components/sections/MediaSplit.astro';
const indigenousUrl='https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-a140319a9f4d4508b941abd80c3fc726c804061eb2b14da4b2e13aab088acfd9f7d9f18354b7404b8dffca8f1341ea03?locale=EN_US&cta=saveandcopylink';
const veteransUrl='https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-9ce099ef3d2143b281148a0cb7d8032c170c415fde3b4d7e8d1aa166d9edbf4bb8fe86c956e64a10b057de8c9b10d101?locale=EN_US&cta=saveandcopylink';
---
<BaseLayout title="Holiday Camps (1st - 8th graders)" description="Wayfinders Holiday Camps for 1st through 8th graders at Lenoir Preserve.">
<PageHero eyebrow="1st - 8th graders" title="Holiday Camps!" intro="Scholarships and Sibling Discounts are available!" image="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/bec60d19-ef19-48b3-9572-ef292cb5611f/IMG_1431+%282%29.jpeg?format=1200w" alt="Children enjoying an outdoor Wayfinders camp" />
<Section width="wide"><MediaSplit imagePosition="left" align="start"><div slot="media"><img src="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/ed45a473-af40-4eb2-a839-dfdb2ca0da09/IMG_1415.jpeg?format=1200w" alt="Two children outdoors at a Wayfinders camp" width="1200" height="1400" loading="lazy" /><p class="scholarship">Scholarships and Sibling Discounts are available!</p><Button href="/scholarships-1" variant="secondary">Learn more</Button></div><div slot="copy"><CardGrid><InfoCard heading="Indigenous Peoples’ Day" label="October 12, 2026" headingLevel="h2"><p>9am - 3pm</p><p>Lenoir Preserve</p><Button slot="action" href={indigenousUrl}>Register</Button></InfoCard><InfoCard heading="Veteran’s Day" label="November 11, 2026" headingLevel="h2"><p>9am - 3pm</p><p>Lenoir Preserve</p><Button slot="action" href={veteransUrl}>Register</Button></InfoCard></CardGrid></div></MediaSplit></Section>
</BaseLayout>
<style>.scholarship{font-family:var(--font-display);font-size:1.5rem;font-weight:700}</style>
