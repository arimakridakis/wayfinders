---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Section from '../components/global/Section.astro';
import Button from '../components/global/Button.astro';
const camps = [
  { title:'Indigenous Peoples’ Day', date:'October 12, 2026', href:'https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-a140319a9f4d4508b941abd80c3fc726c804061eb2b14da4b2e13aab088acfd9f7d9f18354b7404b8dffca8f1341ea03?locale=EN_US&cta=saveandcopylink', image:'https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/bec60d19-ef19-48b3-9572-ef292cb5611f/IMG_1431+%282%29.jpeg?format=1200w' },
  { title:'Veteran’s Day', date:'November 11, 2026', href:'https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-9ce099ef3d2143b281148a0cb7d8032c170c415fde3b4d7e8d1aa166d9edbf4bb8fe86c956e64a10b057de8c9b10d101?locale=EN_US&cta=saveandcopylink', image:'https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/ed45a473-af40-4eb2-a839-dfdb2ca0da09/IMG_1415.jpeg?format=1200w' },
];
---
<BaseLayout title="Holiday Camps" description="Wayfinders holiday camps for 1st through 8th graders at Lenoir Preserve.">
  <PageHero eyebrow="Grades 1–8" title="Holiday Camps" intro="Spend a day outdoors at Lenoir Preserve. Scholarships and sibling discounts are available." image={camps[0].image} alt="Children enjoying a Wayfinders holiday camp outdoors" />
  <Section width="wide"><div class="camps">{camps.map((camp) => <article><img src={camp.image} alt={`Participants at the ${camp.title} holiday camp`} width="900" height="650" loading="lazy" /><div><p class="type-label">9:00 am–3:00 pm · Lenoir Preserve</p><h2 class="type-section">{camp.title}</h2><p class="date">{camp.date}</p><Button href={camp.href}>Register</Button></div></article>)}</div><div class="support"><p>Scholarships and sibling discounts are available.</p><Button href="/scholarships-1" variant="secondary">Learn about scholarships</Button></div></Section>
</BaseLayout>
<style>.camps{display:grid;grid-template-columns:repeat(2,1fr);gap:1.25rem}.camps article{overflow:hidden;border:1px solid var(--color-line);border-radius:var(--radius-card);background:var(--color-surface);box-shadow:var(--shadow-soft)}.camps img{width:100%;height:22rem;object-fit:cover}.camps article>div{padding:var(--card-padding)}.camps h2,.camps .type-label{margin:0}.date{color:var(--color-ink-muted);font-size:1.15rem}.support{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-top:2rem;padding:var(--card-padding);border-radius:var(--radius-card);background:var(--color-cream)}.support p{font-weight:700}@media(max-width:47.999rem){.camps{grid-template-columns:1fr}.camps img{height:18rem}.support{align-items:flex-start;flex-direction:column}.support :global(.button){width:100%}}</style>
