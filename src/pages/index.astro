---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/global/Button.astro';
import DecorativeHeading from '../components/global/DecorativeHeading.astro';
import Section from '../components/global/Section.astro';
import PageHero from '../components/sections/PageHero.astro';
const reasons = [
  ['Core Values', 'Participants are encouraged to see themselves as part of the web of life; practice gratitude, land acknowledgment, and sit spot; explore self-awareness; build relationships and community; connect with the earth; cultivate leadership skills; and be called to social action.'],
  ['Leadership Development', 'Wayfinders participants move from identifying challenges to forming and implementing small, measurable solutions—and bring those skills back to their communities.'],
  ['Community Building & Social Justice', 'The Wayfinders community is a place to define the values we want to live by, understand the systems around us, and consider organizing and leadership opportunities that can overcome barriers.'],
  ['Adolescence to Adulthood', 'Skilled mentors and a supportive peer group give genuine, positive identities room to evolve through self-driven experiences and project-based learning.'],
  ['Safe Space & Belonging', 'Wayfinders are encouraged to be their authentic selves as they explore who they are, how they relate to people, and what they want to contribute to the world.'],
  ['Technology, Social Media & the Climate Crisis', 'Time outdoors, nature skills, fire circles, and shared experiences give young people room to slow down and reconnect with themselves, each other, and the natural world.'],
  ["Your Child's Future", 'Nature connection, social-emotional learning, team building, leadership development, and exercise help participants build resilience and learn to regulate emotions.'],
  ['Rites of Passage', 'Ceremonies create time to pause, reflect, and honor meaningful transitions, personal growth, and each participant’s impact on the larger community.'],
];
---
<BaseLayout title="Wayfinders on the Hudson" description="Screen-free nature programs that connect people with themselves, each other, and the earth.">
  <PageHero eyebrow="Wayfinders on the Hudson" title="Connecting with ourselves, each other, and the earth" intro="Screen-free time in nature. Programs for people of all ages." image="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/509a0849-3528-4cc7-a262-6937b2a4df8f/IMG_5636.jpeg?format=1200w" alt="Wayfinders participants gathered together outdoors">
    <div class="actions"><Button href="/fall-2026-programs-overview">Explore fall programs</Button><Button href="/our-mission" variant="secondary">Our mission</Button></div>
  </PageHero>
  <Section width="wide">
    <div class="feature-grid"><img src="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/227d8a88-377c-4bfe-ad80-969800129ce7/IMG_9797.jpg?format=1200w" alt="Children exploring together in the woods" width="1200" height="900" loading="lazy" /><div><DecorativeHeading eyebrow="Wayfinders Base Camp">Spark your child's connection to themselves, each other, and the earth.</DecorativeHeading><p>Wayfinders Base Camp ignites a love for nature and fosters social-emotional learning through weekly fire circles and nature games, leadership development, community building, and flexible scheduling for same-age and mixed-age groups.</p><ul><li>Deepen connections through engaging outdoor activities.</li><li>Build confidence, communication skills, and empathy.</li><li>Create lasting friendships and a sense of belonging.</li><li>Foster mentorship between younger and older participants.</li></ul><Button href="/fall-2026-base-camp-k-8">Discover Base Camp</Button></div></div>
  </Section>
  <Section tone="alternate"><div class="prose"><DecorativeHeading eyebrow="What is Wayfinders?">Disconnect from technology. Reconnect with what matters.</DecorativeHeading><p>We are living at a time when we are increasingly disconnected with ourselves, each other, and the earth. Wayfinders offers a solution: mindfulness, community building, and nature immersion.</p><p>Through social emotional learning and sustainability practices, Wayfinders provides experiential opportunities to build interconnectedness, leadership, and community in a fun and safe space.</p><div class="impact"><strong>Our work helps shape future sustainability advocates, address mental health challenges, and increase opportunities for diverse and underserved participants.</strong></div></div></Section>
  <Section width="wide"><DecorativeHeading eyebrow="Why Wayfinders?">Time and space to connect with purpose.</DecorativeHeading><p class="lead">After 30 years of combined experience, climate activist Gwen Merkin and school counselor Leah Gozhansky saw a clear need for young people to step away from the daily and reconnect.</p><div class="reason-grid">{reasons.map(([title, copy]) => <article><h2 class="type-card">{title}</h2><p>{copy}</p></article>)}</div></Section>
  <Section tone="forest"><div class="land"><DecorativeHeading eyebrow="Acknowledgment and responsibility">We recognize the enduring stewardship of the Lenape.</DecorativeHeading><p>The Wayfinders team recognizes that the land where we live, work and play exists within the territory of the Lenape. We acknowledge the Lenape for their enduring stewardship of this place throughout the centuries and still today. We recognize a responsibility to learn about this history while educating new generations about how to live in right relationship with the earth and all of her inhabitants.</p><p>Learning and relationship building is an ongoing pursuit and we welcome guidance and feedback as we endeavor to repair and restore this relationship.</p></div></Section>
  <Section><div class="closing"><DecorativeHeading eyebrow="Meet us outside">Share in the beauty of the natural world.</DecorativeHeading><Button href="/fall-2026-programs-overview">Explore our programs</Button></div></Section>
</BaseLayout>
<style>
  .actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .feature-grid { display: grid; grid-template-columns: minmax(0,.9fr) minmax(0,1.1fr); align-items: center; gap: var(--column-gap); }
  .feature-grid > img { width: 100%; height: clamp(24rem, 45vw, 38rem); object-fit: cover; border-radius: var(--radius-card); }
  .feature-grid p, .feature-grid li, .prose p, .lead, article p { color: var(--color-ink-muted); }
  .prose, .land, .closing { max-width: var(--width-prose); }
  .impact { margin-top: 2rem; padding: var(--card-padding); border-left: .35rem solid var(--color-rust); background: var(--color-surface); }
  .lead { max-width: 48rem; font-size: 1.1rem; }
  .reason-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 1rem; margin-top: 2.5rem; }
  article { padding: var(--card-padding); border: 1px solid var(--color-line); border-radius: var(--radius-card); background: var(--color-surface); }
  article h2 { margin: 0; } article p { margin-bottom: 0; }
  .land :global(.type-section), .land :global(.type-label) { color: var(--color-cream); }
  .closing { display: grid; gap: 2rem; justify-items: start; }
  @media (max-width: 47.999rem) { .feature-grid, .reason-grid { grid-template-columns: 1fr; } .actions :global(.button) { width: 100%; } }
</style>
