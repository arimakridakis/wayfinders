---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/global/Container.astro';
import Button from '../components/global/Button.astro';
import NatureIcon from '../components/global/NatureIcon.astro';

const registration = 'https://www.wayfindersonthehudson.com/internships-registration';
const pathways = [
  { icon: 'leaf', label: '6th & 8th graders', title: 'Mini Mentors', copy: 'Wayfinders who have participated for more than 2 seasons are eligible upon invitation.' },
  { icon: 'community', label: '9th & 10th graders', title: 'Junior Mentors', copy: 'Community Service Hrs.' },
  { icon: 'mountain', label: '11th & 12th graders', title: 'Mentors in Training', copy: 'Community service hrs or stipend.' },
] as const;
---
<BaseLayout title="Internships" description="Wayfinders leadership and mentoring opportunities for teens and young adults.">
  <section class="hero"><Container width="wide" class="hero-content"><p class="type-label">Wayfinders leadership opportunities</p><h1>Find your way <span>by supporting others.</span></h1><p class="hero-intro">Essential skills and character building to effectively mentor youth. Participants receive a Wayfinder’s Mentorship Certification.</p><div class="hero-actions"><Button href="/contact-us">Connect with us <span aria-hidden="true">→</span></Button></div></Container></section>
  <section class="pathways chapter"><Container width="wide"><header class="section-heading"><p class="type-label">Grow into leadership</p><h2>Choose your pathway.</h2><p>Mentoring opportunities for young people at every stage of their Wayfinders journey.</p></header><div class="pathway-grid">{pathways.map((pathway) => <article><span class="icon"><NatureIcon name={pathway.icon} size={39} /></span><p class="type-label">{pathway.label}</p><h3>{pathway.title}</h3><p>{pathway.copy}</p></article>)}</div><p class="prompt"><NatureIcon name="heart" size={27} />Send a one minute video or write up a quick blurb about why you’d be a great part of our leadership team!</p></Container></section>
  <section class="roles chapter"><Container width="wide" class="roles-grid"><div class="roles-intro"><p class="type-label">Step into the work</p><h2>Learn by walking alongside others.</h2><p class="handwritten">Mentoring helps us grow into the people our communities need.</p></div><div class="role-list"><article><p class="type-label">Junior Mentors</p><h3>$325 &amp; Community Service Hours Available</h3><p>If you’re in <strong>9th or 10th grade</strong>, join us as a Junior Mentor where you can support others on their nature connection and social emotional learning journey, while learning leadership skills in preparation to be a future mentor.</p><p>One-on-one feedback sessions will be coordinated with a Wayfinders staff member to provide an opportunity to reflect on growth throughout the internship. Weekly group processing and debrief sessions will be included. Letter of recommendation provided upon request. Certificate of completion will be provided for 25 hours of community service.</p><p>Program will take place on Tuesday or Wednesday afternoons at Lenoir Preserve from 3:15-6:15 pm. plus monthly individual check-ins.</p><Button href={registration}>Register on the current Wayfinders site <span aria-hidden="true">→</span></Button></article><article><p class="type-label">Mentors in Training</p><h3>Community service hours or a stipend.</h3><p>Positions are available for <strong>11th-12th graders</strong>, <strong>college students</strong>, and anyone interested in gaining valuable experience with nature connection. Mentors in Training participate in the Wayfinders Base Camp (after school) Program on Tuesday, Wednesdays, or Thursdays from 3:15-6:15 pm at Lenoir Preserve and individual monthly check-ins.</p><div class="actions"><Button href="https://docs.google.com/document/d/1pSHW7vBHj9fZoMjFQB7YO4gabcMLXcnw9TK5GgDTAZY/edit?usp=sharing" variant="secondary">Learn more in Google Docs</Button><Button href={registration}>Register on the current Wayfinders site <span aria-hidden="true">→</span></Button></div></article></div></Container></section>
  <section class="gallery chapter"><Container width="wide"><div class="gallery-grid"><img src="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/aa747602-9417-4b2c-8be1-11a38559cef7/IMG_9040.jpeg?format=1200w" alt="Wayfinders participants outdoors" width="800" height="650" loading="lazy" /><img src="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/14d7a5d9-a305-42dd-a5a5-aa983a8edff5/gabe+and+jack.jpg?format=1200w" alt="Two Wayfinders participants outdoors" width="800" height="650" loading="lazy" /><img src="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/2ac2f1e9-1212-4145-aa2b-4fdaaa64e2d4/29-Sabastian+Camo.jpg?format=1200w" alt="A Wayfinders participant outdoors" width="800" height="650" loading="lazy" /></div></Container></section>
  <section class="closing chapter"><Container width="wide" class="closing-grid"><div><p class="type-label">Support for every pathway</p><h2>Scholarships are available.</h2><p>Learn more about scholarship support for Wayfinders programs.</p></div><aside><Button href="/scholarships-1" variant="secondary">Learn more <span aria-hidden="true">→</span></Button></aside></Container></section>
</BaseLayout>
<style>
  .chapter{padding-block:clamp(5rem,10vw,9rem)}.hero{position:relative;display:grid;min-height:min(48rem,82vh);align-items:center;isolation:isolate;background:url('/images/heroes/internships-rebecca-instructions.jpg') center / cover no-repeat;color:white}.hero::after{position:absolute;z-index:-1;inset:0;content:'';background:linear-gradient(90deg,rgb(10 27 17 / .9),rgb(10 27 17 / .63) 48%,rgb(10 27 17 / .12) 80%)}:global(.hero-content){padding-block:5rem}.hero .type-label,.closing .type-label{color:#e3dda3}h1{max-width:53rem;margin:.5rem 0 1rem;color:white;font-family:var(--font-display);font-size:clamp(3.5rem,7vw,6.5rem);font-weight:500;letter-spacing:-.04em;line-height:.88}h1 span{display:block;margin:.18em 0 0 .1em;color:#d3c769;font-family:var(--font-hand);font-size:.62em;font-weight:500;letter-spacing:0;line-height:1}.hero-intro{max-width:37rem;font-size:clamp(1.15rem,2vw,1.45rem);line-height:1.55}.hero-actions{display:flex;gap:.75rem;margin-top:2rem}
  .pathways{background:linear-gradient(120deg,#fbf8f0,#f5f1e7)}.section-heading{max-width:50rem;margin:0 auto clamp(2.5rem,5vw,4rem);text-align:center}.section-heading .type-label,.roles .type-label{color:var(--color-moss)}.section-heading h2,.roles h2,.closing h2{margin:.3rem 0 .6rem;font-family:var(--font-display);font-size:clamp(2.7rem,5vw,4.5rem);font-weight:600;letter-spacing:-.025em;line-height:1}.section-heading>p:last-child{margin:0;font-size:1.15rem}.pathway-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(1rem,2vw,1.5rem)}.pathway-grid article{padding:clamp(1.5rem,3vw,2.25rem);border:1px solid rgb(49 88 67 / .12);border-radius:var(--radius-card);background:rgb(255 253 247 / .78);box-shadow:var(--shadow-soft)}.icon{display:grid;width:4.8rem;aspect-ratio:1;place-items:center;border-radius:50%;background:var(--color-page-alt);color:var(--color-moss)}.pathway-grid article:nth-child(2) .icon{background:#dce7e9;color:#406b7b}.pathway-grid article:nth-child(3) .icon{background:var(--color-cream);color:var(--color-earth)}.pathway-grid .type-label{margin:1.5rem 0 .45rem;color:var(--color-moss)}.pathway-grid h3{margin:0;color:var(--color-forest-dark);font-family:var(--font-display);font-size:clamp(1.65rem,3vw,2.25rem);line-height:1.05}.prompt{display:flex;align-items:center;justify-content:center;gap:.75rem;max-width:45rem;margin:2.5rem auto 0;text-align:center}.prompt :global(svg){flex:none;color:var(--color-rust)}
  .roles{background:#e8ebdf}.roles-grid{display:grid;grid-template-columns:.7fr 1.3fr;gap:clamp(3rem,7vw,7rem);align-items:start}.roles-intro{position:sticky;top:2rem}.roles-intro h2{font-size:clamp(3rem,5vw,4.75rem)}.handwritten{color:var(--color-earth);font-family:var(--font-hand);font-size:clamp(1.6rem,3vw,2.2rem);line-height:1.1}.role-list article{padding-block:2.25rem;border-top:1px solid rgb(49 88 67 / .22)}.role-list article:last-child{border-bottom:1px solid rgb(49 88 67 / .22)}.role-list h3{margin:.3rem 0 1rem;color:var(--color-forest-dark);font-family:var(--font-display);font-size:clamp(1.8rem,3vw,2.7rem);line-height:1.05}.actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:1.5rem}.gallery{background:var(--color-surface)}.gallery-grid{display:grid;grid-template-columns:1.2fr .8fr .8fr;gap:1rem}.gallery-grid img{width:100%;height:100%;min-height:20rem;object-fit:cover;border-radius:var(--radius-card)}.gallery-grid img:first-child{min-height:31rem}.closing{background:linear-gradient(90deg,rgb(13 35 23 / .94),rgb(13 35 23 / .75)),url('https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/1690238250129-GGSBV3VBHYM5EJFJBGZJ/image-asset.jpeg?format=1600w') center / cover;color:white}.closing-grid{display:grid;grid-template-columns:1.5fr .7fr;gap:clamp(3rem,7vw,6rem);align-items:center}.closing h2{color:white;font-size:clamp(3.5rem,7vw,6rem)}.closing aside{padding-left:clamp(2rem,5vw,4rem);border-left:1px solid rgb(255 255 255 / .5)}.closing aside :global(.button){border-color:white;color:white}
  @media(max-width:63.999rem){.pathway-grid{grid-template-columns:1fr}.roles-grid,.closing-grid{grid-template-columns:1fr}.roles-intro{position:static}.closing aside{padding:2rem 0 0;border-top:1px solid rgb(255 255 255 / .5);border-left:0}.gallery-grid{grid-template-columns:1fr 1fr}.gallery-grid img:first-child{grid-column:span 2}}@media(max-width:47.999rem){.hero{min-height:42rem;background-position:62% center}.hero::after{background:rgb(10 27 17 / .72)}h1{font-size:clamp(3.5rem,15vw,5.2rem)}.actions,.hero-actions{flex-direction:column}.actions :global(.button),.hero-actions :global(.button){width:100%}.gallery-grid{grid-template-columns:1fr}.gallery-grid img:first-child{grid-column:auto}}
  @media(min-width:48rem){.hero::after{background:linear-gradient(90deg,rgb(10 27 17 / .9) 0%,rgb(10 27 17 / 0) 75%)}}
</style>
