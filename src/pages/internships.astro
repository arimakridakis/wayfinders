---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/sections/PageHero.astro'; import Section from '../components/global/Section.astro'; import Button from '../components/global/Button.astro'; import CardGrid from '../components/sections/CardGrid.astro'; import InfoCard from '../components/sections/InfoCard.astro'; import ImageGallery from '../components/sections/ImageGallery.astro'; import CallToAction from '../components/sections/CallToAction.astro';
const registration='https://www.wayfindersonthehudson.com/internships-registration';
---
<BaseLayout title="Internships" description="Wayfinders leadership and mentoring opportunities for teens and young adults."><PageHero eyebrow="Wayfinders leadership opportunities" title="Find your way by supporting others on their journey." intro="Essential skills and character building to effectively mentor youth. Participants receive a Wayfinder’s Mentorship Certification." image="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/1690238250129-GGSBV3VBHYM5EJFJBGZJ/image-asset.jpeg?format=1200w" alt="Young Wayfinders leaders outdoors"><Button href="/contact-us">Connect with us</Button></PageHero>
<Section width="wide"><CardGrid columns={3}><InfoCard label="6th &amp; 8th Graders" heading="Mini Mentors" headingLevel="h2"><p>Wayfinders who have participated for more than 2 seasons are eligible upon invitation.</p></InfoCard><InfoCard label="9th &amp; 10th Graders" heading="Junior Mentors" headingLevel="h2"><p>Community Service Hrs.</p></InfoCard><InfoCard label="11th &amp; 12th Graders" heading="Mentor in Training" headingLevel="h2"><p>Community service hrs or stipend.</p></InfoCard></CardGrid><p class="prompt">Send a one minute video or write up a quick blurb about why you’d be a great part of our leadership team!</p></Section>
<Section tone="alternate" width="wide"><CardGrid columns={2}><InfoCard heading="Junior Mentors" headingLevel="h2"><p class="type-card">$325 &amp; Community Service Hours Available</p><p>If you’re in <strong>9th or 10th grade</strong>, join us as a Junior Mentor where you can support others on their nature connection and social emotional learning journey, while learning leadership skills in preparation to be a future mentor.</p><p>One-on-one feedback sessions will be coordinated with a Wayfinders staff member to provide an opportunity to reflect on growth throughout the internship. Weekly group processing and debrief sessions will be included. Letter of recommendation provided upon request. Certificate of completion will be provided for 25 hours of community service.</p><p>Program will take place on Tuesday or Wednesday afternoons at Lenoir Preserve from 3:15-6:15 pm. plus monthly individual check-ins.</p><Button slot="action" href={registration}>Register on the current Wayfinders site</Button></InfoCard><InfoCard heading="Mentors-in Training" headingLevel="h2"><p class="type-card">Participants are eligible for community service hours or a stipend.</p><p>Positions are available for <strong>11th-12th graders</strong>, <strong>college students</strong>, and anyone interested in gaining valuable experience with nature connection. Mentors in Training participate in the Wayfinders Base Camp (after school) Program on Tuesday, Wednesdays, or Thursdays from 3:15-6:15 pm at Lenoir Preserve and individual monthly check-ins.</p><div class="actions"><Button href="https://docs.google.com/document/d/1pSHW7vBHj9fZoMjFQB7YO4gabcMLXcnw9TK5GgDTAZY/edit?usp=sharing" variant="secondary">Learn more in Google Docs</Button><Button href={registration}>Register on the current Wayfinders site</Button></div></InfoCard></CardGrid></Section>
<Section width="wide"><ImageGallery><img src="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/aa747602-9417-4b2c-8be1-11a38559cef7/IMG_9040.jpeg?format=1200w" alt="Wayfinders participants outdoors" width="800" height="650" loading="lazy" /><img src="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/14d7a5d9-a305-42dd-a5a5-aa983a8edff5/gabe+and+jack.jpg?format=1200w" alt="Two Wayfinders participants outdoors" width="800" height="650" loading="lazy" /><img src="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/2ac2f1e9-1212-4145-aa2b-4fdaaa64e2d4/29-Sabastian+Camo.jpg?format=1200w" alt="A Wayfinders participant outdoors" width="800" height="650" loading="lazy" /><img src="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/4781c252-f9a6-4466-9518-7b8df256a202/43-Alice+Gwen+candle.jpg?format=1200w" alt="Wayfinders participants with a candle" width="800" height="650" loading="lazy" /></ImageGallery></Section>
<Section><CallToAction heading="Scholarships are available!"><Fragment slot="actions"><Button href="/scholarships-1">Learn more</Button></Fragment></CallToAction></Section></BaseLayout>
<style>:global(.page-hero .button){margin-top:2rem}.prompt{max-width:var(--width-prose);margin:2.5rem auto 0;font-family:var(--font-display);font-size:1.5rem;text-align:center}.actions{display:flex;flex-wrap:wrap;gap:.75rem}@media(max-width:47.999rem){.actions{display:grid}:global(.page-hero .button){width:100%}}</style>
