---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Section from '../components/global/Section.astro';
---
<BaseLayout title="Message from the Founders" description="Hear from Leah and Gwen about their mission.">
  <PageHero eyebrow="Wayfinders on the Hudson" title="A Message from the Founders" intro="Hear from Leah and Gwen about their mission!" image="/images/banners/alice-gwen-candle-b.jpg" />
  <Section width="wide">
    <div class="video-wrap"><video id="founders-video" controls preload="metadata" aria-label="A message from Wayfinders founders Leah and Gwen"><source src="https://video.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/83c7e413-f3c4-4094-9ad3-fd8ac4d8731d/playlist.m3u8" type="application/vnd.apple.mpegurl" />Your browser cannot play this video. The temporary source video remains available on the <a href="https://www.wayfindersonthehudson.com/message-from-founders">public founders’ page</a>.</video></div>
  </Section>
</BaseLayout>
<script>
  import Hls from 'hls.js';

  const video = document.querySelector<HTMLVideoElement>('#founders-video');
  const source = video?.querySelector('source')?.src;

  if (video && source && !video.canPlayType('application/vnd.apple.mpegurl') && Hls.isSupported()) {
    const hls = new Hls();
    hls.loadSource(source);
    hls.attachMedia(video);
  }
</script>
<style>
  .page-hero .intro { font-family: var(--font-hand); font-size: calc(clamp(1.15rem, 2vw, 1.45rem) + var(--font-hand-size-adjust) + 8px); line-height: 1.1; }
  .video-wrap { max-width: 60rem; margin-inline: auto; }
  .video-wrap video { display: block; width: 100%; aspect-ratio: 16 / 9; border-radius: var(--radius-card); background: var(--color-forest-dark); }
</style>
