---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/global/Container.astro';
import Button from '../components/global/Button.astro';
import NatureIcon from '../components/global/NatureIcon.astro';
import ProgramOption from '../components/cards/ProgramOption.astro';
import '../styles/family-program.css';
const registrations = { tuesday:'https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-3491a3ea4d11459cb6a7014442deaae641b67f5fdc414c32ba5ffdbdd16cb2f33972dc3d8e804dee8ee8ffe764f4203e?locale=EN_US&cta=saveandcopylink', wednesday:'https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-7139847b17e54ed0b550b720b5aeede5c7d74e600dd14c659696614adf3ec7a1f1bb04eb2b4c47ff91bd2208a1005cef?locale=EN_US&cta=saveandcopylink', single:'https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-812d9586d1144a5ca2950d13da687f51b49cec89075841d6a230646c5d73483ffdba793670504b35a146eac9cbaad708?locale=EN_US&cta=copylistmultilink' };
const image = 'https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/7b30b440-d9dc-4ec5-a267-ce184789e031/IMG_8866.jpeg?format=1200w';
---
<BaseLayout title="Motherhood Rising" description="A supportive nature-based circle for mothers with babies aged 6 weeks to 12 months.">
  <main class="family-program" style={`--closing-image:url('${image}')`}>
    <section class="hero" style={`background-image:url('${image}')`}><Container width="wide" class="hero-content"><p class="type-label">Tending the Roots</p><h1>Motherhood <span>Rising</span></h1><p class="hero-intro">Being a new mom is no joke, and without a village to support you, it’s harder than ever. So drop into Wayfinders Motherhood Rising: Tending the Roots, to find your place in a supportive community where you can be yourself, and be surrounded by other mothers who are going through it too!</p><p><strong>For new mothers</strong> · Babies aged 6 weeks to 12 months are welcome</p><a class="hero-note" href="#register"><NatureIcon name="heart" size={30} /><span>Root into support:<br /><strong>find your village</strong></span></a></Container></section>
    <section id="register" class="choices chapter"><Container width="wide"><header class="section-heading"><p class="type-label">Choose your gathering</p><h2>Find your circle</h2><p>Gather weekly at Lenoir Preserve in Yonkers, NY.</p></header><div class="option-grid" style="--option-count:3"><ProgramOption title="Tuesdays" label="10-session series" date="September 22–November 24" time="11:45 am–1 pm · $350" href={registrations.tuesday} program="Motherhood Rising — Tuesday series" icon="leaf" /><ProgramOption title="Wednesdays" label="10-session series" date="September 23–December 9 (skips November 11 and 25)" time="11:45 am–1 pm · $350" href={registrations.wednesday} program="Motherhood Rising — Wednesday series" icon="community" accent="blue" /><ProgramOption title="Single session" label="Join one gathering" date="Choose an available Tuesday or Wednesday" time="11:45 am–1 pm · $40" href={registrations.single} program="Motherhood Rising — Single session" icon="heart" accent="earth" /></div></Container></section>
    <section class="story chapter"><Container width="wide" class="story-grid"><div><p class="type-label">A circle for new mothers</p><h2>Honoring motherhood, honoring you.</h2><p>This circle is designed for new mothers (with babies aged 6 weeks to 12 months). Infants are welcome!</p><p>We will gather in nature to honor the journey of motherhood—as a significant transition to be marked, shared, and celebrated within community.</p><ul><li><NatureIcon name="community" size={25} /><span>Building a village and receiving care</span></li><li><NatureIcon name="heart" size={25} /><span>Food, rest, and warmth as medicine</span></li><li><NatureIcon name="leaf" size={25} /><span>Nourishing herbs and medicinal plants for mothers</span></li></ul><p class="handwritten">Come root into support and weave connections.</p></div><div class="story-image"><img src="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/95933549-62ba-461b-a6af-327f93917380/IMG_1780.jpg?format=1200w" alt="A mother and baby connecting outdoors" width="1200" height="900" loading="lazy" /></div></Container></section>
    <section class="experience chapter"><Container width="wide"><header class="section-heading"><p class="type-label">What we’ll explore together</p><h2>Care, wisdom, and connection</h2></header><div class="experience-grid"><article><NatureIcon name="heart" size={54} /><h3>Receive care</h3><p>Food, rest, and warmth as medicine.</p></article><article><NatureIcon name="community" size={54} /><h3>Community skill sharing</h3><p>Including baby wearing and nursing.</p></article><article><NatureIcon name="leaf" size={54} /><h3>Integration and Celebration</h3><p>Honoring Motherhood, Honoring You.</p></article></div></Container></section>
    <section class="details chapter"><Container width="wide"><div class="details-layout cohost-layout"><div class="cohost-image"><img src="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/e13de8df-ef96-407b-91de-800ae4713c6b/IMG_9364.jpeg?format=1200w" alt="Ardis Ruiz outdoors with a baby" width="1200" height="900" loading="lazy" /></div><div class="cohost-copy"><p class="type-label">Co-host</p><h2>Meet Ardis Ruiz</h2><p><strong>Co-Hosted by: Wayfinders on the Hudson, and Ardis Ruiz, MS INNATE Postpartum Care Certified Practitioner, and founder of <em>This Time, Nurtured to Thrive</em></strong></p><p>Ardis Ruiz is a mother, INNATE Postpartum Care Certified Practitioner, and founder of <em>This Time, Nurtured to Thrive</em>. Her calling grew from her own tender initiation into motherhood, where she felt the absence of the care and traditions once woven into the postpartum time.</p><p>Rooted in the physiological needs of this sacred time, Ardis honors the profound transformation that unfolds after birth. Her approach embraces the natural rhythms of healing, prioritizing rest, and nurturing both mothers and families with warmth and intention.</p></div></div></Container></section>
    <section class="closing chapter"><Container width="wide" class="closing-grid"><div><p class="type-label">Your village is waiting</p><h2>Come as you are.</h2><p>Share stories and weave connections with other mothers on this path.</p><div class="closing-actions"><Button registration={{ program: 'Motherhood Rising — Tuesday series', paymentUrl: registrations.tuesday }}>Tuesday series</Button><Button registration={{ program: 'Motherhood Rising — Wednesday series', paymentUrl: registrations.wednesday }}>Wednesday series</Button><Button registration={{ program: 'Motherhood Rising — Single session', paymentUrl: registrations.single }}>Single session</Button></div></div><aside><h3>Questions?</h3><p><a href="mailto:wayfindersonthehudson@gmail.com">wayfindersonthehudson@gmail.com</a><br />(917) 318-3888</p></aside></Container></section>
  </main>
</BaseLayout>

<style>
  .family-program .cohost-image { overflow:hidden; aspect-ratio:4/3; border-radius:var(--radius-card); box-shadow:var(--shadow-soft); }
  .family-program .cohost-image img { width:100%; height:100%; object-fit:cover; }
  .family-program .cohost-copy { min-width:0; }
</style>
