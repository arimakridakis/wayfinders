---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Section from '../components/global/Section.astro';
import Button from '../components/global/Button.astro';
const registrations = [
  ['Tuesday series','https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-3491a3ea4d11459cb6a7014442deaae641b67f5fdc414c32ba5ffdbdd16cb2f33972dc3d8e804dee8ee8ffe764f4203e?locale=EN_US&cta=saveandcopylink'],
  ['Wednesday series','https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-7139847b17e54ed0b550b720b5aeede5c7d74e600dd14c659696614adf3ec7a1f1bb04eb2b4c47ff91bd2208a1005cef?locale=EN_US&cta=saveandcopylink'],
  ['Single session','https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-812d9586d1144a5ca2950d13da687f51b49cec89075841d6a230646c5d73483ffdba793670504b35a146eac9cbaad708?locale=EN_US&cta=copylistmultilink'],
];
---
<BaseLayout title="Motherhood Rising" description="A supportive nature-based circle for mothers with babies aged 6 weeks to 12 months.">
  <PageHero eyebrow="Tending the Roots" title="Motherhood Rising" intro="Being a new mom is no joke, and without a village to support you, it’s harder than ever. So drop into Wayfinders Motherhood Rising: Tending the Roots, to find your place in a supportive community where you can be yourself, and be surrounded by other mothers who are going through it too!" image="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/7b30b440-d9dc-4ec5-a267-ce184789e031/IMG_8866.jpeg?format=1200w" alt="A mother and baby gathering outdoors with Wayfinders" />
  <Section width="wide"><div class="facts"><article><p class="type-label">Dates & times</p><h2 class="type-card">Tuesdays or Wednesdays</h2><p>Tuesdays 11:45-1PM: 9/22, 9/29, 10/6, 10/13, 10/20, 10/27, 11/3, 11/10, 11/17, 11/24<br /><br />Wednesdays 11:45-1PM: 9/23, 9/30, 10/7, 10/14, 10/21, 10/28, 11/4, (Skip 11/11), 11/18, (skip 11/25), 12/2, 12/9</p></article><article><p class="type-label">Cost</p><h2 class="type-card">Flexible registration</h2><p>$350 for 10 sessions<br />$40 for an individual session</p></article><article><p class="type-label">Where</p><h2 class="type-card">Lenoir Preserve</h2><p>Lenoir Preserve, Yonkers, NY</p></article></div><div class="register"><h2 class="type-section">Choose your gathering.</h2>{registrations.map(([label,href],i) => <Button {href} variant={i === 0 ? 'primary' : 'secondary'}>{label}</Button>)}</div></Section>
  <Section tone="alternate" width="wide"><div class="split"><div><p class="type-label">A circle for new mothers</p><h2 class="type-section">Honoring motherhood, honoring you.</h2><p>This circle is designed for new mothers (with babies aged 6 weeks to 12 months). Infants are welcome!</p><p>We will gather in nature to honor the journey of motherhood—as a significant transition to be marked, shared, and celebrated within community.</p><h3 class="type-card">Topics we’ll explore together</h3><ul><li>Building a village and receiving care</li><li>Food, rest, and warmth as medicine</li><li>Community skill sharing, including baby wearing and nursing</li><li>Nourishing herbs and medicinal plants for mothers</li><li>Integration and Celebration</li><li>Honoring Motherhood, Honoring You</li></ul><p>Come root into support, share stories, and weave connections with other mothers on this path.</p></div><img src="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/e13de8df-ef96-407b-91de-800ae4713c6b/IMG_9364.jpeg?format=1200w" alt="Mothers and babies connecting during a Wayfinders gathering" width="1200" height="900" loading="lazy" /></div></Section>
  <Section width="prose"><p class="type-label">Co-host</p><h2 class="type-section">Ardis Ruiz</h2><p><strong>Co-Hosted by: Wayfinders on the Hudson, and Ardis Ruiz, MS INNATE Postpartum Care Certified Practitioner, and founder of <em>This Time, Nurtured to Thrive</em></strong></p><p>Ardis Ruiz is a mother, INNATE Postpartum Care Certified Practitioner, and founder of <em>This Time, Nurtured to Thrive</em>. Her calling grew from her own tender initiation into motherhood, where she felt the absence of the care and traditions once woven into the postpartum time.</p><p>Rooted in the physiological needs of this sacred time, Ardis honors the profound transformation that unfolds after birth. Her approach embraces the natural rhythms of healing, prioritizing rest, and nurturing both mothers and families with warmth and intention.</p><p><a href="mailto:wayfindersonthehudson@gmail.com">wayfindersonthehudson@gmail.com</a><br />(917) 318-3888</p></Section>
</BaseLayout>
<style>.facts{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.facts article{padding:var(--card-padding);border:1px solid var(--color-line);border-radius:var(--radius-card);background:var(--color-surface)}.facts h2,.facts .type-label{margin:0}.facts p,.split p,.split li{color:var(--color-ink-muted)}.register{display:flex;align-items:center;flex-wrap:wrap;gap:.75rem;margin-top:2.5rem}.register h2{width:100%;margin:0 0 .75rem}.split{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:var(--column-gap)}.split h2{margin-top:.75rem}.split img{width:100%;height:34rem;object-fit:cover;border-radius:var(--radius-card)}@media(max-width:47.999rem){.facts,.split{grid-template-columns:1fr}.split img{height:20rem}.register :global(.button){width:100%}}</style>
