---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Section from '../components/global/Section.astro';
import ImagePlaceholder from '../components/sections/ImagePlaceholder.astro';
import MediaSplit from '../components/sections/MediaSplit.astro';
---
<BaseLayout title="Our Mission" description="Wayfinders fosters nature connection and social-emotional learning to develop future sustainability leaders.">
  <PageHero eyebrow="About Wayfinders" title="Our Mission" intro="Connecting people with themselves, each other, and the earth." />
  <Section width="wide">
    <MediaSplit imagePosition="right" align="start">
      <div slot="copy" class="mission"><p>The mission of Wayfinders is to foster experiential nature-connection and social emotional learning to develop future sustainability leaders, bolster mental and physical health, and provide equitable access to experiences in nature.</p><p>Our core values focus on disconnecting from technology to reconnect with nature. Through this cultural repair work, Wayfinders' strives to build stronger communities and next generation leaders who are connected to themselves, each other, and the earth.</p></div>
      <ImagePlaceholder slot="media" label="Wayfinders community connecting together in nature" aspect="4:3" note="Use an inclusive community image that supports the mission without competing with the statement." />
    </MediaSplit>
  </Section>
</BaseLayout>
<style>.mission { font-family: var(--font-display); font-size: clamp(1.5rem, 3vw, 2.25rem); line-height: 1.35; }.mission p:first-child { margin-top: 0; }.mission p:last-child { color: var(--color-forest); }</style>
