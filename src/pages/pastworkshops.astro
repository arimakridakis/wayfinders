---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Section from '../components/global/Section.astro';
import CardGrid from '../components/sections/CardGrid.astro';
import InfoCard from '../components/sections/InfoCard.astro';
import Callout from '../components/sections/Callout.astro';
import KeyDetails from '../components/sections/KeyDetails.astro';
import ImageStrip from '../components/sections/ImageStrip.astro';
const workshops = [
  {title:'Make a Bow & Arrow with Rebecca D’Elia',dates:'Tuesday, April 16th or Thursday, April 18th',description:'Join us to make the prehistoric tool that helped humankind survive - the bow and arrow. Walk through the forest to find the right tree branches, whittle your sticks, and string them for a fun tool. (*Bow and arrow made will be just for fun, not actual hunting!)',image:'https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/849d533b-d434-44d2-9043-d9e8a9a836fe/rebecca-d-elia.png'},
  {title:'Fire Building with Uri Sarig',dates:'Thursday, April 25th or Tuesday, April 30th',description:'Spend the afternoon with Uri trying out different fire building techniques including bow-drilling. Participants will make their own flint & steel fire by the end of the session!',image:'https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/5061a061-6cbb-4abe-938b-8aa3b8a49010/Uri.JPG'},
  {title:'Forest Yoga with Tori Cronk',dates:'Thursday, May 2 or Tuesday, May 7',description:'Meet us out in the meadow overlooking the Hudson River for some time moving our bodies to the rhythm of nature and finding out all the ways that we are just like trees, grasses, birds, deer, and so much more!',image:'https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/6d149bf3-c1be-4596-bdda-90f3fa06c69f/tori.JPG'},
  {title:'Playing with Pollinators with Julia Snook, Curator of Lenoir Preserve',dates:'Thursday, May 9th or Tuesday, May 14th',description:'Come play some buzzing games, and experience the life of the bees living at Lenoir Preserve. End the day with sweets provided by the bees! Check out Julia’s vast knowledge of pollination, and get ready to meet the bees (safely!) in person!',image:'https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/89b4d56b-c144-420a-87ce-d6dc38a9cd19/julia.JPG'},
  {title:'Recycled Mosaics with Susie Brubaker',dates:'2 session series · May 16th & May 23rd or May 21st & May 28th',description:'Turn trash into treasures with found objects headed toward the landfill! Susie is a master of crafting beautiful mosaics and your child will be part of leaving a legacy at Lenoir Preserve in the permanent art installation we will create together, with a nature connection message woven through the project!',image:'https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/4565aba9-05da-4564-b5f9-c77d2a3be04b/susie-square.png'},
  {title:'Foraging & Natural Navigation with Greg Rosen',dates:'Thursday, May 30 or Tuesday, June 4',description:'Learn to identify foods you can eat right in our backyards! Identify, prepare and eat some wild edibles around the campfire together!',image:'https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/60d82032-bffb-4896-b85a-0667066f591b/Greg.jpg'},
  {title:'Nature Photography with Kathy Lebron',dates:'Thursday, June 6 or Tuesday, June 11',description:'Creep quietly through the forest looking for movement, then stealthily ready, aim, and shoot some pics to capture the moment. Kathy is a seasoned and passionate nature photographer who will expose you to the tricks of the trade. We will create a nature photography art show to be displayed in the woods at our closing session and participants are invited with guests to enjoy!',image:'https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/78bb37ef-665f-4ec8-97d0-8e9f20592c48/Kathy.jpg'},
];
---
<BaseLayout title="Past Workshops" description="An historical record of Wayfinders Spring 2024 workshops.">
  <PageHero eyebrow="Historical program material" title="Spring Workshops!" intro="Make a Bow & Arrow · Nature Photography · Pollinators · Forest Yoga · Earth Art · Fire · Foraging" image="/images/banners/earth-altar.jpg" />
  <Section width="prose"><Callout><strong>Past program:</strong> This page records Spring 2024 workshops and is provided for historical reference. The dates, prices, and registration details below are not current opportunities.</Callout><figure class="workshop-banner"><img src="/images/banners/alberto-journal-field.jpg" alt="A Wayfinders participant writing outdoors" width="2154" height="1220" loading="lazy" /></figure><h2 class="type-section">Check out the *NEW* Wayfinders workshops!</h2><p>Let your child choose one or more of the following sessions, and help ensure that they spend quality time connecting with nature! This is the perfect chance to check out Wayfinders without committing to the full season.</p><p>Workshops take place at the Lenoir Preserve, 3:45 - 5:45 pm, and are open to participants in 2nd - 8th grades.</p><p>Register for one workshop for $60 or three for $150, or sign up for the full session (10 sessions plus Festival).</p><p><strong>SCHOLARSHIPS AVAILABLE!!</strong></p></Section>
  <Section tone="alternate" width="wide"><CardGrid columns={2}>{workshops.map(workshop => <InfoCard heading={workshop.title} headingLevel="h2"><img class="workshop-image" src={workshop.image} alt="" width="700" height="700" loading="lazy" /><p class="dates">{workshop.dates}</p><p>{workshop.description}</p></InfoCard>)}</CardGrid><ImageStrip label="Past workshop activities" images={[{ src:'/images/content/journaling-1.jpg', alt:'A Wayfinders participant writing and reflecting outdoors' },{ src:'/images/content/knife-1.jpg', alt:'A Wayfinders participant practicing outdoor skills' },{ src:'/images/content/tea-fire-1.jpg', alt:'Wayfinders community gathered for a shared fire ritual' }]} /></Section>
  <Section width="prose"><h2 class="type-section">Service Project & Family Festival</h2><h3 class="type-card">Join Wayfinders for a fun morning of service - planting pollinators, followed by lunch and the afternoon Spring Festival where you can experience the magic of Wayfinders for the day!</h3><KeyDetails heading="Festival details"><dt>Cost</dt><dd>Free for all past and present Wayfinders families; Open to the public for $20/family</dd><dt>Date and time</dt><dd>May 19th (rain date: June 2nd) · 10am - 3pm</dd><dt>Location</dt><dd>Lenoir Preserve</dd></KeyDetails><h2 class="type-section internships">Internships</h2><h3 class="type-card">We’re still seeking a few more fabulous high school students!</h3><p>Tuesdays and/or Thursdays · 3:45- 5:45 at Lenoir Preserve (meet at 3:15 to prep, leave at 6:15 after clean up) · Programs run from 4/9-6/18 · Weekly one-on-one mentoring provided to reflect & connect</p><p><strong>Junior Mentors:</strong> 9th-10th graders · Community service hours & scholarships available</p><p><strong>Mentors in Training:</strong> 11th-12th graders · Paid positions available</p></Section>
</BaseLayout>
<style>.dates{color:var(--color-rust);font-weight:750}.workshop-banner{margin:2rem 0}.workshop-banner img{display:block;width:100%;aspect-ratio:16/8;object-fit:cover;border-radius:var(--radius-card)}.workshop-image{width:100%;height:16rem;object-fit:cover;border-radius:calc(var(--radius-card) / 2);margin-bottom:1.25rem}.internships{margin-top:3rem}</style>
