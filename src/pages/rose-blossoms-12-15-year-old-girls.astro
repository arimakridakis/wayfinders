---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Section from '../components/global/Section.astro';
import Button from '../components/global/Button.astro';
const weekendUrl='https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-b05303556c5743c19b436e9f5ad980762e71deb9659042c2bf5204807802f8baf474ba1adf0c445d975b569ebcf28767?locale=EN_US&cta=copylistmultilink';
const journeyUrl='https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-47b764e180774183bd534e417aa1e1aa070a56dcdd244b5a917c4d59ebb0a3425157ebfa108d474e9572bca4e4c4c501?locale=EN_US&cta=copylistmultilink';
const seasons=[
  {name:'Fall camping weekend',date:'October 23–25, 2026',place:'Mountain Lakes Park',theme:'Diving deep into ourselves, our history, our community, our past.',copy:'Girls will sleep under the stars alongside mountain lakes, create an altar together, and dream into the girls they are becoming. Parents and caregivers will be invited to send their daughters off in ceremony and attend a parent-track session.',image:'https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/41660ced-5d4c-4055-ae72-b381d97a0621/Fall4.png?format=1200w'},
  {name:'Winter',date:'January 8–10, 2027',place:'Home in Westchester',theme:'Spa Queens—making, using, and gifting natural beauty products.',copy:'As the snow blankets the land, participants will cozy up indoors and learn more about themselves and their changing bodies through natural beauty care for themselves and others.',image:'https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/6f48ba24-7446-4023-8983-117ede6dbff8/Winter4.png?format=1200w'},
  {name:'Spring',date:'May 7–9, 2027',place:'Mountain Lakes or Upstate',theme:'Roses & Rivers—rose beads, paddle boarding, and river clean up.',copy:'The final weekend brings forward what the girls have learned as they authorize themselves to become who they are here to be. Parents and caregivers will witness a changing-woman ceremony.',image:'https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/bd4e4ecf-30bf-4b01-ab0f-1e83b75af219/Spring4.png?format=1200w'},
];
const practices=['Discover their own purpose and feeling of belonging.','Learn and sing songs to support intention and devotion.','Learn plants, foraging, and herbalism while strengthening connection to plant allies.','Participate in hands-on acts of earth stewardship.','Enjoy eco-spa experiences and natural beauty practices, products, and gifting.','Participate in a Grief Circle, Changing Woman Ceremony, Vision Quest, and Rite of Passage.','Work with emotions through guided reflection, ceremony, and solo time in nature.'];
---
<BaseLayout title="Rose Blossoms" description="A nature-based rite-of-passage and mentorship journey for young women ages 12–15.">
  <PageHero eyebrow="Ages 12–15" title="Rose Blossoms" intro="An invitation to young women to discover gratitude, emotional resilience, sacred sisterhood, intuitive knowing, and earth stewardship." image="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/2bbf295b-5643-478a-b43c-361ce10ddc8b/GwenHero5d.jpg?format=1200w" alt="Young women gathering together in nature"><div class="actions"><Button href={weekendUrl}>Reserve the fall weekend</Button><Button href={journeyUrl} variant="secondary">Join the full journey</Button></div></PageHero>
  <Section width="prose"><p class="intro-copy">Rose Blossoms is a nature-based rite-of-passage and mentorship program for adolescent girls. Through circle work, outdoor experiences, creative expression, stewardship projects, ritual, and community building, participants develop emotional resilience, deeper self-awareness, connection to the natural world, and supportive relationships with peers and mentors during the transition into young womanhood.</p><p>Rose Blossoms gathers seasonally during three weekends over the 2026–2027 school year, with family and community gatherings between each weekend. Parents and caregivers are supported along the path and given tools to uplift their girls as they step into this process.</p></Section>
  <Section tone="alternate" width="wide"><div class="pillars"><article><h2 class="type-card">Seasonal gatherings</h2><p>Three weekend journeys with connective gatherings between them to keep the circle strong.</p></article><article><h2 class="type-card">Community & circle</h2><p>Small-group connection, guided reflection, and supportive mentorship in a safe, welcoming space.</p></article><article><h2 class="type-card">Growth & stewardship</h2><p>Hands-on learning, rituals, and earth stewardship that nourish confidence, compassion, and leadership.</p></article><article><h2 class="type-card">Deep work, lasting impact</h2><p>Practices that help girls navigate change, trust their inner voice, and step into who they are becoming.</p></article></div></Section>
  <Section width="wide"><p class="type-label">Across the journey</p><h2 class="type-section">Rose Blossoms will</h2><div class="practice-grid">{practices.map((practice) => <p>{practice}</p>)}</div></Section>
  <Section tone="alternate" width="wide"><p class="type-label">2026–2027 journey</p><h2 class="type-section">Three seasons of connection and change.</h2><div class="seasons">{seasons.map((season) => <article><img src={season.image} alt="" width="800" height="650" loading="lazy" /><div><p class="type-label">{season.date}</p><h3 class="type-card">{season.name}</h3><p><strong>{season.place}</strong></p><p>{season.theme}</p><p>{season.copy}</p></div></article>)}</div><div class="connection"><h3 class="type-card">Connective gatherings</h3><p>Families gather Sunday, December 6 and Sunday, March 7 from 2:00–5:00 pm. Girls are also invited to share meaningful work with the greater Wayfinders community during final Base Camp family gatherings in December and June.</p></div></Section>
  <Section width="wide"><div class="details"><details open><summary>Roles for caregivers and community</summary><div><p>Caregivers receive a support track. Community members knowledgeable in relevant themes join the circles. Participants help plan themes, lead activities, and evaluate the program.</p></div></details><details><summary>Program structure and rhythm</summary><div><p>The group is designed for 12 participants with two trained adult facilitators experienced in youth development, non-violent communication, outdoor education, and girls’ rites of passage.</p><p>Gatherings move through a welcome circle, check-in, thematic exploration or skill practice, small-group project or reflection, and closing ritual.</p></div></details><details><summary>Themes, activities, and practices</summary><div><p>Themes include belonging, body and mind, relationships, place, action, leadership, and celebration. Activities include circle check-ins, journaling, cooking, foraging, herbalism, natural self-care, earth art, bead making, native planting, clean ups, gratitude, intention-setting, and closing songs.</p></div></details><details><summary>Safety, inclusion, and accessibility</summary><div><p>The program uses co-created behavioral agreements, consent culture, deep mentorship, individualized learning goals, sliding-scale fees or scholarships, and provided materials.</p></div></details><details><summary>Outcomes and sustaining community</summary><div><p>Intended outcomes include improved emotional regulation, stronger peer connections, increased nature engagement, demonstrated leadership, and sustainable practices. Reflections, caregiver feedback, facilitator observations, and simple ecological metrics support evaluation. Alumni circles and seasonal traditions help sustain the community.</p></div></details></div></Section>
  <Section tone="forest"><div class="final"><p class="type-label">Join the Rose Blossoms journey</p><h2 class="type-section">Deep work, enduring friendships.</h2><p>Three immersive weekend-long ceremonies and connective gatherings across the school year build self-awareness, confidence, resilience, leadership, and lifelong friendships.</p><p><strong>$550 per weekend or $1,450 for the full journey—a $200 savings.</strong> Payment plans and scholarships are available.</p><div class="actions"><Button href={weekendUrl} variant="secondary">Camping weekend</Button><Button href={journeyUrl}>Full journey</Button><Button href="/scholarships-1" variant="secondary">Scholarships</Button></div></div></Section>
</BaseLayout>
<style>.actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:2rem}.intro-copy{font-family:var(--font-display);font-size:clamp(1.4rem,2.5vw,2rem);line-height:1.4}.pillars{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}.pillars article,.practice-grid p{padding:var(--card-padding);border:1px solid var(--color-line);border-radius:var(--radius-card);background:var(--color-surface)}.pillars h2{margin:0}.pillars p,.practice-grid p,.seasons p,.connection p{color:var(--color-ink-muted)}.practice-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.seasons{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.seasons article{overflow:hidden;border:1px solid var(--color-line);border-radius:var(--radius-card);background:var(--color-surface)}.seasons img{width:100%;height:14rem;object-fit:cover}.seasons article>div{padding:var(--card-padding)}.seasons h3,.seasons .type-label{margin:0}.connection{max-width:var(--width-prose);margin:2rem auto 0;padding:var(--card-padding);border-radius:var(--radius-card);background:var(--color-cream)}.details{display:grid;gap:.75rem}.details details{border:1px solid var(--color-line);border-radius:var(--radius-card);background:var(--color-surface)}.details summary{cursor:pointer;padding:1.25rem;font-family:var(--font-display);font-size:1.35rem;font-weight:700}.details details div{padding:0 1.25rem 1.25rem;color:var(--color-ink-muted)}.final{max-width:var(--width-prose)}.final :global(.type-section),.final>.type-label{color:var(--color-cream)}.final .actions :global(.secondary){border-color:var(--color-cream);color:var(--color-cream)}@media(max-width:63.999rem){.pillars{grid-template-columns:repeat(2,1fr)}.seasons{grid-template-columns:1fr}.seasons article{display:grid;grid-template-columns:1fr 1fr}.practice-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:47.999rem){.pillars,.practice-grid{grid-template-columns:1fr}.seasons article{display:block}.actions :global(.button){width:100%}}</style>
