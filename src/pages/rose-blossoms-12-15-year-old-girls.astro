---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Section from '../components/global/Section.astro';
import Button from '../components/global/Button.astro';
const weekendUrl='https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-b05303556c5743c19b436e9f5ad980762e71deb9659042c2bf5204807802f8baf474ba1adf0c445d975b569ebcf28767?locale=EN_US&cta=copylistmultilink';
const journeyUrl='https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-47b764e180774183bd534e417aa1e1aa070a56dcdd244b5a917c4d59ebb0a3425157ebfa108d474e9572bca4e4c4c501?locale=EN_US&cta=copylistmultilink';
const seasons=[
  {name:'Fall camping weekend',date:'October 23–25, 2026',place:'Mountain Lakes Park',theme:'Diving deep into ourselves, our history, our community, our past.',copy:'Girls will leave this weekend knowing themselves, each other, and the land so much better than when they arrived. Girls will have an opportunity to create an altar together which will illuminate the path they are on, as they call in support from a larger community. We will sleep under the stars alongside mountain lakes, and dream into the girls they are becoming. Parents/caregivers will be invited to send their daughters off in ceremony as they cross the threshold and begin this work, and invited to stay for a parent track session while the girls are off on their own journey.',image:'https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/41660ced-5d4c-4055-ae72-b381d97a0621/Fall4.png?format=1200w'},
  {name:'Winter',date:'January 8–10, 2027',place:'Home in Westchester',theme:'Spa Queens—making, using, and gifting natural beauty products.',copy:'As the snow blankets the land, we will cozy up indoors and learn more about ourselves and our changing bodies. We will create and experience natural beauty care for ourselves and to gift to others on the journey.',image:'https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/6f48ba24-7446-4023-8983-117ede6dbff8/Winter4.png?format=1200w'},
  {name:'Spring',date:'May 7–9, 2027',place:'Mountain Lakes or Upstate',theme:'Roses & Rivers—rose beads, paddle boarding, and river clean up.',copy:'Our final weekend together will bring forward all we have learned and experienced together as the girls authorize themselves to become who they are here to be. We will participate in a changing woman ceremony for them to share reflections of each other. Parents and caregivers will be invited to witness the girls as they cross over the threshold again as changed women.',image:'https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/bd4e4ecf-30bf-4b01-ab0f-1e83b75af219/Spring4.png?format=1200w'},
];
const practices=['Discover their own purpose and feeling of belonging.','Learn and sing songs to support intention and devotion.','Practice receiving their own songs to share with their communities.','Learn plants, foraging, and herbalism while strengthening their connection to plant allies.','Participate in hands-on acts of earth stewardship.','Enjoy eco-spa experiences and natural beauty practices, products, and gifting.','Participate in a Grief Circle, Changing Woman Ceremony, Vision Quest, and Rite of Passage.','Work with emotions through guided reflection, ceremony, and solo time in nature.'];
const additionalImages = [
['dce5a068-69ed-4a85-9d86-645aaea21f8f/leaf3.png',''],['118092ff-5937-409c-99b0-c694e33451be/Love3.png',''],['ef82371d-4870-469f-ae4e-ed67ed62e6aa/Sun3.png',''],['6870c0b7-310d-45f4-91a3-6a21aa3aaf4c/Lotus3.png',''],['b2c3b18f-7b7d-4baa-8872-79c65cbad443/RoseBg2.jpg','Rose Blossoms artwork'],['9d95e6f3-695e-467e-a5b3-0e7e93bb55fa/RBBG5.png','Rose Blossoms program artwork'],['74945e75-5c87-4ff3-8b01-395ca98b9543/Hand3.png',''],['64205956-b926-4859-bc6f-7624ec172f04/Leaf4.png',''],['68bfd2f8-f491-4212-a8e8-ad661ca1cac8/Path4.png',''],['3df2c1a5-9ff4-44a5-8f53-ba217d71d290/RoseBg6.jpg','Rose Blossoms artwork'],['162da3a6-5e50-42b1-b7d5-d572a21e23e7/bryte+and+jude.jpg','Two young people outdoors'],
].map(([path,alt])=>({src:`https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/${path}?format=1200w`,alt}));
---
<BaseLayout title="Rose Blossoms" description="A nature-based rite-of-passage and mentorship journey for young women ages 12–15.">
  <PageHero eyebrow="Ages 12–15" title="Rose Blossoms" intro="An invitation to young women ages 12-15 to dive deeply into discovering gratitude, emotional resilience, sacred sisterhood, intuitive knowing, and Earth stewardship." image="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/2bbf295b-5643-478a-b43c-361ce10ddc8b/GwenHero5d.jpg?format=1200w" alt="Young women gathering together in nature"><div class="actions"><Button href={weekendUrl}>Reserve the fall weekend</Button><Button href={journeyUrl} variant="secondary">Join the full journey</Button></div></PageHero>
  <Section width="prose"><p><strong>Limited Spaces and Scholarships Available.</strong></p><p class="intro-copy">Rose Blossoms is a nature-based rite-of-passage and mentorship program for adolescent girls. Through circle work, outdoor experiences, creative expression, stewardship projects, ritual, and community building, participants develop emotional resilience, deeper self-awareness, connection to the natural world, and supportive relationships with peers and mentors during the transition into young womanhood.</p><p>Rose Blossoms will gather seasonally during three weekends over the 2026-2027 school year in order to provide spacious time for deepening connections with ourselves, each other, and the earth, and the Rose Blossoms themes.</p><p>Between each weekend gathering, a Sunday afternoon family gathering will be held to support the ongoing program and build community within the group. These gatherings will be held on Sunday afternoons from 2-5pm. December 6, March 7, and the girls will be invited for sacred sharing at our seasonal final Base Camp sessions with the greater Wayfinders community.</p><p>Parents and caregivers will be supported along the path and given tools to uplift their girls as they step into this process.</p></Section>
  <Section tone="alternate" width="wide"><div class="pillars"><article><h2 class="type-card">Seasonal gatherings</h2><p>Three weekend journeys across the 2026–2027 school year with connective gatherings in between to keep the circle strong.</p></article><article><h2 class="type-card">Community & circle</h2><p>Small group connection, guided reflection, and supportive mentorship in a safe, welcoming space.</p></article><article><h2 class="type-card">Growth & stewardship</h2><p>Hands-on learning, rituals, and Earth stewardship that nourish confidence, compassion, and leadership.</p></article><article><h2 class="type-card">Deep work, lasting impact</h2><p>Rituals and practices that empower girls to navigate change, trust their inner voice, and step into who they are becoming.</p></article></div></Section>
  <Section width="wide"><p class="type-label">Across the journey</p><h2 class="type-section">Rose Blossoms will</h2><div class="practice-grid">{practices.map((practice) => <p>{practice}</p>)}</div></Section>
  <Section tone="alternate" width="wide"><p class="type-label">2026–2027 journey</p><h2 class="type-section">Three seasons of connection and change.</h2><div class="seasons">{seasons.map((season) => <article><img src={season.image} alt="" width="800" height="650" loading="lazy" /><div><p class="type-label">{season.date}</p><h3 class="type-card">{season.name}</h3><p><strong>{season.place}</strong></p><p>{season.theme}</p><p>{season.copy}</p></div></article>)}</div><div class="connection"><h3 class="type-card">Connective offering</h3><p>A time for girls and their families to stay connected about the important changes underway.</p><ul><li>Sunday, December 6th, 2–5pm</li><li>Wednesday, December 9th, 3:45–5:45pm (girls only): a time for girls to present something meaningful underway as revealed during the Fall Ceremony—to be witnessed by our greater Wayfinders community (during final Fall Base Camp family gathering).</li><li>Sunday, March 7th, 2–5pm</li><li>Wednesday in June TBD: 3:45–5:45: a ceremony to honor the changes in the girls to be witnessed in our greater Wayfinders community (during final Spring Base Camp family gathering).</li></ul></div></Section>
  <Section width="wide"><div class="details">
    <details open><summary>Roles for Caregivers and Community</summary><div><ul><li>Caregivers support track provided for families.</li><li>Community members knowledgeable in relevant themes will join our circles.</li><li>Youth co-design: participants help plan themes, lead activities, and evaluate the program.</li></ul></div></details>
    <details><summary>Outcomes and Evaluations</summary><div><ul><li>Short-term: improved emotional regulation, stronger peer connections, increased nature engagement &amp; connection.</li><li>Medium-term: demonstrated leadership, reduced single-use waste and other sustainability practices.</li><li>Evaluation methods: participant reflections, caregiver feedback, facilitator observations, simple ecological metrics for projects.</li></ul></div></details>
    <details><summary>Sustaining the Community</summary><div><ul><li>Create alumni circles for older youth to mentor newer cohorts.</li><li>Document activities and outcomes to support funding and partnerships.</li><li>Maintain seasonal traditions to anchor ongoing identity and belonging.</li></ul></div></details>
    <details><summary>Rose Blossoms Program Structure</summary><div><ul><li>Sessions: 2 seasonal camping trips in fall and spring (Orientation/First Gathering in Fall and Closing/Rite of Passage in Spring), plus Wintertime weekend sleepover, plus connecting gatherings between each weekend journey to keep the changes flowing, and a Summertime expo for the Wayfinders Community to share the learning and growth from the journey.</li><li>Group size: 12 participants to balance intimacy and diversity of perspectives.</li><li>Facilitators: Two trained adults (one lead, one assistant/guide) with experience in youth development, non-violent communication, outdoor education, girls rite of passage.</li><li>Session Rhythm: welcome circle → check-in → thematic exploration and/or skill practice → small-group project or reflection → closing ritual.</li></ul></div></details>
    <details><summary>General Gathering Themes</summary><div><ul><li>Belonging — identity mapping, group agreements, trust-building activities.</li><li>Body &amp; Mind — mindfulness, healthy boundaries, stress tools, moon cycles and synching.</li><li>Relationships — active listening, conflict resolution, consent education, non-violent communication.</li><li>Place — nature walks/hikes, local ecology, seasonal cycles.</li><li>Action — low-waste swaps, service projects, planting, clean ups, gifting.</li><li>Leadership &amp; Celebration — project presentations, peer recognition, transition rituals.</li></ul></div></details>
    <details><summary>Activities &amp; Practices</summary><div><ul><li>Circle check-ins with emotion cards or journaling prompts.</li><li>Skill workshops: cooking, foraging, herbalism, self-care and beauty.</li><li>Creative projects: earth art, bead making &amp; mala necklaces.</li><li>Stewardship actions: native planting, clean ups.</li><li>Reflection rituals: gratitude stones, intention-setting, closing songs.</li></ul></div></details>
    <details><summary>Safety, Inclusion, and Accessibility</summary><div><ul><li>Co-created behavioral agreements and consent culture.</li><li>Deep mentorship and individualized learning goals.</li><li>Low-barrier participation: sliding-scale fees or scholarships; materials provided.</li></ul></div></details>
  </div></Section>
  <Section tone="alternate" width="wide"><div class="image-gallery">{additionalImages.map((image) => <img src={image.src} alt={image.alt} width="800" height="650" loading="lazy" />)}</div></Section>
  <Section tone="forest"><div class="final"><p class="type-label">Join the Rose Blossoms Journey</p><h2 class="type-section">Reserve your spot at our first camping weekend on October 23-25th or join for the Rose Blossoms Journey!</h2><p>Three immersive camping weekend-long ceremonies and short connective gatherings between the weekends (two Sunday afternoons) across the school year, designed to build self awareness &amp; confidence, resilience, leadership, and lifelong friendships through outdoor adventure and meaningful mentorship. Families are deeply encouraged to join for the full journey for maximum growth, and we understand that may not be the right fit for everyone, so we offer weekend options too.</p><p><strong>$550 per weekend or $1,450 for the full Journey (save $200). Payment plans and scholarships available.</strong></p><p><strong>Limited Spaces &amp; Scholarships Available!</strong></p><div class="actions"><Button href={weekendUrl} variant="secondary">Camping Weekend</Button><Button href={journeyUrl}>Rose Blossoms Journey</Button><Button href="/scholarships-1" variant="secondary">Scholarships</Button></div><h2 class="type-card">Scholarships Available.</h2><h2 class="type-card">Open to all!</h2><p><a href="mailto:wayfindersonthehudson@gmail.com">wayfindersonthehudson@gmail.com</a><br />(917) 318-3888</p></div></Section>
</BaseLayout>
<style>.actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:2rem}.intro-copy{font-family:var(--font-display);font-size:clamp(1.4rem,2.5vw,2rem);line-height:1.4}.pillars{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}.pillars article,.practice-grid p{padding:var(--card-padding);border:1px solid var(--color-line);border-radius:var(--radius-card);background:var(--color-surface)}.pillars h2{margin:0}.pillars p,.practice-grid p,.seasons p,.connection p{color:var(--color-ink-muted)}.practice-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.seasons{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.seasons article{overflow:hidden;border:1px solid var(--color-line);border-radius:var(--radius-card);background:var(--color-surface)}.seasons img{width:100%;height:14rem;object-fit:cover}.seasons article>div{padding:var(--card-padding)}.seasons h3,.seasons .type-label{margin:0}.connection{max-width:var(--width-prose);margin:2rem auto 0;padding:var(--card-padding);border-radius:var(--radius-card);background:var(--color-cream)}.details{display:grid;gap:.75rem}.details details{border:1px solid var(--color-line);border-radius:var(--radius-card);background:var(--color-surface)}.details summary{cursor:pointer;padding:1.25rem;font-family:var(--font-display);font-size:1.35rem;font-weight:700}.details details div{padding:0 1.25rem 1.25rem;color:var(--color-ink-muted)}.final{max-width:var(--width-prose)}.final :global(.type-section),.final>.type-label{color:var(--color-cream)}.final .actions :global(.secondary){border-color:var(--color-cream);color:var(--color-cream)}@media(max-width:63.999rem){.pillars{grid-template-columns:repeat(2,1fr)}.seasons{grid-template-columns:1fr}.seasons article{display:grid;grid-template-columns:1fr 1fr}.practice-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:47.999rem){.pillars,.practice-grid{grid-template-columns:1fr}.seasons article{display:block}.actions :global(.button){width:100%}}.image-gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.image-gallery img{width:100%;height:16rem;object-fit:contain;border-radius:var(--radius-card)}@media(max-width:47.999rem){.image-gallery{grid-template-columns:1fr}}
</style>
