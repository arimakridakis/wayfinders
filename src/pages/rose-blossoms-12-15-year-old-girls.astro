---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/global/Container.astro';
import Button from '../components/global/Button.astro';
import NatureIcon from '../components/global/NatureIcon.astro';
import DisclosureList from '../components/sections/DisclosureList.astro';
import ImageStrip from '../components/sections/ImageStrip.astro';

const weekendUrl = 'https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-b05303556c5743c19b436e9f5ad980762e71deb9659042c2bf5204807802f8baf474ba1adf0c445d975b569ebcf28767?locale=EN_US&cta=copylistmultilink';
const journeyUrl = 'https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-47b764e180774183bd534e417aa1e1aa070a56dcdd244b5a917c4d59ebb0a3425157ebfa108d474e9572bca4e4c4c501?locale=EN_US&cta=copylistmultilink';

const pillars = [
  { icon: 'leaf', title: 'Seasonal gatherings', text: 'Three weekend journeys across the 2026–2027 school year with connective gatherings in between to keep the circle strong.' },
  { icon: 'community', title: 'Community & circle', text: 'Small group connection, guided reflection, and supportive mentorship in a safe, welcoming space.' },
  { icon: 'feather', title: 'Growth & stewardship', text: 'Hands-on learning, rituals, and Earth stewardship that nourish confidence, compassion, and leadership.' },
  { icon: 'heart', title: 'Deep work, lasting impact', text: 'Rituals and practices that empower girls to navigate change, trust their inner voice, and step into who they are becoming.' },
] as const;

const practices = [
  'Discover their own purpose and feeling of belonging.',
  'Learn and sing songs to support intention and devotion.',
  'Practice receiving their own songs to share with their communities.',
  'Learn plants, foraging, and herbalism while strengthening their connection to plant allies.',
  'Participate in hands-on acts of earth stewardship.',
  'Enjoy eco-spa experiences and natural beauty practices, products, and gifting.',
  'Participate in a Grief Circle, Changing Woman Ceremony, Vision Quest, and Rite of Passage.',
  'Work with emotions through guided reflection, ceremony, and solo time in nature.',
];

const seasons = [
  { icon: 'leaf', name: 'Fall camping weekend', date: 'October 23–25, 2026', place: 'Mountain Lakes Park', theme: 'Diving deep into ourselves, our history, our community, our past.', copy: 'Girls will leave this weekend knowing themselves, each other, and the land so much better than when they arrived. Girls will have an opportunity to create an altar together which will illuminate the path they are on, as they call in support from a larger community. We will sleep under the stars alongside mountain lakes, and dream into the girls they are becoming. Parents/caregivers will be invited to send their daughters off in ceremony as they cross the threshold and begin this work, and invited to stay for a parent track session while the girls are off on their own journey.' },
  { icon: 'mountain', name: 'Winter', date: 'January 8–10, 2027', place: 'Home in Westchester', theme: 'Spa Queens—making, using, and gifting natural beauty products.', copy: 'As the snow blankets the land, we will cozy up indoors and learn more about ourselves and our changing bodies. We will create and experience natural beauty care for ourselves and to gift to others on the journey.' },
  { icon: 'feather', name: 'Spring', date: 'May 7–9, 2027', place: 'Mountain Lakes or Upstate', theme: 'Roses & Rivers—rose beads, paddle boarding, and river clean up.', copy: 'Our final weekend together will bring forward all we have learned and experienced together as the girls authorize themselves to become who they are here to be. We will participate in a changing woman ceremony for them to share reflections of each other. Parents and caregivers will be invited to witness the girls as they cross over the threshold again as changed women.' },
] as const;
---

<BaseLayout title="Rose Blossoms" description="A nature-based rite-of-passage and mentorship journey for young women ages 12–15.">
  <section class="hero hero--tall-mobile">
    <Container width="wide" class="hero-content">
      <p class="type-label">Ages 12–15 · 2026–2027</p>
      <h1>Rose <span>Blossoms</span></h1>
      <p class="hero-kicker">A rite of passage journey</p>
      <p class="hero-intro">An invitation to young women ages 12-15 to dive deeply into discovering gratitude, emotional resilience, sacred sisterhood, intuitive knowing, and Earth stewardship.</p>
      <div class="actions"><Button registration={{ program: 'Rose Blossoms — Camping weekend', paymentUrl: weekendUrl }}>Camping weekend</Button><Button registration={{ program: 'Rose Blossoms — Full journey', paymentUrl: journeyUrl }} variant="secondary">Rose Blossoms journey</Button></div>
    </Container>
  </section>

  <section class="introduction chapter">
    <Container width="standard">
      <p class="availability"><NatureIcon name="leaf" size={22} /><strong>Limited Spaces and Scholarships Available.</strong></p>
      <p class="intro-copy">Rose Blossoms is a nature-based rite-of-passage and mentorship program for adolescent girls. Through circle work, outdoor experiences, creative expression, stewardship projects, ritual, and community building, participants develop emotional resilience, deeper self-awareness, connection to the natural world, and supportive relationships with peers and mentors during the transition into young womanhood.</p>
      <div class="intro-columns"><p>Rose Blossoms will gather seasonally during three weekends over the 2026-2027 school year in order to provide spacious time for deepening connections with ourselves, each other, and the earth, and the Rose Blossoms themes.</p><div><p>Between each weekend gathering, a Sunday afternoon family gathering will be held to support the ongoing program and build community within the group. These gatherings will be held on Sunday afternoons from 2-5pm. December 6, March 7, and the girls will be invited for sacred sharing at our seasonal final Base Camp sessions with the greater Wayfinders community.</p><p class="handwritten">Parents and caregivers will be supported along the path and given tools to uplift their girls as they step into this process.</p></div></div>
    </Container>
  </section>

  <section class="pillars chapter"><Container width="wide"><div class="pillar-grid">{pillars.map((pillar) => <article><NatureIcon name={pillar.icon} size={42} /><h2>{pillar.title}</h2><p>{pillar.text}</p></article>)}</div></Container></section>

  <section class="practices">
    <div class="practice-copy chapter"><div><p class="type-label">Across the journey</p><h2>Rose Blossoms will</h2><ul>{practices.map((practice) => <li><NatureIcon name="leaf" size={19} /><span>{practice}</span></li>)}</ul></div></div>
    <div class="practice-image" role="img" aria-label="Wildflowers glowing in warm evening light"></div>
  </section>

  <section class="framework chapter"><Container width="wide"><header class="section-heading"><p class="type-label">Rooted in care and intention</p><h2>How the journey unfolds</h2></header><div class="framework-grid">
    <article><h3>Program structure</h3><ul><li><strong>Sessions:</strong> 2 seasonal camping trips in fall and spring (Orientation/First Gathering in Fall and Closing/Rite of Passage in Spring), plus Wintertime weekend sleepover, plus connecting gatherings between each weekend journey to keep the changes flowing, and a Summertime expo for the Wayfinders Community to share the learning and growth from the journey.</li><li><strong>Group size:</strong> 12 participants to balance intimacy and diversity of perspectives.</li><li><strong>Facilitators:</strong> Two trained adults (one lead, one assistant/guide) with experience in youth development, non-violent communication, outdoor education, girls rite of passage.</li><li><strong>Session Rhythm:</strong> welcome circle → check-in → thematic exploration and/or skill practice → small-group project or reflection → closing ritual.</li></ul></article>
    <article><h3>General themes</h3><ul class="theme-list"><li>Belonging</li><li>Body &amp; Mind</li><li>Relationships</li><li>Place</li><li>Action</li><li>Leadership &amp; Celebration</li></ul></article>
    <article><h3>Activities &amp; practices</h3><p>Circle work, nature connection, plant allies, journaling, creative expression, stewardship projects, grief circle, changing woman ceremony, vision quest, eco-spa crafting, and more.</p><p class="handwritten">Parents and caregivers will be supported along the path and given tools to uplift their girls as they step into this process.</p></article>
  </div></Container></section>

  <section class="journey chapter"><Container width="wide"><header class="section-heading"><p class="type-label">2026–2027 journey</p><h2>Three seasons of connection and change.</h2></header><div class="season-grid">{seasons.map((season) => <article><span class="season-icon"><NatureIcon name={season.icon} size={31} /></span><p class="type-label">{season.date}</p><h3>{season.name}</h3><p class="place">{season.place}</p><p><strong>{season.theme}</strong></p><p>{season.copy}</p></article>)}</div><ImageStrip label="Rose Blossoms moments of reflection and growth" images={[{ src:'/images/content/ani-on-wall.jpg', alt:'A young person outdoors in a moment of confidence and reflection' }, { src:'/images/content/dandelion-1.jpg', alt:'A young person enjoying a quiet moment in nature' }]} /><div class="connection"><p class="type-label">Connective offering</p><h3>A time for girls and their families to stay connected about the important changes underway.</h3><ul><li>Sunday, December 6th, 2–5pm</li><li>Wednesday, December 9th, 3:45–5:45pm (girls only): a time for girls to present something meaningful underway as revealed during the Fall Ceremony—to be witnessed by our greater Wayfinders community (during final Fall Base Camp family gathering).</li><li>Sunday, March 7th, 2–5pm</li><li>Wednesday in June TBD: 3:45–5:45: a ceremony to honor the changes in the girls to be witnessed in our greater Wayfinders community (during final Spring Base Camp family gathering).</li></ul></div></Container></section>

  <section class="details chapter"><Container width="wide"><div class="details-layout"><header><p class="type-label">A supported passage</p><h2>Program details</h2><p>Learn more about the care, community, and practices that shape Rose Blossoms.</p></header><DisclosureList>
    <details open><summary>Roles for Caregivers and Community</summary><div><ul><li>Caregivers support track provided for families.</li><li>Community members knowledgeable in relevant themes will join our circles.</li><li>Youth co-design: participants help plan themes, lead activities, and evaluate the program.</li></ul></div></details>
    <details><summary>Outcomes and Evaluations</summary><div><ul><li>Short-term: improved emotional regulation, stronger peer connections, increased nature engagement &amp; connection.</li><li>Medium-term: demonstrated leadership, reduced single-use waste and other sustainability practices.</li><li>Evaluation methods: participant reflections, caregiver feedback, facilitator observations, simple ecological metrics for projects.</li></ul></div></details>
    <details><summary>Sustaining the Community</summary><div><ul><li>Create alumni circles for older youth to mentor newer cohorts.</li><li>Document activities and outcomes to support funding and partnerships.</li><li>Maintain seasonal traditions to anchor ongoing identity and belonging.</li></ul></div></details>
    <details><summary>General Gathering Themes</summary><div><ul><li>Belonging — identity mapping, group agreements, trust-building activities.</li><li>Body &amp; Mind — mindfulness, healthy boundaries, stress tools, moon cycles and synching.</li><li>Relationships — active listening, conflict resolution, consent education, non-violent communication.</li><li>Place — nature walks/hikes, local ecology, seasonal cycles.</li><li>Action — low-waste swaps, service projects, planting, clean ups, gifting.</li><li>Leadership &amp; Celebration — project presentations, peer recognition, transition rituals.</li></ul></div></details>
    <details><summary>Activities &amp; Practices</summary><div><ul><li>Circle check-ins with emotion cards or journaling prompts.</li><li>Skill workshops: cooking, foraging, herbalism, self-care and beauty.</li><li>Creative projects: earth art, bead making &amp; mala necklaces.</li><li>Stewardship actions: native planting, clean ups.</li><li>Reflection rituals: gratitude stones, intention-setting, closing songs.</li></ul></div></details>
    <details><summary>Safety, Inclusion, and Accessibility</summary><div><ul><li>Co-created behavioral agreements and consent culture.</li><li>Deep mentorship and individualized learning goals.</li><li>Low-barrier participation: sliding-scale fees or scholarships; materials provided.</li></ul></div></details>
  </DisclosureList></div></Container></section>

  <section class="closing chapter"><Container width="wide" class="closing-grid"><div><p class="type-label">Join the Rose Blossoms Journey</p><h2>Step into the circle.</h2><p>Reserve your spot at our first camping weekend on October 23-25th or join for the Rose Blossoms Journey!</p><p>Three immersive camping weekend-long ceremonies and short connective gatherings between the weekends (two Sunday afternoons) across the school year, designed to build self awareness &amp; confidence, resilience, leadership, and lifelong friendships through outdoor adventure and meaningful mentorship. Families are deeply encouraged to join for the full journey for maximum growth, and we understand that may not be the right fit for everyone, so we offer weekend options too.</p><p><strong>$550 per weekend or $1,450 for the full Journey (save $200). Payment plans and scholarships available.</strong></p><div class="actions"><Button registration={{ program: 'Rose Blossoms — Camping weekend', paymentUrl: weekendUrl }}>Camping weekend</Button><Button registration={{ program: 'Rose Blossoms — Full journey', paymentUrl: journeyUrl }}>Full journey</Button><Button href="/scholarships-1" variant="secondary">Scholarships</Button></div></div><aside><NatureIcon name="heart" size={38} /><h3>Limited Spaces &amp; Scholarships Available!</h3><p><strong>Scholarships Available.<br />Open to all!</strong></p><p><a href="mailto:wayfindersonthehudson@gmail.com">wayfindersonthehudson@gmail.com</a><br />(917) 318-3888</p></aside></Container></section>
</BaseLayout>

<style>
  .chapter{padding-block:clamp(5.5rem,10vw,9rem)}.actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:2rem}
  .hero{position:relative;display:grid;min-height:min(48rem,82vh);align-items:center;isolation:isolate;background:url('/images/banners/gwen-candle-banner.jpg') 68% center/cover no-repeat;color:white}.hero::after{position:absolute;z-index:-1;inset:0;content:'';background:linear-gradient(90deg,rgb(26 31 18/.9) 0%,rgb(30 35 21/.68) 45%,rgb(30 35 21/.08) 76%)}:global(.hero-content){padding-block:5rem}.hero .type-label{color:#e6d9b4}.hero h1{max-width:38rem;margin:.35rem 0;color:white;font-family:var(--font-display);font-size:calc(clamp(4.5rem,9vw,7.6rem) + var(--font-display-size-adjust));font-weight:500;letter-spacing:-.045em;line-height:.73}.hero h1 span{display:block;margin-left:.28em;color:#d8b5a2;font-family:var(--font-hand);font-size:.72em;letter-spacing:0;line-height:1}.hero-kicker{margin:1.5rem 0 .75rem;font-size:.78rem;font-weight:700;letter-spacing:.25em;text-transform:uppercase}.hero-intro{max-width:36rem;font-size:clamp(1.05rem,2vw,1.28rem);line-height:1.6}.hero .actions :global(.secondary){border-color:white;color:white}
  .introduction{position:relative;background:#faf7ef;text-align:center}.availability{display:flex;justify-content:center;align-items:center;gap:.6rem;margin:0 0 2rem;color:var(--color-moss)}.intro-copy{max-width:58rem;margin:0 auto;font-family:var(--font-display);font-size:calc(clamp(1.55rem,3vw,2.25rem) + var(--font-display-size-adjust));line-height:1.35}.intro-columns{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,6vw,6rem);margin-top:3.5rem;text-align:left}.intro-columns p{margin-top:0}.handwritten{color:var(--color-rust);font-family:var(--font-hand);font-size:clamp(1.45rem,2.5vw,2rem);line-height:1.25}
  .pillars{background:var(--color-surface)}.pillar-grid{display:grid;grid-template-columns:repeat(4,1fr)}.pillar-grid article{padding:clamp(1rem,3vw,2.2rem);border-right:1px solid var(--color-line);text-align:center}.pillar-grid article:last-child{border:0}.pillar-grid :global(svg){margin:0 auto 1.2rem;color:var(--color-moss)}.pillar-grid article:nth-child(2n) :global(svg){color:var(--color-earth)}.pillar-grid h2{margin:0;font-family:var(--font-display);font-size:calc(clamp(1.45rem,2.5vw,1.8rem) + var(--font-display-size-adjust));line-height:1.1}.pillar-grid p{font-size:.95rem}
  .practices{display:grid;grid-template-columns:1fr 1fr;min-height:45rem}.practice-copy{display:grid;place-items:center;padding-inline:var(--gutter);background:#f3eee2}.practice-copy>div{max-width:38rem}.practice-copy h2,.section-heading h2,.details h2,.closing h2{margin:.3rem 0 1.5rem;font-family:var(--font-display);font-size:calc(clamp(3rem,5vw,4.7rem) + var(--font-display-size-adjust));font-weight:600;letter-spacing:-.03em;line-height:.95}.practice-copy ul{display:grid;gap:.7rem;padding:0;list-style:none}.practice-copy li{display:flex;gap:.75rem;align-items:flex-start}.practice-copy li :global(svg){flex:none;margin-top:.25rem;color:var(--color-earth)}.practice-image{min-height:35rem;background:linear-gradient(rgb(40 37 20/.08),rgb(40 37 20/.08)),url('/images/content/ani-on-wall.jpg') center/cover no-repeat}
  .framework{background:#fbf8f1}.section-heading{max-width:55rem;margin:0 auto clamp(3rem,6vw,5rem);text-align:center}.section-heading .type-label,.details .type-label{color:var(--color-moss)}.framework-grid{display:grid;grid-template-columns:1.15fr .65fr 1fr;gap:clamp(2rem,4vw,4rem)}.framework-grid article{padding-right:clamp(1rem,3vw,3rem);border-right:1px solid var(--color-line)}.framework-grid article:last-child{padding:0;border:0}.framework-grid h3,.connection h3,.closing h3{margin:0 0 1rem;font-family:var(--font-display);font-size:calc(clamp(1.8rem,3vw,2.35rem) + var(--font-display-size-adjust));line-height:1.1}.framework-grid ul{padding-left:1.2rem}.framework-grid li{margin-bottom:.65rem}.theme-list{list-style:'✦  '}.theme-list li{padding-left:.4rem}
  .journey{background:#e8e6dc}.season-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem}.season-grid article{position:relative;padding:clamp(2rem,4vw,3rem);border-radius:var(--radius-card);background:var(--color-surface);box-shadow:var(--shadow-soft)}.season-icon{display:grid;width:3.5rem;aspect-ratio:1;margin-bottom:1.5rem;place-items:center;border-radius:50%;background:var(--color-moss);color:white}.season-grid article:nth-child(2) .season-icon{background:#557985}.season-grid article:nth-child(3) .season-icon{background:#b87842}.season-grid h3{margin:.2rem 0;font-family:var(--font-display);font-size:calc(2rem + var(--font-display-size-adjust));line-height:1}.season-grid .type-label{color:var(--color-moss)}.place{margin-top:.6rem;color:var(--color-earth);font-weight:700}.connection{max-width:62rem;margin:2rem auto 0;padding:clamp(2rem,5vw,3.5rem);border-radius:var(--radius-card);background:#f1e7dc}.connection .type-label{color:var(--color-earth)}
  .details{background:#faf7ef}.details-layout{display:grid;grid-template-columns:.7fr 1.3fr;gap:clamp(3rem,7vw,7rem)}.details header{position:sticky;top:2rem;align-self:start}.details header p:last-child{font-size:1.1rem}
  .closing{background:linear-gradient(90deg,rgb(24 49 34/.96),rgb(24 49 34/.78)),url('/images/content/dandelion-1.jpg') center/cover;color:white}:global(.closing-grid){display:grid;grid-template-columns:1.5fr .65fr;gap:clamp(3rem,7vw,6rem);align-items:center}.closing h2{color:white;font-size:calc(clamp(3.8rem,7vw,6.3rem) + var(--font-display-size-adjust))}.closing .type-label,.closing aside :global(svg){color:#e3dda3}.closing p{max-width:48rem}.closing .actions :global(.button){border-color:white;background:white;color:var(--color-forest-dark)}.closing .actions :global(.secondary){background:transparent;color:white}.closing aside{padding-left:clamp(2rem,5vw,4rem);border-left:1px solid rgb(255 255 255/.45)}.closing aside a{color:white}
  @media(max-width:63.999rem){.pillar-grid{grid-template-columns:repeat(2,1fr);gap:2.5rem 0}.pillar-grid article:nth-child(2){border:0}.practices{grid-template-columns:1fr}.practice-image{min-height:32rem}.framework-grid{grid-template-columns:1fr 1fr}.framework-grid article:nth-child(2){padding:0;border:0}.framework-grid article:last-child{grid-column:1/-1;padding-top:2rem;border-top:1px solid var(--color-line)}.season-grid{grid-template-columns:1fr}.details-layout{grid-template-columns:1fr}.details header{position:static}}
  @media(max-width:47.999rem){.hero{min-height:44rem;background-position:64% center}.hero::after{background:rgb(24 35 24/.66)}.hero h1{font-size:calc(clamp(4.2rem,20vw,6rem) + var(--font-display-size-adjust))}.hero .actions,.closing .actions{flex-direction:column}.hero .actions :global(.button),.closing .actions :global(.button){width:100%}.intro-columns{grid-template-columns:1fr}.pillar-grid{grid-template-columns:1fr}.pillar-grid article,.pillar-grid article:nth-child(2){padding-block:2rem;border-right:0;border-bottom:1px solid var(--color-line)}.framework-grid{grid-template-columns:1fr}.framework-grid article,.framework-grid article:nth-child(2),.framework-grid article:last-child{grid-column:auto;padding:0 0 2rem;border:0;border-bottom:1px solid var(--color-line)}:global(.closing-grid){grid-template-columns:1fr}.closing aside{padding:2rem 0 0;border-top:1px solid rgb(255 255 255/.45);border-left:0}}
</style>
