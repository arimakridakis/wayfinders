---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/global/Container.astro';
import Button from '../components/global/Button.astro';
import NatureIcon from '../components/global/NatureIcon.astro';
import DisclosureList from '../components/sections/DisclosureList.astro';
import ImageStrip from '../components/sections/ImageStrip.astro';

const weekendUrl = 'https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-b05303556c5743c19b436e9f5ad980762e71deb9659042c2bf5204807802f8baf474ba1adf0c445d975b569ebcf28767?locale=EN_US&cta=copylistmultilink';
const journeyUrl = 'https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-47b764e180774183bd534e417aa1e1aa070a56dcdd244b5a917c4d59ebb0a3425157ebfa108d474e9572bca4e4c4c501?locale=EN_US&cta=copylistmultilink';

const practices = [
  'Build friendships and explore identity and belonging.',
  'Express themselves through songs, journaling, and creative projects.',
  'Learn foraging, herbalism, and Earth stewardship.',
  'Explore self-care through natural beauty and eco-spa activities.',
  'Reflect through nature time, a Grief Circle, Changing Woman Ceremony, Vision Quest, and Rite of Passage.',
];

const seasons = [
  { icon: 'leaf', name: 'Fall camping weekend', date: 'October 23–25, 2026', place: 'Mountain Lakes Park', copy: 'Camp beneath the stars, build connections, and create a shared altar. Parents and caregivers join the opening ceremony and a dedicated parent session.' },
  { icon: 'mountain', name: 'Winter', date: 'January 8–10, 2027', place: 'Home in Westchester', copy: 'A cozy indoor weekend exploring our changing bodies and making natural self-care products to use and give.' },
  { icon: 'feather', name: 'Spring', date: 'May 7–9, 2027', place: 'Mountain Lakes or Upstate', copy: 'Make rose beads, paddleboard, and help clean up the river. Close the journey with a Changing Woman Ceremony, with parents and caregivers invited to witness and celebrate.' },
] as const;
---

<BaseLayout title="Rose Blossoms" description="A nature-based rite-of-passage and mentorship journey for young women ages 12–15.">
  <section class="hero hero--tall-mobile">
    <Container width="wide" class="hero-content">
      <p class="type-label">Ages 12–15 · 2026–2027</p>
      <h1>Rose <span>Blossoms</span></h1>
      <p class="hero-kicker">A rite of passage journey</p>
      <p class="hero-intro">A nature-based coming-of-age journey for girls ages 12–15. Build confidence, friendship, and emotional resilience through outdoor adventure, creative expression, and meaningful ceremony.</p>
      <div class="actions"><Button registration={{ program: 'Rose Blossoms — Camping weekend', paymentUrl: weekendUrl }}>Camping weekend</Button><Button registration={{ program: 'Rose Blossoms — Full journey', paymentUrl: journeyUrl }} variant="secondary">Rose Blossoms journey</Button></div>
    </Container>
  </section>

  <section class="introduction chapter">
    <Container width="standard">
      <p class="availability"><NatureIcon name="leaf" size={22} /><strong>Limited Spaces and Scholarships Available.</strong></p>
      <p class="intro-copy">Gather for three seasonal weekends throughout the 2026–2027 school year, with family gatherings in between. A small group of 12 girls, supported by two experienced facilitators, explores connection to themselves, each other, and the Earth. Parents and caregivers receive support along the way.</p>
    </Container>
  </section>

  <section class="practices">
    <div class="practice-copy chapter"><div><p class="type-label">Across the journey</p><h2>Rose Blossoms will</h2><ul>{practices.map((practice) => <li><NatureIcon name="leaf" size={19} /><span>{practice}</span></li>)}</ul></div></div>
    <div class="practice-image" role="img" aria-label="Wildflowers glowing in warm evening light"></div>
  </section>

  <section class="journey chapter"><Container width="wide"><header class="section-heading"><p class="type-label">2026–2027 journey</p><h2>Three seasonal weekends</h2></header><div class="season-grid">{seasons.map((season) => <article><span class="season-icon"><NatureIcon name={season.icon} size={31} /></span><p class="type-label">{season.date}</p><h3>{season.name}</h3><p class="place">{season.place}</p><p>{season.copy}</p></article>)}</div><ImageStrip label="Rose Blossoms moments of reflection and growth" images={[{ src:'/images/content/fire-circle-3.jpg', alt:'Wayfinders participants gathered around a fire outdoors' }, { src:'/images/content/tea-fire-1.jpg', alt:'Wayfinders participants sharing a fireside moment together' }]} /><div class="connection"><p class="type-label">Between weekends</p><h3>Family &amp; community gatherings</h3><ul><li>Sunday, December 6th, 2–5pm: family gathering</li><li>Wednesday, December 9th, 3:45–5:45pm (girls only): Girls share with the wider Wayfinders community at the final Fall Base Camp family gathering.</li><li>Sunday, March 7th, 2–5pm: family gathering</li><li>Wednesday in June TBD: 3:45–5:45: Closing community ceremony at the final Spring Base Camp family gathering.</li></ul></div></Container></section>

  <section class="details chapter"><Container width="wide"><div class="details-layout"><header><p class="type-label">A supported passage</p><h2>Program details</h2><p>Learn more about the care, community, and practices that shape Rose Blossoms.</p></header><DisclosureList>
    <details open><summary>Family &amp; community involvement</summary><div><p>Caregivers receive a dedicated support track. Community guests join our circles, and girls help shape themes and lead activities.</p></div></details>
    <details><summary>Experienced facilitators</summary><div><p>Two trained adults—a lead and an assistant/guide—bring experience in youth development, non-violent communication, outdoor education, and girls’ rites of passage.</p></div></details>
    <details><summary>Safety, inclusion &amp; accessibility</summary><div><p>Shared group agreements, consent, and individualized mentorship support participation. Materials are provided, with sliding-scale fees or scholarships available.</p></div></details>
  </DisclosureList></div></Container></section>

  <section class="closing chapter"><Container width="wide" class="closing-grid"><div><p class="type-label">Join the Rose Blossoms Journey</p><h2>Step into the circle.</h2><p>Join the full Rose Blossoms journey or choose a weekend.</p><p><strong>$550 per weekend · $1,450 for the full journey — save $200</strong></p><p>Payment plans and scholarships available.</p><div class="actions"><Button registration={{ program: 'Rose Blossoms — Camping weekend', paymentUrl: weekendUrl }}>Camping weekend</Button><Button registration={{ program: 'Rose Blossoms — Full journey', paymentUrl: journeyUrl }}>Full journey</Button><Button href="/scholarships-1" variant="secondary">Scholarships</Button></div></div><aside><NatureIcon name="heart" size={38} /><h3>Limited Spaces &amp; Scholarships Available!</h3><p><a href="mailto:wayfindersonthehudson@gmail.com">wayfindersonthehudson@gmail.com</a><br />(917) 318-3888</p></aside></Container></section>
</BaseLayout>

<style>
  .chapter{padding-block:clamp(5.5rem,10vw,9rem)}.actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:2rem}
  .hero{position:relative;display:grid;min-height:min(48rem,82vh);align-items:center;isolation:isolate;background:url('/images/banners/gwen-candle-banner.jpg') 68% center/cover no-repeat;color:white}.hero::after{position:absolute;z-index:-1;inset:0;content:'';background:linear-gradient(90deg,rgb(26 31 18/.9) 0%,rgb(30 35 21/.68) 45%,rgb(30 35 21/.08) 76%)}:global(.hero-content){padding-block:5rem}.hero .type-label{color:#e6d9b4}.hero h1{max-width:38rem;margin:.35rem 0;color:white;font-family:var(--font-display);font-size:calc(clamp(4.5rem,9vw,7.6rem) + var(--font-display-size-adjust) + var(--font-display-hero-size-adjust));font-weight:500;letter-spacing:-.045em;line-height:.73}.hero h1 span{display:block;margin-left:.28em;color:#d8b5a2;font-family:var(--font-hand);font-size:calc(.72em + var(--font-hand-size-adjust));letter-spacing:0;line-height:1}.hero-kicker{margin:1.5rem 0 .75rem;font-size:.78rem;font-weight:700;letter-spacing:.25em;text-transform:uppercase}.hero-intro{max-width:36rem;font-size:clamp(1.05rem,2vw,1.28rem);line-height:1.6}.hero .actions :global(.secondary){border-color:white;color:white}
  .introduction{position:relative;background:#faf7ef;text-align:center}.availability{display:flex;justify-content:center;align-items:center;gap:.6rem;margin:0 0 2rem;color:var(--color-moss)}.intro-copy{max-width:58rem;margin:0 auto;font-family:var(--font-display);font-size:calc(clamp(1.55rem,3vw,2.25rem) + var(--font-display-size-adjust));line-height:1.35}.intro-columns{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,6vw,6rem);margin-top:3.5rem;text-align:left}.intro-columns p{margin-top:0}.handwritten{color:var(--color-rust);font-family:var(--font-hand);font-size:calc(clamp(1.45rem,2.5vw,2rem) + var(--font-hand-size-adjust));line-height:1.25}
  .pillars{background:var(--color-surface)}.pillar-grid{display:grid;grid-template-columns:repeat(4,1fr)}.pillar-grid article{padding:clamp(1rem,3vw,2.2rem);border-right:1px solid var(--color-line);text-align:center}.pillar-grid article:last-child{border:0}.pillar-grid :global(svg){margin:0 auto 1.2rem;color:var(--color-moss)}.pillar-grid article:nth-child(2n) :global(svg){color:var(--color-earth)}.pillar-grid h2{margin:0 0 25px;font-family:var(--font-display);font-size:calc(clamp(1.45rem,2.5vw,1.8rem) + var(--font-display-size-adjust));line-height:1.1}.pillar-grid p{font-size:.95rem}
  .practices{display:grid;grid-template-columns:1fr 1fr;min-height:45rem}.practice-copy{display:grid;place-items:center;padding-inline:var(--gutter);background:#f3eee2}.practice-copy>div{max-width:38rem}.practice-copy h2,.section-heading h2,.details h2,.closing h2{margin:.3rem 0 1.5rem;font-family:var(--font-display);font-size:calc(clamp(3rem,5vw,4.7rem) + var(--font-display-size-adjust));font-weight:600;letter-spacing:-.03em;line-height:.95}.practice-copy ul{display:grid;gap:.7rem;padding:0;list-style:none}.practice-copy li{display:flex;gap:.75rem;align-items:flex-start}.practice-copy li :global(svg){flex:none;margin-top:.25rem;color:var(--color-earth)}.practice-image{min-height:35rem;background:linear-gradient(rgb(40 37 20/.08),rgb(40 37 20/.08)),url('/images/content/ani-on-wall.jpg') center/cover no-repeat}
  .framework{background:#fbf8f1}.section-heading{max-width:55rem;margin:0 auto clamp(3rem,6vw,5rem);text-align:center}.section-heading .type-label,.details .type-label{color:var(--color-moss)}.framework-grid{display:grid;grid-template-columns:1.15fr 1fr;gap:clamp(2rem,5vw,5rem)}.framework-grid>article{padding-right:clamp(1rem,3vw,3rem);border-right:1px solid var(--color-line)}.framework-side{display:grid;gap:2.5rem}.framework-side article+article{padding-top:2.5rem;border-top:1px solid var(--color-line)}.framework-grid h3,.connection h3,.closing h3{margin:0 0 1rem;font-family:var(--font-display);font-size:calc(clamp(1.8rem,3vw,2.35rem) + var(--font-display-size-adjust));line-height:1.1}.framework-grid ul{padding-left:1.2rem}.framework-grid li{margin-bottom:.65rem}.theme-list{list-style:'✦  '}.theme-list li{padding-left:.4rem}
  .journey{background:#e8e6dc}.season-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem}.season-grid article{position:relative;padding:clamp(2rem,4vw,3rem);border-radius:var(--radius-card);background:var(--color-surface);box-shadow:var(--shadow-soft)}.season-icon{display:grid;width:3.5rem;aspect-ratio:1;margin-bottom:1.5rem;place-items:center;border-radius:50%;background:var(--color-moss);color:white}.season-grid article:nth-child(2) .season-icon{background:#557985}.season-grid article:nth-child(3) .season-icon{background:#b87842}.season-grid h3{margin:.2rem 0;font-family:var(--font-display);font-size:calc(2rem + var(--font-display-size-adjust));line-height:1}.season-grid .type-label{margin:0 0 20px;color:var(--color-moss)}.place{margin:.6rem 0 20px;color:var(--color-earth);font-weight:700}.connection{max-width:62rem;margin:2rem auto 0;padding:clamp(2rem,5vw,3.5rem);border-radius:var(--radius-card);background:#f1e7dc}.connection .type-label{color:var(--color-earth)}
  .details{background:#faf7ef}.details-layout{display:grid;grid-template-columns:.7fr 1.3fr;gap:clamp(3rem,7vw,7rem)}.details header{position:sticky;top:2rem;align-self:start}.details header p:last-child{font-size:1.1rem}
  .closing{background:linear-gradient(90deg,rgb(24 49 34/.96),rgb(24 49 34/.78)),url('/images/banners/earth-altar.jpg') center/cover;color:white}:global(.closing-grid){display:grid;grid-template-columns:1.5fr .65fr;gap:clamp(3rem,7vw,6rem);align-items:center}.closing h2{color:white;font-size:calc(clamp(3.8rem,7vw,6.3rem) + var(--font-display-size-adjust))}.closing .type-label,.closing aside :global(svg){color:#e3dda3}.closing p{max-width:48rem}.closing .actions :global(.button){border-color:white;background:white;color:var(--color-forest-dark)}.closing .actions :global(.secondary){background:transparent;color:white}.closing aside{padding-left:clamp(2rem,5vw,4rem);border-left:1px solid rgb(255 255 255/.45)}.closing aside a{color:white}
  @media(max-width:63.999rem){.pillar-grid{grid-template-columns:repeat(2,1fr);gap:2.5rem 0}.pillar-grid article:nth-child(2){border:0}.practices{grid-template-columns:1fr}.practice-image{min-height:32rem}.season-grid{grid-template-columns:1fr}.details-layout{grid-template-columns:1fr}.details header{position:static}}
  @media(max-width:47.999rem){.hero{min-height:44rem;background-position:64% center}.hero::after{background:rgb(24 35 24/.66)}.hero h1{font-size:calc(clamp(4.2rem,20vw,6rem) + var(--font-display-size-adjust) + var(--font-display-hero-size-adjust))}.hero .actions,.closing .actions{flex-direction:column}.hero .actions :global(.button),.closing .actions :global(.button){width:100%}.intro-columns{grid-template-columns:1fr}.pillar-grid{grid-template-columns:1fr}.pillar-grid article,.pillar-grid article:nth-child(2){padding-block:2rem;border-right:0;border-bottom:1px solid var(--color-line)}.framework-grid{grid-template-columns:1fr}.framework-grid article,.framework-grid article:nth-child(2),.framework-grid article:last-child{grid-column:auto;padding:0 0 2rem;border:0;border-bottom:1px solid var(--color-line)}:global(.closing-grid){grid-template-columns:1fr}.closing aside{padding:2rem 0 0;border-top:1px solid rgb(255 255 255/.45);border-left:0}}
.hero h1 span { font-size:calc(.72em + var(--font-hand-size-adjust) + 13px) !important; }
</style>
