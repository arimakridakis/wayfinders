---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Section from '../components/global/Section.astro';
import PersonCard from '../components/cards/PersonCard.astro';
const people = [
  ['Gwen Merkin','Co-Founder, Executive Director','https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/1632843226106-IQ5754HO4IDXYPKY7BUA/Gwen.jpg?format=1200w','/gwen'],
  ['Leah Gozhansky','Co-Founder, Program Director','https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/1632844439711-GT7TIUAFEL9FTT6QCMYV/leah.jpg?format=1200w','/leah'],
  ['Sayako Aizeki-Nevins','Mentor','https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/45b9265a-b0e2-4ba7-8fef-b0f8f93ca037/P1000301+%283%29.png?format=1200w','/sayako-aizeki-nevins'],
  ['Rebecca D’Elia','Mentor','https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/1654546283146-K7PJ57I5QCSLPDVRJ6UW/Rebecca+2.jpeg?format=1200w','/rebecca-dellia'],
  ['Bryte Gordon','Mentor','https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/3431ef0d-ebb5-4e75-94a5-e874e632a2ae/IMG_0100.jpg?format=1200w','/bryte-gordon'],
  ['Sonjaia McCrae','Mentor','https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/08e2b6db-a51b-4c00-bff1-452d87d46c68/IMG_1930.jpeg?format=1200w','/sonjaia-mccrae'],
  ['Stacie Bartolotta','Mentor','https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/a7534f4d-af41-4ce3-b138-5aa62e44f2e8/69573019-6189-4D41-B205-91021AB4F524.png?format=1200w','/stacie-bartolotta'],
  ['Hannah Van Dolsen','Mentor','https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/1660759281327-2B4283WJVP3ER6SID3SR/Hannah+Van+Dolsen.jpeg?format=1200w','/hannah-van-dolsen'],
  ['Emily Orr','Mentor','https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/7bb0ccf5-de71-4b46-bf32-3aefd1d56ba8/Emily+Orr_Photo.jpeg?format=1200w','/emily'],
  ['Miriam Rubin','Creative Ritual Director','https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/1632846478758-PL1V4NV2BVYJO77PKHQ5/Miriam.jpg?format=1200w','/miriam'],
  ['Jennie Brotman','Board Member','https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/981aa327-aae9-464c-b760-b4f2fc3fabc4/240411_Brotman00258retouch+VertCrop+copy.jpg?format=1200w','/jennie'],
  ['Jaime Schwarz','Board Member','https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/9fc3a2d2-ed1d-41c4-90bf-ef0a9a6c2d72/jaime+outside+headshot.jpg?format=1200w','/jaime-schwarz-1'],
  ['Aron Goldman','Board Member','https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/bd8cee37-159f-4a4e-a50e-53f6de5d19a1/Gwen%2C+Aron%2C+Leah.jpg?format=1200w','/aron-goldman'],
];
---
<BaseLayout title="The Team" description="Meet the mentors, leaders, and board members behind Wayfinders on the Hudson.">
  <PageHero eyebrow="People of Wayfinders" title="Meet the Team" intro="Nature connection specialists, counselors, mentors, and community leaders creating space to reconnect." image="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/bd8cee37-159f-4a4e-a50e-53f6de5d19a1/Gwen%2C+Aron%2C+Leah.jpg?format=1200w" alt="Wayfinders founders and board leadership together outdoors" />
  <Section width="wide"><div class="people">{people.map(([name,role,image,href]) => <PersonCard {name} {role} {image} href={`https://www.wayfindersonthehudson.com${href}`} />)}</div></Section>
  <Section tone="alternate"><div class="story"><p class="type-label">Our story</p><h2 class="type-section">A collaborative dynamic rooted in nature and care.</h2><p>Gwen, a nature connection specialist and trained eco-psychologist, and Leah, a school counselor and certified nature-informed therapist, have been in each other's lives for more than fifteen years and have worked together at Wayfinders for the last five.</p><p>Together, they bring nature connection, counseling, coaching, psychology, and mentoring to programs for all ages—from newborns through elders. Additional support comes from a team of seasoned nature-connection mentors and board members.</p></div></Section>
</BaseLayout>
<style>.people{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}.story{max-width:var(--width-prose)}.story h2{margin-top:.75rem}.story p:not(.type-label){color:var(--color-ink-muted);font-size:1.1rem}@media(max-width:63.999rem){.people{grid-template-columns:repeat(3,1fr)}}@media(max-width:47.999rem){.people{grid-template-columns:repeat(2,1fr)}}@media(max-width:35.999rem){.people{grid-template-columns:1fr}}</style>
