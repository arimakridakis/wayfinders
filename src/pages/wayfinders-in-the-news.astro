---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Section from '../components/global/Section.astro';
import CardGrid from '../components/sections/CardGrid.astro';
const stories = [
  { title: 'The Antidote to the Times: Re-Connecting with Nature, Together', summary: 'While screen time dominates lives, Wayfinders on the Hudson receives Rockefeller Brothers Fund grant to get people back together in nature.', publication: 'Press release', href: 'https://drive.google.com/file/d/1utoUakFiYmXjymqb5txiakQL806hIjpP/view?usp=sharing', image: 'https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/912b92dc-4cb3-4b98-9a98-603f5111f848/IMG_3961.jpg' },
  { title: 'Wayfinders pull and plant at Lenoir Preserve', publication: 'Rivertown Enterprise', href: 'https://www.rivertownsenterprise.net/hastings_on_hudson/wayfinders-pull-and-plant-at-lenoir-preserve/article_fdbc4a66-deef-11ec-8652-3347d3c178af.html', image: 'https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/1655913023702-AK5JN1NZC6CRPZJQ2XXH/Screen+Shot+2022-06-22+at+11.50.04+AM.png' },
  { title: 'So proud to be among these amazing sponsors and participants at the Hastings Spring Thing - Get Your Green On!', image: 'https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/1655911722745-RPZG9SL42Q08SMOHSXQ3/Screen%2BShot%2B2022-06-22%2Bat%2B11.27.21%2BAM.jpg' },
  { title: 'Eye-Opening Wayfinders Youth Volunteer Event Held At Lenoir Preserve', publication: 'Patch', href: 'https://patch.com/new-york/tarrytown/eye-opening-wayfinders-youth-volunteer-event-held-lenoir-preserve', image: 'https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/1655912857307-BP44TADGKZBC5TDUMAPA/Greg%2C+Bella%2C+Ani%2C+and+Mary+Garden.jpeg' },
  { title: '7 Guiding Principles for a JDEI Policy That Isn’t Just Hot Air. Plus, a Free Sample Policy!', publication: 'Blue Avocado', href: 'https://blueavocado.org/hr-and-employment-issues/7-guiding-principles-for-a-jdei-policy-that-isnt-just-hot-air-plus-a-free-sample-policy/', image: 'https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/1655913191447-UQ4XZBZWL4O0PEB3S2YF/Screen+Shot+2022-06-22+at+11.53.01+AM.png' },
];
---
<BaseLayout title="Wayfinders in the News" description="Press releases and coverage of Wayfinders on the Hudson.">
  <PageHero eyebrow="Media" title="Wayfinders in the News" intro="Extra, extra, read all about us!" />
  <Section width="wide"><CardGrid columns={2}>{stories.map((story) => <article><img src={story.image} alt="" width="800" height="520" loading="lazy" decoding="async" /><div><h2 class="type-card">{story.title}</h2>{story.summary && <p>{story.summary}</p>}{story.href && <a href={story.href}>Read {story.publication === 'Press release' ? 'the press release' : `in the ${story.publication}`}<span class="sr-only">: {story.title}</span></a>}</div></article>)}</CardGrid></Section>
</BaseLayout>
<style>article{overflow:hidden;border:1px solid var(--color-line);border-radius:var(--radius-card);background:var(--color-surface);box-shadow:var(--shadow-soft)}img{width:100%;height:18rem;object-fit:cover}article div{padding:var(--card-padding)}h2{margin-top:0}p{color:var(--color-ink-muted)}a{font-weight:750}@media(max-width:47.999rem){img{height:14rem}}</style>
