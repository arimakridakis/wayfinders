---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/sections/PageHero.astro'; import Section from '../components/global/Section.astro'; import Button from '../components/global/Button.astro';
const registrations=[['One session','https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-3c55bfbf268946c899fdeeabdaf32f9d9dc6b1403b2e4b8aac16a7b964b77078e52bf4e4d0814e59973e1de502d53f7d?locale=EN_US&cta=copylistmultilink'],['Wednesday series','https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-7361f670c7af406e9bf047032ea001d4a8bcd0f467654fa3aad10c33deac9afce02db39da70f4b2d8eefb0f27d8e3fb5?locale=EN_US&cta=saveandcopylink'],['Tuesday series','https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-b9af164453d14d02a5fe7611ac5f6321034730b8550e4d3c98390192b4d550ba56232c9c2db845e9a2103d1d618bbc9d?locale=EN_US&cta=saveandcopylink']];
---
<BaseLayout title="Wise Owls 55+" description="Mindful walking and talking for adults 55+ at Lenoir Preserve."><PageHero eyebrow="Adults 55+" title="Wise Owls" intro="Move your body, calm your mind, and enjoy nature through facilitated mindful walking and talking." image="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/b42dfdc0-57a0-4ca3-b55b-279ff3ab2e8c/IMG_4139.jpg?format=1200w" alt="Wise Owls walking together outdoors" />
<Section width="wide"><div class="facts"><article><p class="type-label">Tuesdays</p><h2 class="type-card">Women only</h2><p>September 22–November 24<br />1:15–2:30 pm</p></article><article><p class="type-label">Wednesdays</p><h2 class="type-card">Co-ed</h2><p>September 23–December 9<br />1:15–2:30 pm</p></article><article><p class="type-label">Lenoir Preserve</p><h2 class="type-card">Choose your pace</h2><p>Easy walking paths or hiking trails.<br />$350 for 10 sessions; $40 individually.</p></article></div><div class="actions">{registrations.map(([label,href],i)=><Button {href} variant={i===0?'secondary':'primary'}>{label}</Button>)}</div></Section>
<Section tone="alternate" width="wide"><div class="split"><div><p class="type-label">Walking alongside one another</p><h2 class="type-section">Cultivating wisdom and connection.</h2><p>Wise Owls provides a mindful experience for adults—men and women—ages 55+ to bring meaning to the present moment, feel gratitude, and connect with community.</p><ul><li>Cultivating wisdom</li><li>Deepening connection</li><li>Belonging in nature</li><li>Lifelong curiosity</li></ul><p>Facilitated by co-founders Gwen Merkin, certified in Nature Connection and Ecotherapy, and Leah Gozhansky, Certified Nature Informed Therapist.</p></div><img src="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/feeab10a-650d-441d-91cb-c86d9646d5a4/IMG_4143+%282%29.jpeg?format=1200w" alt="Wise Owls participants connecting in nature" width="1200" height="900" loading="lazy" /></div></Section>
<Section width="prose"><blockquote>Nature has guided us through every stage of life and developed us into wise owls. When we connect with ourselves, each other, and the earth, we inspire a collective commitment to sharing our wisdom with our own and future generations.</blockquote></Section></BaseLayout>
<style>.facts{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.facts article{padding:var(--card-padding);border:1px solid var(--color-line);border-radius:var(--radius-card);background:var(--color-surface)}.facts h2,.facts .type-label{margin:0}.facts p,.split p,.split li{color:var(--color-ink-muted)}.actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:2rem}.split{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:var(--column-gap)}.split img{width:100%;height:32rem;object-fit:cover;border-radius:var(--radius-card)}blockquote{margin:0;font-family:var(--font-display);font-size:clamp(1.5rem,3vw,2.35rem);line-height:1.35;color:var(--color-forest)}@media(max-width:47.999rem){.facts,.split{grid-template-columns:1fr}.split img{height:20rem}.actions :global(.button){width:100%}}</style>
