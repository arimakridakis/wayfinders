---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/sections/PageHero.astro'; import Section from '../components/global/Section.astro'; import Button from '../components/global/Button.astro'; import CardGrid from '../components/sections/CardGrid.astro'; import InfoCard from '../components/sections/InfoCard.astro'; import MediaSplit from '../components/sections/MediaSplit.astro';
const registrations=[['One session','https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-3c55bfbf268946c899fdeeabdaf32f9d9dc6b1403b2e4b8aac16a7b964b77078e52bf4e4d0814e59973e1de502d53f7d?locale=EN_US&cta=copylistmultilink'],['Wednesday series','https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-7361f670c7af406e9bf047032ea001d4a8bcd0f467654fa3aad10c33deac9afce02db39da70f4b2d8eefb0f27d8e3fb5?locale=EN_US&cta=saveandcopylink'],['Tuesday series','https://connect.intuit.com/pay/WayfindersOnTheHudson/scs-v1-b9af164453d14d02a5fe7611ac5f6321034730b8550e4d3c98390192b4d550ba56232c9c2db845e9a2103d1d618bbc9d?locale=EN_US&cta=saveandcopylink']];
---
<BaseLayout title="Wise Owls (65+)" description="Wise Owls provides a facilitated mindful walking and talking experience for adults (men & women) ages 55+."><PageHero eyebrow="Adults 55+" title="Wise Owls (55+)" intro="Move your body, calm your mind, and enjoy nature! Wise Owls provides a facilitated mindful walking and talking experience for adults (men & women) ages 55+ which allows you to bring meaning to the present moment, feel gratitude, and connect with community." image="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/b42dfdc0-57a0-4ca3-b55b-279ff3ab2e8c/IMG_4139.jpg?format=1200w" alt="Adults walking together outdoors" />
<Section width="wide"><CardGrid columns={3}><InfoCard label="Tuesdays or Wednesdays" heading="Tuesdays: WOMEN ONLY" headingLevel="h2"><p>9/22, 9/29, 10/6, 10/13, 10/20, 10/27, 11/3, 11/10, 11/17, 11/24</p></InfoCard><InfoCard label="Lenoir Preserve · 1:15-2:30 pm" heading="Wednesdays: CO-ED" headingLevel="h2"><p>9/23, 9/30, 10/7, 10/14, 10/21, 10/28, 11/4, (Skip 11/11), 11/18, (skip 11/25), 12/2, 12/9</p></InfoCard><InfoCard label="Lenoir Preserve" heading="Series (10 sessions) - $350" headingLevel="h2"><p>Individual Session - $40</p><p>*walking on easy walking paths or hiking on trails at Lenoir Preserve.</p></InfoCard></CardGrid><div class="actions">{registrations.map(([label,href],i)=><Button {href} variant={i===0?'secondary':'primary'}>{label === 'One session' ? 'Register for One Session' : `Register for ${label === 'Wednesday series' ? 'Wednesdays' : 'Tuesdays'} (10 weeks)`}</Button>)}</div></Section>
<Section tone="alternate" width="wide"><MediaSplit><div slot="copy"><p>Wise Owls have expressed that they find themselves:</p><ul><li>cultivating wisdom</li><li>deepening connection</li><li>belonging in nature</li><li>lifelong curiosity</li><li>walking alongside one another</li></ul><p>Facilitated by Co-Founders Gwen Merkin, Certified in Nature Connection & Ecotherapy & Leah Gozhansky, Certified Nature Informed Therapist.</p></div><img slot="media" src="https://images.squarespace-cdn.com/content/v1/61532ef9082b334755993cfd/feeab10a-650d-441d-91cb-c86d9646d5a4/IMG_4143+%282%29.jpeg?format=1200w" alt="Adults connecting outdoors" width="1200" height="900" loading="lazy" /></MediaSplit></Section>
<Section width="prose"><blockquote><p>Nature has guided us through every stage of life and developed us into wise owls.</p><p>When we connect with ourselves, each other, and the earth, we inspire a collective commitment to sharing our wisdom with our own and future generations.</p></blockquote></Section></BaseLayout>
<style>.actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:2rem}blockquote{margin:0;font-family:var(--font-display);font-size:clamp(1.5rem,3vw,2.35rem);line-height:1.35;color:var(--color-forest)}@media(max-width:47.999rem){.actions :global(.button){width:100%}}</style>
